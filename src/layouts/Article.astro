---
// Shared layout for long-form content (recipes + blog). Delegates directly to PostLayout
// to ensure a unified 3-column responsive layout, sticky table of contents, code snippet
// copy buttons, reading progress bar, related content sidebar, modern FAQ cards,
// and modern CTA styling. Emits TechArticle/BlogPosting + BreadcrumbList + FAQPage JSON-LD.
import PostLayout from './PostLayout.astro';

interface FAQItem { q: string; a: string }
interface Props {
  title: string;
  description: string;
  date: string;
  updated?: string;
  image?: string;
  readingTime: number;
  tags: string[];
  kind?: 'recipe' | 'blog';
  faqs?: FAQItem[];
}
const { title, description, date, updated, readingTime, tags, kind = 'recipe', faqs = [] } = Astro.props;

const slug = Astro.url.pathname.replace(/^\/(blog|recipes)\/?/, '').replace(/\/$/, '');
---

<PostLayout
  title={title}
  description={description}
  pubDate={date}
  updatedDate={updated}
  author="Amit Sharma"
  tags={tags}
  readingTime={readingTime}
  slug={slug}
  kind={kind}
  faqs={faqs}
>
  <slot />
</PostLayout>

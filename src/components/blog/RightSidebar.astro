---
const PRODUCT_LINKS = [
  { label: 'Web Scraping API', href: '/scrape/' },
  { label: 'AI Search Intelligence', href: '/aeo/' },
  { label: 'Browser Automation', href: '/browser/' },
  { label: 'Data Extraction', href: '/capabilities/' },
  { label: 'RAG Pipeline Tools', href: '/for-ai/' },
  { label: 'Citation Monitoring', href: '/aeo/' },
  { label: 'AEO Analytics', href: '/for-aeo-agencies/' },
];
---

<aside class="sidebar sidebar-right">
  <div class="sidebar-header-row">
    <span class="sidebar-badge">Infrastructure</span>
    <span class="sidebar-sub-label">API</span>
  </div>

  <ul class="sidebar-links product-list">
    {PRODUCT_LINKS.map((link) => (
      <li>
        <a href={link.href} class="product-link">
          <span class="product-dot" aria-hidden="true"></span>
          <span class="product-label">{link.label}</span>
          <span class="product-ext" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>

  <!-- Developer API CTA Card -->
  <div class="sidebar-dev-card">
    <div class="dev-card-header">
      <span class="dev-status-dot"></span>
      <span class="dev-status-text">147 Endpoints Live</span>
    </div>
    <div class="dev-card-body">
      <h4 class="dev-card-title">1,000 Free Credits</h4>
      <p class="dev-card-desc">Crawl, scrape, and extract the live web through one unified API key.</p>

      <a class="dev-card-cta" href="/contactus">
        Get API Key →
      </a>
      <div class="dev-card-sub">No credit card required · Instant setup</div>
    </div>
  </div>
</aside>

<style>
  .sidebar-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }
  .sidebar-header-row :global(.sidebar-badge) {
    margin-bottom: 0;
    line-height: 1.2;
  }
  .sidebar-sub-label {
    display: inline-flex;
    align-items: center;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid rgba(232, 68, 58, 0.2);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.2;
  }

  .product-list {
    margin: 0.4rem 0 1rem;
  }

  .product-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.45rem;
    border-radius: 6px;
    text-decoration: none;
    transition: all 140ms ease;
  }
  .product-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #cbd5e1;
    flex-shrink: 0;
    transition: background 140ms ease;
  }
  .product-link:hover .product-dot {
    background: var(--accent);
  }
  .product-label {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-weight: 500;
    flex: 1;
  }
  .product-link:hover .product-label {
    color: var(--accent);
  }
  .product-ext {
    font-size: 0.72rem;
    color: #cbd5e1;
    transition: transform 140ms ease, color 140ms ease;
  }
  .product-link:hover .product-ext {
    color: var(--accent);
    transform: translate(1px, -1px);
  }

  /* Dev CTA Card */
  .sidebar-dev-card {
    background: #0f172a;
    border-radius: 10px;
    padding: 1rem;
    color: #f8fafc;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    border: 1px solid #1e293b;
    position: relative;
    overflow: hidden;
  }

  .dev-card-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.5rem;
  }
  .dev-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
  }
  .dev-status-text {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #10b981;
  }

  .dev-card-title {
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    color: #ffffff;
    margin-bottom: 0.3rem;
  }
  .dev-card-desc {
    font-size: 0.75rem;
    color: #94a3b8;
    line-height: 1.4;
    margin-bottom: 0.85rem;
  }

  .dev-card-cta {
    display: block;
    width: 100%;
    text-align: center;
    padding: 0.5rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: #ffffff !important;
    background: var(--accent);
    border-radius: 6px;
    text-decoration: none;
    transition: background 150ms ease, transform 120ms ease;
  }
  .dev-card-cta:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .dev-card-sub {
    font-size: 0.65rem;
    color: #64748b;
    text-align: center;
    margin-top: 0.45rem;
  }
</style>

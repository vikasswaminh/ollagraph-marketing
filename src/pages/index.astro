---
import BaseLayout from '../layouts/BaseLayout.astro';
import bodyHtml from '../bodies/index.body.html?raw';
import { navHtml } from '../chrome';

import stats from '../data/api-stats.json';

const rendered = bodyHtml
  .replace('<div id="nav-root"></div>', navHtml(""))
  .split('%%ENDPOINT_COUNT%%').join(String(stats.endpointCount));

const softwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Ollagraph",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Web, Cloud",
  url: "https://ollagraph.com",
  description: "One API for AI agents to fetch, extract, audit, and reason about the live web — %%ENDPOINT_COUNT%% endpoints, one bearer token, one bill, one MCP server.",
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "USD",
    lowPrice: "5",
    highPrice: "59",
    offerCount: "4",
  },
};

const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How does Ollagraph compare to Firecrawl?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Firecrawl is an excellent markdown-first context API. Ollagraph covers the same scrape, crawl, and extract surface, then adds web search, domain intelligence, browser automation, and agent observability behind one key. On price it bills a flat 1 credit per call with no per-feature multipliers, offers true pay-as-you-go from $5, refunds automatically on failed calls, and gives 1,000 free credits.",
      },
    },
    {
      "@type": "Question",
      name: "Is there a free tier and pay-as-you-go pricing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. You get 1,000 credits completely free upon signup without entering a credit card. When you're ready to scale, you can pay as you go starting from just $5. There are no mandatory recurring monthly subscription commitments for standard developer usage.",
      },
    },
    {
      "@type": "Question",
      name: "How is Ollagraph priced and metered?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Every standard endpoint consumes exactly 1 credit per successful HTTP 200 call. We do not apply JS multipliers or complexity penalties. Orchestrated multi-step operations cost 3 credits. If any upstream fetch or extraction fails, the credit is refunded to your balance automatically.",
      },
    },
    {
      "@type": "Question",
      name: "Does Ollagraph provide an MCP server for AI agents?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, Ollagraph is completely MCP-native. You can run `pipx run ollagraph-mcp` to instantly expose all %%ENDPOINT_COUNT%% tools directly to Claude Desktop, Cursor, or your custom Model Context Protocol client with full schema typing.",
      },
    },
    {
      "@type": "Question",
      name: "Do you store the content Ollagraph scrapes?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. We enforce a zero content-retention posture. Data fetched from the web is passed directly back to your agent or stored temporarily only in volatile memory during chunking and extraction operations, after which it is immediately purged.",
      },
    },
    {
      "@type": "Question",
      name: "Is Ollagraph a good Firecrawl alternative?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ollagraph is widely considered the leading enterprise Firecrawl alternative for autonomous agents needing lower per-page costs, unified live web search, domain DNS intelligence, and full end-to-end execution observability in one place.",
      },
    },
  ],
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Ollagraph",
  url: "https://ollagraph.com",
  description: "The web data API for AI agents: scrape, crawl, search, and extract behind one key.",
  publisher: { "@type": "Organization", name: "Ollagraph" },
};

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Ollagraph",
  url: "https://ollagraph.com",
  logo: "https://ollagraph.com/og-image.png",
  description: "The consolidated web data API for AI agents — scrape, crawl, search, extract, and intelligence behind one key, with pay-as-you-go pricing and refund on failure.",
  sameAs: [
    "https://github.com/vikasswaminh/ollagraph-mcp",
    "https://pypi.org/project/ollagraph-mcp/",
  ],
};
---
<BaseLayout
  title="Ollagraph | Web scraping, crawling & search for AI agents"
  description="Scrape, crawl, search, and extract the live web for AI agents behind one API key. Flat 1 credit per call with refund on failure. Get 1,000 free credits."
  jsonLd={[softwareApp, faqPage, website, organization]}
>

  <Fragment slot="head">
    <link rel="stylesheet" href="/homepage-tailwind.css?v=22" />
    <style is:inline data-purpose="custom-typography">
      body {
        font-family: 'Geist', 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }
      .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }
      .cursor-blink {
        display: inline-block;
        width: 6px;
        height: 12px;
        vertical-align: middle;
        background-color: #E11D48;
        animation: blink 1s step-start infinite;
      }
      @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, ::before, ::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </Fragment>

  <Fragment set:html={rendered} />
</BaseLayout>

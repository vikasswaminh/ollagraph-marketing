---
import BaseLayout from '../layouts/BaseLayout.astro';
import bodyHtml from '../bodies/for-seo.body.html?raw';
import headExtras from '../bodies/for-seo.head.html?raw';
import { navHtml, footerHtml } from '../chrome';

const rendered = bodyHtml
  .replace('<div id="nav-root"></div>', navHtml(""))
  .replace('<div id="footer-root"></div>', footerHtml());
---
<BaseLayout title="Ollagraph for SEO &amp; AEO — Technical Audits as APIs" description="Run technical SEO, AEO and structured-data audits as API calls: meta, headings, schema, broken links, llms.txt readiness and AI-crawler checks. One key, PAYG.">
  <Fragment slot="head" set:html={headExtras} />
  <Fragment set:html={rendered} />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import bodyHtml from '../bodies/for-ai.body.html?raw';
import headExtras from '../bodies/for-ai.head.html?raw';
import { navHtml, footerHtml } from '../chrome';

const rendered = bodyHtml
  .replace('<div id="nav-root"></div>', navHtml(""))
  .replace('<div id="footer-root"></div>', footerHtml());
---
<BaseLayout title="Ollagraph for AI Agents — One Web API, MCP-Native" description="Stop wiring six vendors into your agent. Scrape, extract, search and audit the live web through one MCP-native API with a no-content-retention guarantee.">
  <Fragment slot="head" set:html={headExtras} />
  <Fragment set:html={rendered} />
</BaseLayout>

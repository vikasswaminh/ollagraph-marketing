---
import BaseLayout from '../layouts/BaseLayout.astro';
import bodyHtml from '../bodies/capabilities.body.html?raw';
import headExtras from '../bodies/capabilities.head.html?raw';
import { navHtml, footerHtml } from '../chrome';

const rendered = bodyHtml
  .replace('<div id="nav-root"></div>', navHtml("capabilities"))
  .replace('<div id="footer-root"></div>', footerHtml());
---
<BaseLayout title="Ollagraph Capabilities — 228 Web APIs for AI Agents" description="All 228 Ollagraph endpoints across 8 families: scrape, crawl, extract, convert, DNS, email, domain intelligence and agent tooling — behind one API key.">
  <Fragment slot="head" set:html={headExtras} />
  <Fragment set:html={rendered} />
</BaseLayout>

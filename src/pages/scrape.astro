---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navHtml, footerHtml } from '../chrome';
import stats from '../data/api-stats.json';

const curlExample = `curl -X POST https://api.ollagraph.com/v1/scrape \\
  -H "Authorization: Bearer $OLLAGRAPH_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "url": "https://example.com",
    "format": "markdown",
    "stealth": true,
    "actions": [
      {"type": "click", "selector": ".load-more"},
      {"type": "wait", "ms": 2000}
    ]
  }'`;

const smartExample = `# Auto-detect: static page = fast HTTP path; dynamic = full browser.
curl -X POST https://api.ollagraph.com/v1/scrape/smart \\
  -H "Authorization: Bearer $OLLAGRAPH_API_KEY" \\
  -d '{"url": "https://example.com"}'
# Response includes render_mode: "http_only" | "headless" | "headless_fallback"`;

const batchExample = `# Up to 100 URLs in parallel, one response.
curl -X POST https://api.ollagraph.com/v1/scrape/batch \\
  -H "Authorization: Bearer $OLLAGRAPH_API_KEY" \\
  -d '{
    "urls": ["https://a.com", "https://b.com", "https://c.com"],
    "concurrency": 10,
    "format": "markdown"
  }'`;

const pillars = [
  {
    title: "Five output formats",
    body: "Markdown for LLMs, HTML for fidelity, plain text for indexing, link arrays for crawling, original-source for diagnostics. Choose per request — no transcoding pipeline needed.",
    tag: "FORMATS",
    color: "sky"
  },
  {
    title: "Smart routing",
    body: "The smart-scrape endpoint detects whether a page needs JavaScript and routes accordingly. Static pages skip the browser and return in milliseconds; dynamic pages get the full stealth browser automatically.",
    tag: "ROUTING",
    color: "emerald"
  },
  {
    title: "Action macros",
    body: "Drive clicks, typing, waits, scrolls, and form submissions from a JSON array. No Puppeteer or Playwright code — the same description works for every site.",
    tag: "AUTOMATION",
    color: "purple"
  },
  {
    title: "Async with webhooks",
    body: "Fire large batches, walk away, get a clean POST to your endpoint when each job completes. Built for production pipelines that should not hold connections open.",
    tag: "PIPELINES",
    color: "rose"
  },
];

const faqs = [
  { q: "What formats does /v1/scrape return?", a: "Five: markdown for LLM-friendly text, html for raw page source, text for stripped plain text, links for the URL graph extracted from the page, and original for the raw response without transformation. Specify the format in the request body." },
  { q: "When should I use /v1/scrape vs /v1/scrape/smart?", a: "Use smart when you do not know whether the target page needs JavaScript — it is faster on static pages and falls back to the full browser when needed. Use scrape directly when you already know the page is dynamic, or when you need to pass a custom action macro." },
  { q: "How big can a batch be?", a: "Up to 100 URLs per synchronous batch call. For larger jobs use the async batch endpoint, which queues the work and posts to a webhook when each chunk completes — no upper bound beyond your monthly quota." },
  { q: "Does Ollagraph handle JavaScript-rendered single page apps?", a: "Yes. The default browser engine waits for network idle and DOM stability before extracting. You can also use action macros for click-and-wait patterns common to SPAs." },
  { q: "What about pages that require login?", a: "Use the action macro to drive the login form, then continue with subsequent steps in the same session. For pages that need a persistent authenticated session across many requests, our session endpoints keep state across calls. See the behind-a-login recipe." },
  { q: "How do I scrape paginated content?", a: "Two patterns. For numbered pagination, send the page-2, page-3, page-N URLs as a batch. For infinite-scroll pagination, use the action macro to scroll-and-wait until the load button stops appearing." },
  { q: "Is there a request timeout limit?", a: "Each request has a per-call timeout parameter. Failed calls are auto-refunded, so a timeout never costs you a credit." },
];

const url = "https://ollagraph.com/scrape/";
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", name: "Web scraping API — Ollagraph", url, description: "Send a URL, get clean structured data. Five output formats, smart routing, native action macros, async webhooks." },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Ollagraph", item: "https://ollagraph.com/" },
    { "@type": "ListItem", position: 2, name: "Web scraping API", item: url },
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---
<BaseLayout
  title="Web scraping API — five formats, smart routing, action macros — Ollagraph"
  description="Send a URL, get clean structured data. Markdown for LLMs, HTML for fidelity, plain text for indexing. Smart routing, native action macros, async webhooks."
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/homepage-tailwind.css?v=28" />
    <style>
      body {
        font-family: 'Geist', 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }
      .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }
      details summary::-webkit-details-marker,
      details summary::marker {
        display: none;
        content: "";
      }
    </style>
  </Fragment>

  <Fragment set:html={navHtml('scrape')} />

  <div class="relative overflow-hidden bg-white text-ink-950 font-sans">
    
    <!-- Hero Section -->
    <section class="relative pt-16 pb-16 sm:pt-24 sm:pb-20 border-b border-ink-200 overflow-hidden bg-white">
      <!-- Background Ambient Glow & Grid -->
      <div class="absolute inset-0 pointer-events-none -z-10 flex items-center justify-center">
        <div class="w-[700px] h-[400px] rounded-full bg-brand/5 blur-3xl opacity-60"></div>
      </div>
      <div class="absolute inset-0 bg-[radial-gradient(#e2e8f0_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none -z-10"></div>

      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <!-- Eyebrow Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-ink-200 bg-ink-50/80 text-xs font-mono mb-6 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-brand animate-pulse"></span>
          <span class="text-ink-900 font-semibold">SCRAPING</span>
          <span class="text-ink-300 select-none">•</span>
          <span class="text-ink-600 font-medium">Universal Web Extraction</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-[3.75rem] leading-[1.1] font-bold tracking-tight text-ink-950 mb-6 max-w-4xl mx-auto">
          Scrape any page. <span class="text-brand underline decoration-brand/30 decoration-4 underline-offset-4">Get clean data.</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg lg:text-xl text-ink-600 max-w-3xl mx-auto leading-relaxed mb-8 font-normal">
          Five output formats, smart routing, native action macros, and an async pattern that handles batches of any size. One endpoint family for everything from a single URL to a hundred million.
        </p>

        <!-- CTA Row -->
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a class="relative group overflow-hidden inline-flex items-center px-5 py-2.5 text-sm font-semibold rounded bg-brand text-white shadow-sm hover:shadow-lg hover:shadow-brand/25 hover:bg-brand-hover transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] focus:ring-2 focus:ring-brand/40" href="/contactus">
            <span class="relative z-10 flex items-center">Request access <span class="ml-1.5 transition-transform duration-200 group-hover:translate-x-1">→</span></span>
            <span class="absolute top-0 -left-full w-full h-full bg-white/20 transform -skew-x-12 group-hover:translate-x-[250%] transition-transform duration-700 ease-out"></span>
          </a>
          <a class="inline-flex items-center px-5 py-2.5 text-sm font-medium rounded border border-ink-300 bg-white text-ink-700 hover:bg-ink-50 hover:text-ink-900 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 shadow-xs hover:shadow" href="/docs">
            Read the docs <span class="ml-1 text-ink-400">→</span>
          </a>
        </div>

        <p class="text-xs sm:text-sm text-ink-500 mt-6 max-w-xl mx-auto">
          Part of the full <a href="/capabilities" class="text-brand hover:underline font-medium">{stats.endpointCount}-endpoint surface</a> — see the <a href="/bundles/scraping" class="text-brand hover:underline font-medium">scraping bundle</a> for the related endpoints.
        </p>
      </div>
    </section>

    <!-- Pillars Section -->
    <section class="py-16 sm:py-20 border-b border-ink-200 bg-[#FAFAFA]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <div class="text-xs font-mono text-brand font-semibold uppercase tracking-wider mb-2">
            CORE CAPABILITIES
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950">
            Five formats, smart routing, zero maintenance.
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {pillars.map((p, idx) => (
            <div class={`platform-card ${idx === 0 ? 'platform-card-sky' : idx === 1 ? 'platform-card-emerald' : idx === 2 ? 'platform-card-purple' : 'platform-card-rose'} p-6 sm:p-7 rounded-xl border border-ink-200/90 shadow-xs hover:shadow-lg hover:-translate-y-1 transition-all duration-300 bg-white group cursor-default flex flex-col justify-between relative overflow-hidden`}>
              <div>
                <div class="flex items-center gap-3 mb-4">
                  <div class={`platform-card-icon-wrap ${idx === 0 ? 'bg-sky-50 text-sky-600 border-sky-200/60' : idx === 1 ? 'bg-emerald-50 text-emerald-600 border-emerald-200/60' : idx === 2 ? 'bg-purple-50 text-purple-600 border-purple-200/60' : 'bg-rose-50 text-brand border-rose-200/60'} border`}>
                    {idx === 0 && (
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                    )}
                    {idx === 1 && (
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    )}
                    {idx === 2 && (
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" /></svg>
                    )}
                    {idx === 3 && (
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                    )}
                  </div>
                  <div>
                    <span class={`text-[10px] font-mono font-bold uppercase tracking-wider block ${idx === 0 ? 'text-sky-600' : idx === 1 ? 'text-emerald-600' : idx === 2 ? 'text-purple-600' : 'text-brand'}`}>
                      {p.tag}
                    </span>
                    <h3 class="text-lg font-semibold text-ink-900 group-hover:text-brand transition-colors duration-200">{p.title}</h3>
                  </div>
                </div>
                <p class="text-sm leading-relaxed text-ink-600">
                  {p.body}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Code Examples Section -->
    <section class="py-16 sm:py-20 border-b border-ink-200 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <div class="text-xs font-mono text-brand font-semibold uppercase tracking-wider mb-2">
            CODE EXAMPLES
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950 mb-3">
            Examples that work today.
          </h2>
          <p class="text-sm sm:text-base text-ink-600">
            Drop any of these into a terminal or notebook.
          </p>
        </div>

        <div class="space-y-6">
          <!-- Terminal 1: Scrape with actions -->
          <div class="rounded-xl border border-ink-800 bg-[#090D14] overflow-hidden shadow-xl font-mono text-xs text-ink-100">
            <div class="flex items-center justify-between border-b border-ink-800 px-4 py-2.5 bg-ink-950 select-none">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
                </div>
                <span class="ml-2 text-ink-200 text-xs font-semibold">Scrape with actions</span>
                <span class="text-ink-500 text-[11px] hidden sm:inline">• POST /v1/scrape</span>
              </div>
              <button type="button" class="quick-copy-btn text-ink-400 hover:text-white p-1 rounded hover:bg-ink-800 flex items-center gap-1 text-[11px] transition-colors" data-copy={curlExample}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-5 overflow-x-auto leading-relaxed">
              <pre class="m-0 text-ink-100 whitespace-pre"><code>{curlExample}</code></pre>
            </div>
          </div>

          <!-- Terminal 2: Smart routing -->
          <div class="rounded-xl border border-ink-800 bg-[#090D14] overflow-hidden shadow-xl font-mono text-xs text-ink-100">
            <div class="flex items-center justify-between border-b border-ink-800 px-4 py-2.5 bg-ink-950 select-none">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
                </div>
                <span class="ml-2 text-ink-200 text-xs font-semibold">Smart routing</span>
                <span class="text-ink-500 text-[11px] hidden sm:inline">• POST /v1/scrape/smart</span>
              </div>
              <button type="button" class="quick-copy-btn text-ink-400 hover:text-white p-1 rounded hover:bg-ink-800 flex items-center gap-1 text-[11px] transition-colors" data-copy={smartExample}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-5 overflow-x-auto leading-relaxed">
              <pre class="m-0 text-ink-100 whitespace-pre"><code>{smartExample}</code></pre>
            </div>
          </div>

          <!-- Terminal 3: Batch -->
          <div class="rounded-xl border border-ink-800 bg-[#090D14] overflow-hidden shadow-xl font-mono text-xs text-ink-100">
            <div class="flex items-center justify-between border-b border-ink-800 px-4 py-2.5 bg-ink-950 select-none">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
                </div>
                <span class="ml-2 text-ink-200 text-xs font-semibold">Batch</span>
                <span class="text-ink-500 text-[11px] hidden sm:inline">• POST /v1/scrape/batch</span>
              </div>
              <button type="button" class="quick-copy-btn text-ink-400 hover:text-white p-1 rounded hover:bg-ink-800 flex items-center gap-1 text-[11px] transition-colors" data-copy={batchExample}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-5 overflow-x-auto leading-relaxed">
              <pre class="m-0 text-ink-100 whitespace-pre"><code>{batchExample}</code></pre>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 sm:py-24 border-b border-ink-200 bg-[#FAFAFA]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <div class="text-xs font-mono text-brand font-semibold uppercase tracking-wider mb-2">
            FREQUENTLY ASKED QUESTIONS
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950">
            Scraping questions
          </h2>
        </div>

        <div class="space-y-4">
          {faqs.map((f, idx) => (
            <details class="group border border-ink-200 rounded-xl bg-white p-5 transition-all duration-200 open:shadow-sm">
              <summary class="flex items-center justify-between cursor-pointer list-none select-none">
                <div class="flex items-center gap-3">
                  <span class="w-6 h-6 rounded-full bg-ink-100 group-open:bg-rose-50 text-ink-600 group-open:text-brand font-mono text-xs font-semibold flex items-center justify-center transition-colors shrink-0">
                    {idx + 1}
                  </span>
                  <h3 class="font-semibold text-ink-900 group-hover:text-brand transition-colors text-base sm:text-lg">
                    {f.q}
                  </h3>
                </div>
                <div class="w-6 h-6 rounded-full flex items-center justify-center text-ink-400 group-hover:text-ink-600 transition-transform duration-200 group-open:rotate-180 shrink-0">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </div>
              </summary>
              <div class="text-ink-600 text-sm sm:text-base leading-relaxed mt-4 pl-9 pr-2">
                {f.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Bottom CTA Section -->
    <section class="py-20 sm:py-28 bg-white relative overflow-hidden" id="signup">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="bottom-cta-card relative rounded-2xl border border-ink-800 text-white p-8 sm:p-12 lg:p-14 shadow-2xl shadow-ink-950/30 overflow-hidden text-center">
          <!-- Ambient Glow Accents -->
          <div class="absolute -top-28 -right-28 w-80 h-80 rounded-full bg-brand/20 blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-28 -left-28 w-80 h-80 rounded-full bg-emerald-500/15 blur-3xl pointer-events-none"></div>

          <!-- Top Chip -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-ink-900/90 border border-ink-700 text-xs font-mono mb-6 shadow-sm relative z-10">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-white font-semibold">1,000 free credits</span>
            <span class="text-ink-500 select-none">•</span>
            <span class="text-ink-300 font-normal">No card required</span>
          </div>

          <!-- Title -->
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4 relative z-10">
            Start scraping in <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-brand to-rose-300">five minutes</span>.
          </h2>

          <!-- Subtitle -->
          <p class="text-sm sm:text-base text-ink-300 max-w-xl mx-auto leading-relaxed mb-8 relative z-10">
            1,000 free credits, one bearer token, failed calls auto-refund.
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-wrap items-center justify-center gap-3 relative z-10">
            <a class="relative group overflow-hidden inline-flex items-center px-6 py-3 text-sm font-semibold rounded-lg bg-brand text-white shadow-lg shadow-brand/25 hover:shadow-xl hover:shadow-brand/40 hover:bg-brand-hover transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] focus:ring-2 focus:ring-brand/40" href="/contactus">
              <span class="relative z-10 flex items-center">Request access <span class="ml-1.5 transition-transform duration-200 group-hover:translate-x-1">→</span></span>
              <span class="absolute top-0 -left-full w-full h-full bg-white/20 transform -skew-x-12 group-hover:translate-x-[250%] transition-transform duration-700 ease-out"></span>
            </a>
            <a class="inline-flex items-center px-6 py-3 text-sm font-medium rounded-lg border border-ink-700 bg-ink-900/80 text-ink-200 hover:bg-ink-800 hover:text-white transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 shadow-xs" href="/recipes">
              Browse recipes <span class="ml-1 text-ink-400">→</span>
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="mt-8 pt-6 border-t border-ink-800/80 flex flex-wrap items-center justify-center gap-6 text-[11px] font-mono text-ink-400 relative z-10">
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5l3.5 3.5 6.5-7"/></svg>
              No credit card required
            </span>
            <span class="text-ink-700 hidden sm:inline">•</span>
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5l3.5 3.5 6.5-7"/></svg>
              Auto-refund on failure
            </span>
            <span class="text-ink-700 hidden sm:inline">•</span>
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5l3.5 3.5 6.5-7"/></svg>
              {stats.endpointCount} endpoints live
            </span>
          </div>
        </div>
      </div>
    </section>
  </div>

  <Fragment set:html={footerHtml()} />

  <script is:inline>
    // Wire quick copy buttons
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.quick-copy-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var text = btn.getAttribute('data-copy');
          if (text) {
            navigator.clipboard.writeText(text).then(function() {
              var span = btn.querySelector('span');
              if (span) {
                var oldText = span.textContent;
                span.textContent = 'Copied!';
                setTimeout(function() { span.textContent = oldText; }, 1600);
              }
            });
          }
        });
      });
    });
  </script>
</BaseLayout>

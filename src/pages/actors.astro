---
import BaseLayout from '../layouts/BaseLayout.astro';
import bodyHtml from '../bodies/actors.body.html?raw';
import headExtras from '../bodies/actors.head.html?raw';
import { navHtml, footerHtml } from '../chrome';

const rendered = bodyHtml
  .replace('<div id="nav-root"></div>', navHtml("actors"))
  .replace('<div id="footer-root"></div>', footerHtml());
---
<BaseLayout title="Ollagraph Actors — Zillow, Google Maps &amp; LinkedIn Scrapers" description="Purpose-built structured scrapers for Zillow, Google Maps, LinkedIn, jobs and more — clean JSON from one URL, one API key, credit-metered with auto-refund.">
  <Fragment slot="head" set:html={headExtras} />
  <Fragment set:html={rendered} />
</BaseLayout>

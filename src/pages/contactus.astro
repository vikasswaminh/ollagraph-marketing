---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navHtml, footerHtml } from '../chrome';
---
<BaseLayout title="Contact — Ollagraph" description="Get in touch with the Ollagraph team — sales, support, and security. Email, phone, and our Bengaluru office.">
  <Fragment set:html={navHtml('')} />
  <div class="article">
    <h1 class="h-display h-1">Talk to us.</h1>
    <article class="prose">
      <p>
        Questions about the API, pricing, or a partnership — reach the team
        directly. We answer fast during business hours.
      </p>

      <h2>Email the right team</h2>
      <ul>
        <li>
          <strong>Sales &amp; partnerships</strong> — pricing, enterprise plans,
          custom volume. <a href="mailto:hello@ollagraph.com">hello@ollagraph.com</a>
        </li>
        <li>
          <strong>Technical support</strong> — integration help, API questions,
          incidents. <a href="mailto:hello@ollagraph.com">hello@ollagraph.com</a>
        </li>
        <li>
          <strong>Security</strong> — vulnerability reports and responsible
          disclosure. <a href="mailto:security@ollagraph.com">security@ollagraph.com</a>
        </li>
        <li>
          <strong>Legal</strong> — contracts, licensing, and policy questions.
          <a href="mailto:legal@ollagraph.com">legal@ollagraph.com</a>
        </li>
      </ul>

      <h2>Direct line</h2>
      <p>
        <strong>Phone:</strong> <a href="tel:+919611027980">+91 96110 27980</a><br />
        <strong>Hours:</strong> Monday – Saturday, 10:00 AM – 6:00 PM IST
      </p>

      <h2>Campus</h2>
      <p>
        L-149, Sector 6, HSR Layout<br />
        Bengaluru, Karnataka 560102<br />
        India
      </p>
      <p>
        <a
          href="https://www.google.com/maps/search/?api=1&query=L-149+Sector+6+HSR+Layout+Bengaluru+560102"
          target="_blank"
          rel="noopener"
        >Open in Maps →</a>
      </p>

      <h2>We're hiring in Bengaluru.</h2>
      <p>
        Sales, network support, and HR roles — full-time, on-campus at HSR
        Layout.
      </p>
      <p>
        <a class="btn btn-primary" href="/careers">View open roles</a>
      </p>
    </article>
  </div>
  <Fragment set:html={footerHtml()} />
</BaseLayout>

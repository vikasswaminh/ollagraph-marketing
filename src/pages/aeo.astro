---
import BaseLayout from '../layouts/BaseLayout.astro';
import bodyHtml from '../bodies/aeo.body.html?raw';
import headExtras from '../bodies/aeo.head.html?raw';
import { navHtml, footerHtml } from '../chrome';

const rendered = bodyHtml
  .replace('<div id="nav-root"></div>', navHtml("aeo"))
  .replace('<div id="footer-root"></div>', footerHtml());

const softwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Ollagraph AEO Toolkit",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Cloud API",
  url: "https://ollagraph.com/aeo/",
  description: "Audit how ChatGPT, Perplexity, Claude, Gemini, and Google AI Overviews see, cite, and rank your site. 10 AEO endpoints, one Bearer token.",
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "USD",
    lowPrice: "0",
    offerCount: "1",
  },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://ollagraph.com" },
    { "@type": "ListItem", position: 2, name: "AEO Toolkit", item: "https://ollagraph.com/aeo/" }
  ]
};
---
<BaseLayout
  title="AEO Toolkit — Answer-Engine Optimization APIs"
  description="Audit how ChatGPT, Perplexity, Claude, Gemini, and Google AI Overviews see, cite, and rank your site. 10 AEO endpoints, one Bearer token."
  jsonLd={[softwareApp, breadcrumbLd]}
>
  <Fragment slot="head" set:html={headExtras} />
  <Fragment set:html={rendered} />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.quick-copy-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var text = btn.getAttribute('data-copy');
          if (text) {
            navigator.clipboard.writeText(text).then(function() {
              var span = btn.querySelector('span');
              if (span) {
                span.textContent = 'Copied!';
                setTimeout(function() { span.textContent = 'Copy'; }, 1600);
              }
            });
          }
        });
      });
    });
  </script>
</BaseLayout>

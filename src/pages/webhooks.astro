---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navHtml, footerHtml } from '../chrome';
import stats from '../data/api-stats.json';

const queueExample = `# Queue an async batch and walk away. No held connection.
curl -X POST https://api.ollagraph.com/v1/scrape/batch/async \\
  -H "Authorization: Bearer $OLLAGRAPH_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "urls": ["https://a.example.com", "https://b.example.com"],
    "format": "markdown",
    "webhook_url": "https://yourapp.com/hooks/ollagraph"
  }'

# Response: { "status": "queued", "job_id": "..." }
# We POST the finished result to your webhook_url when the work completes.`;

const payloadExample = `// What lands on your endpoint when the job finishes.
// Method: POST   Content-Type: application/json
// Header:  X-Ollagraph-Signature: t=<unix_ts>,v1=<hex_hmac_sha256>

{
  "job_id": "job_3f9a...",
  "status": "completed",
  "result": {
    // The same block you would get from the sync endpoint:
    // markdown / html / text / links, plus per-URL status.
  }
}

// The result block mirrors the corresponding sync response, so your
// handler parses it exactly like a direct /v1/scrape/batch call.`;

const verifyNodeExample = `import crypto from 'crypto';
import express from 'express';

const app = express();
app.use(express.raw({ type: 'application/json' })); // raw bytes for HMAC

app.post('/hooks/ollagraph', (req, res) => {
  const header = req.headers['x-ollagraph-signature'] || '';
  // Header format: "t=<unix_ts>,v1=<hex_hmac_sha256>"
  const parts = Object.fromEntries(header.split(',').map(p => p.split('=')));
  const ts = parts.t, sig = parts.v1;

  // Reject anything older than five minutes (defeats replay).
  if (!ts || Math.abs(Date.now() / 1000 - Number(ts)) > 300) {
    return res.status(401).send('stale or missing timestamp');
  }

  // Signed body is: <ts>.<exact_json_bytes>
  const expected = crypto
    .createHmac('sha256', process.env.OLLAGRAPH_WEBHOOK_SECRET)
    .update(\`\${ts}.\`)
    .update(req.body) // raw bytes, not re-serialized JSON
    .digest('hex');

  if (!sig || !crypto.timingSafeEqual(Buffer.from(sig), Buffer.from(expected))) {
    return res.status(401).send('invalid signature');
  }

  // Acknowledge fast, then process out of band — see the idempotency note.
  const { job_id, result } = JSON.parse(req.body);
  res.sendStatus(200);
});`;

const verifyPythonExample = `import hmac, hashlib, os, time
from flask import Flask, request, abort

app = Flask(__name__)
SECRET = os.environ["OLLAGRAPH_WEBHOOK_SECRET"].encode()

@app.post("/hooks/ollagraph")
def callback():
    header = request.headers.get("x-ollagraph-signature", "")
    # Header format: "t=<unix_ts>,v1=<hex_hmac_sha256>"
    parts = dict(p.split("=", 1) for p in header.split(",") if "=" in p)
    ts, sig = parts.get("t"), parts.get("v1")
    if not ts or abs(time.time() - int(ts)) > 300:
        abort(401)
    body = request.get_data()  # raw bytes
    # Signed body is: <ts>.<exact_json_bytes>
    expected = hmac.new(SECRET, f"{ts}.".encode() + body, hashlib.sha256).hexdigest()
    if not sig or not hmac.compare_digest(sig, expected):
        abort(401)
    payload = request.get_json()
    # process payload["result"] ... then return fast
    return "", 200`;

const crawlExample = `# Crawl an entire site, get a single signed POST when the crawl finishes.
curl -X POST https://api.ollagraph.com/v1/crawl \\
  -H "Authorization: Bearer $OLLAGRAPH_API_KEY" \\
  -d '{
    "url": "https://docs.example.com",
    "max_pages": 500,
    "webhook_url": "https://yourapp.com/hooks/ollagraph"
  }'

# Prefer to poll instead? Omit webhook_url and read GET /v1/jobs/{job_id}.`;

const pillars = [
  {
    title: "Fire-and-forget at any size",
    body: "Queue a job of any size — a handful of URLs or a hundred thousand — and walk away. Your server gets a single clean POST when the work is done. No long-held connections, no polling loops, no retry plumbing on your side.",
    tag: "SCALE",
    color: "sky"
  },
  {
    title: "Every callback is signed",
    body: "We sign every delivery with an HMAC-SHA256 over the raw body, keyed by your account's webhook secret. Your endpoint verifies the signature before trusting the payload. Forgery becomes infeasible and replay attacks become detectable through the timestamp.",
    tag: "SECURITY",
    color: "emerald"
  },
  {
    title: "Idempotent payloads",
    body: "Each delivery carries the job_id. Treat it as an idempotency key: record it before processing and ignore a repeat. Because a retried delivery is byte-identical to the first, your handler can dedupe safely without losing data.",
    tag: "RELIABILITY",
    color: "purple"
  },
  {
    title: "Verify before you go live",
    body: "Send a single signed test payload to your endpoint with the test-webhook call. It uses the exact production signing scheme and retry policy, so you confirm your receiver works before any real job depends on it.",
    tag: "TOOLING",
    color: "rose"
  },
];

const faqs = [
  { q: "Which endpoints deliver results via webhook?", a: "Three async endpoints accept a webhook_url: /v1/scrape/async for a single page, /v1/scrape/batch/async for a list of URLs, and /v1/crawl for a full site. Each returns a job_id immediately and POSTs the finished result to your webhook_url when the work completes." },
  { q: "What does the callback payload look like?", a: "A POST with a JSON body containing the job_id and a result block. The result mirrors what you would get from the corresponding synchronous endpoint, so your handler parses the markdown, html, text, or links exactly as it would a direct call. The request also carries the signature header used for verification." },
  { q: "How are webhooks signed?", a: "Each request carries an X-Ollagraph-Signature header in the form t=<unix_ts>,v1=<hex>. The v1 value is an HMAC-SHA256 of the bytes <ts>.<raw_body> keyed by your account's webhook secret. The verification samples above show the full algorithm. Compare in constant time and reject timestamps older than five minutes to defeat replay attacks." },
  { q: "Where do I get my webhook secret?", a: "Call GET /v1/me with your API key and read the webhook_secret field. Rotate it at any time via POST /v1/me/webhook-secret/rotate. The previous secret stops working immediately, so drain in-flight jobs before rotating or their deliveries will fail verification." },
  { q: "How do I test my endpoint before going live?", a: "Call POST /v1/me/webhooks/test with your webhook_url. We send a single signed payload using the exact production signing scheme, retry behavior, and timeout, so the result reflects what a real delivery looks like. Use it to confirm your receiver verifies the signature correctly before you queue real jobs." },
  { q: "What is the retry policy, and how do I stay idempotent?", a: "If your endpoint returns a non-2xx response or the connection errors, we retry with backoff. Because a retried delivery is byte-identical to the original, the job_id is your idempotency key: record it on first receipt and skip duplicates. Acknowledge quickly with a 200 and do heavy processing out of band so a slow handler does not trigger an unnecessary retry." },
  { q: "Can I use webhooks without HTTPS?", a: "No. Webhook URLs must be HTTPS. Plain HTTP endpoints are rejected at job-creation time. This protects the payload and the signature in transit." },
  { q: "What if a webhook is impractical for my environment?", a: "Omit webhook_url and poll instead. Every async job is readable at GET /v1/jobs/{job_id}, which returns the current status and, once finished, the same result block a webhook would deliver. Webhooks are recommended for production because they remove the constant polling overhead, but polling is always available as a fallback." },
];

const url = "https://ollagraph.com/webhooks/";
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", name: "Async jobs and signed webhooks — Ollagraph", url, description: "Queue async scrape and crawl jobs, get a single signed POST when each finishes. HMAC-SHA256 verification, idempotent payloads, retries, and a polling fallback." },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Ollagraph", item: "https://ollagraph.com/" },
    { "@type": "ListItem", position: 2, name: "Webhooks", item: url },
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---
<BaseLayout
  title="Async jobs + signed webhooks — fire-and-forget result delivery — Ollagraph"
  description="Queue async scrape and crawl jobs and get a single signed POST when each finishes. HMAC-SHA256 verification, idempotent payloads, automatic retries, and a polling fallback."
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/homepage-tailwind.css?v=28" />
    <style>
      body {
        font-family: 'Geist', 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }
      .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }
      details summary::-webkit-details-marker,
      details summary::marker {
        display: none;
        content: "";
      }
    </style>
  </Fragment>

  <Fragment set:html={navHtml('webhooks')} />

  <div class="relative overflow-hidden bg-white text-ink-950 font-sans">
    
    <!-- Hero Section -->
    <section class="relative pt-16 pb-16 sm:pt-24 sm:pb-20 border-b border-ink-200 overflow-hidden bg-white">
      <!-- Background Ambient Glow & Grid -->
      <div class="absolute inset-0 pointer-events-none -z-10 flex items-center justify-center">
        <div class="w-[700px] h-[400px] rounded-full bg-brand/5 blur-3xl opacity-60"></div>
      </div>
      <div class="absolute inset-0 bg-[radial-gradient(#e2e8f0_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none -z-10"></div>

      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <!-- Eyebrow Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-ink-200 bg-ink-50/80 text-xs font-mono mb-6 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-brand animate-pulse"></span>
          <span class="text-ink-900 font-semibold">WEBHOOKS</span>
          <span class="text-ink-300 select-none">•</span>
          <span class="text-ink-600 font-medium">Async Callbacks</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-[3.75rem] leading-[1.1] font-bold tracking-tight text-ink-950 mb-6 max-w-4xl mx-auto">
          Fire jobs. <span class="text-brand underline decoration-brand/30 decoration-4 underline-offset-4">Get a clean callback.</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg lg:text-xl text-ink-600 max-w-3xl mx-auto leading-relaxed mb-8 font-normal">
          Queue a handful of URLs or a hundred thousand. Walk away. Your endpoint receives a single signed POST when the work completes — no polling, no held connections, no retry plumbing on your side.
        </p>

        <!-- CTA Row -->
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a class="relative group overflow-hidden inline-flex items-center px-5 py-2.5 text-sm font-semibold rounded bg-brand text-white shadow-sm hover:shadow-lg hover:shadow-brand/25 hover:bg-brand-hover transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] focus:ring-2 focus:ring-brand/40" href="/contactus">
            <span class="relative z-10 flex items-center">Request access <span class="ml-1.5 transition-transform duration-200 group-hover:translate-x-1">→</span></span>
            <span class="absolute top-0 -left-full w-full h-full bg-white/20 transform -skew-x-12 group-hover:translate-x-[250%] transition-transform duration-700 ease-out"></span>
          </a>
          <a class="inline-flex items-center px-5 py-2.5 text-sm font-medium rounded border border-ink-300 bg-white text-ink-700 hover:bg-ink-50 hover:text-ink-900 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 shadow-xs hover:shadow" href="/docs">
            Read the docs <span class="ml-1 text-ink-400">→</span>
          </a>
        </div>

                <p class="text-xs sm:text-sm text-ink-500 mt-6 max-w-xl mx-auto">
          Webhooks deliver the results of async jobs from <a href="/scrape" class="text-brand hover:underline font-medium">the scraping API</a> across the full <a href="/capabilities" class="text-brand hover:underline font-medium">{stats.endpointCount}-endpoint surface</a>. Full reference lives in <a href="/docs" class="text-brand hover:underline font-medium">the API docs</a>.
        </p>
      </div>
    </section>

    <!-- Pillars Section -->
    <section class="py-16 sm:py-20 border-b border-ink-200 bg-[#FAFAFA]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <div class="text-xs font-mono text-brand font-semibold uppercase tracking-wider mb-2">
            CORE CAPABILITIES
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950">
            Engineered for resilient background pipelines.
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {pillars.map((p, idx) => (
            <div class={`platform-card ${idx === 0 ? 'platform-card-sky' : idx === 1 ? 'platform-card-emerald' : idx === 2 ? 'platform-card-purple' : 'platform-card-rose'} p-6 sm:p-7 rounded-xl border border-ink-200/90 shadow-xs hover:shadow-lg hover:-translate-y-1 transition-all duration-300 bg-white group cursor-default flex flex-col justify-between relative overflow-hidden`}>
              <div>
                <div class="flex items-center gap-3 mb-4">
                  <div class={`platform-card-icon-wrap ${idx === 0 ? 'bg-sky-50 text-sky-600 border-sky-200/60' : idx === 1 ? 'bg-emerald-50 text-emerald-600 border-emerald-200/60' : idx === 2 ? 'bg-purple-50 text-purple-600 border-purple-200/60' : 'bg-rose-50 text-brand border-rose-200/60'} border`}>
                    {idx === 0 && (
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    )}
                    {idx === 1 && (
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                    )}
                    {idx === 2 && (
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                    )}
                    {idx === 3 && (
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
                    )}
                  </div>
                  <div>
                    <span class={`text-[10px] font-mono font-bold uppercase tracking-wider block ${idx === 0 ? 'text-sky-600' : idx === 1 ? 'text-emerald-600' : idx === 2 ? 'text-purple-600' : 'text-brand'}`}>
                      {idx === 0 ? 'SCALE' : idx === 1 ? 'SECURITY' : idx === 2 ? 'RELIABILITY' : 'TESTING'}
                    </span>
                    <h3 class="text-lg font-semibold text-ink-900 group-hover:text-brand transition-colors duration-200">{p.title}</h3>
                  </div>
                </div>
                <p class="text-sm leading-relaxed text-ink-600">
                  {p.body}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Code Section 1: Queue a job. Receive the result. -->
    <section class="py-16 sm:py-20 border-b border-ink-200 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <div class="text-xs font-mono text-brand font-semibold uppercase tracking-wider mb-2">
            DELIVERY FLOW
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950 mb-3">
            Queue a job. Receive the result.
          </h2>
          <p class="text-sm sm:text-base text-ink-600">
            Pass a webhook_url to any async endpoint and we POST the finished result back to you.
          </p>
        </div>

        <div class="space-y-6">
          <!-- Terminal 1: Queue -->
          <div class="rounded-xl border border-ink-800 bg-[#090D14] overflow-hidden shadow-xl font-mono text-xs text-ink-100">
            <div class="flex items-center justify-between border-b border-ink-800 px-4 py-2.5 bg-ink-950 select-none">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
                </div>
                <span class="ml-2 text-ink-200 text-xs font-semibold">Queue an async batch</span>
                <span class="text-ink-500 text-[11px] hidden sm:inline">• POST /v1/scrape/batch/async</span>
              </div>
              <button type="button" class="quick-copy-btn text-ink-400 hover:text-white p-1 rounded hover:bg-ink-800 flex items-center gap-1 text-[11px] transition-colors" data-copy={queueExample}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-5 overflow-x-auto leading-relaxed">
              <pre class="m-0 text-ink-100 whitespace-pre"><code>{queueExample}</code></pre>
            </div>
          </div>

          <!-- Terminal 2: Payload -->
          <div class="rounded-xl border border-ink-800 bg-[#090D14] overflow-hidden shadow-xl font-mono text-xs text-ink-100">
            <div class="flex items-center justify-between border-b border-ink-800 px-4 py-2.5 bg-ink-950 select-none">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
                </div>
                <span class="ml-2 text-ink-200 text-xs font-semibold">The callback payload</span>
                <span class="text-ink-500 text-[11px] hidden sm:inline">• POST to your webhook_url</span>
              </div>
              <button type="button" class="quick-copy-btn text-ink-400 hover:text-white p-1 rounded hover:bg-ink-800 flex items-center gap-1 text-[11px] transition-colors" data-copy={payloadExample}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-5 overflow-x-auto leading-relaxed">
              <pre class="m-0 text-ink-100 whitespace-pre"><code>{payloadExample}</code></pre>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Code Section 2: Verify signature -->
    <section class="py-16 sm:py-20 border-b border-ink-200 bg-[#FAFAFA]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <div class="text-xs font-mono text-brand font-semibold uppercase tracking-wider mb-2">
            HMAC-SHA256 SIGNATURE
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950 mb-3">
            Verify the signature.
          </h2>
          <p class="text-sm sm:text-base text-ink-600">
            Recompute the HMAC over the raw bytes and compare in constant time. Never trust an unverified body.
          </p>
        </div>

        <div class="space-y-6">
          <!-- Terminal 1: Node -->
          <div class="rounded-xl border border-ink-800 bg-[#090D14] overflow-hidden shadow-xl font-mono text-xs text-ink-100">
            <div class="flex items-center justify-between border-b border-ink-800 px-4 py-2.5 bg-ink-950 select-none">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
                </div>
                <span class="ml-2 text-ink-200 text-xs font-semibold">Verify (Node)</span>
                <span class="text-ink-500 text-[11px] hidden sm:inline">• crypto.createHmac</span>
              </div>
              <button type="button" class="quick-copy-btn text-ink-400 hover:text-white p-1 rounded hover:bg-ink-800 flex items-center gap-1 text-[11px] transition-colors" data-copy={verifyNodeExample}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-5 overflow-x-auto leading-relaxed">
              <pre class="m-0 text-ink-100 whitespace-pre"><code>{verifyNodeExample}</code></pre>
            </div>
          </div>

          <!-- Terminal 2: Python -->
          <div class="rounded-xl border border-ink-800 bg-[#090D14] overflow-hidden shadow-xl font-mono text-xs text-ink-100">
            <div class="flex items-center justify-between border-b border-ink-800 px-4 py-2.5 bg-ink-950 select-none">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
                </div>
                <span class="ml-2 text-ink-200 text-xs font-semibold">Verify (Python)</span>
                <span class="text-ink-500 text-[11px] hidden sm:inline">• hmac.compare_digest</span>
              </div>
              <button type="button" class="quick-copy-btn text-ink-400 hover:text-white p-1 rounded hover:bg-ink-800 flex items-center gap-1 text-[11px] transition-colors" data-copy={verifyPythonExample}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-5 overflow-x-auto leading-relaxed">

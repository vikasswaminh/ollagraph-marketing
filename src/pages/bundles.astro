    letter-spacing: 0.08em;
    color: #64748b;
    margin-bottom: 6px;
  }

  .preview-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .preview-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: #cbd5e1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ep-mini-method {
    font-size: 9px;
    font-weight: 700;
    padding: 1px 4px;
    border-radius: 3px;
    letter-spacing: 0.04em;
    font-family: var(--font-mono, monospace);
  }

  .ep-mini-post { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
  .ep-mini-get  { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
  .ep-mini-put  { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }

  .ep-mini-path {
    overflow: hidden;
    text-overflow: ellipsis;
    color: #94a3b8;
  }

  .ep-mini-more {
    font-size: 10.5px;
    color: #64748b;
    margin-top: 2px;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: auto;
    font-size: 12px;
  }

  .cost-band-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 600;
    color: #94a3b8;
  }

  .cost-band-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .card-actions-group {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .btn-card-inspect {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 28px;
    padding: 0 10px;
    background: #172033;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    color: #e2e8f0;
    font-size: 11.5px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .btn-card-inspect:hover {
    background: #1e293b;
    border-color: rgba(255, 255, 255, 0.25);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .btn-card-dive {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 28px;
    padding: 0 10px;
    background: rgba(225, 29, 72, 0.1);
    border: 1px solid rgba(225, 29, 72, 0.28);
    border-radius: 6px;
    font-size: 11.5px;
    font-weight: 600;
    color: #fda4af !important;
    text-decoration: none !important;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .btn-card-dive:hover {
    background: #e11d48;
    border-color: #e11d48;
    color: #ffffff !important;
    transform: translateY(-1px);
  }

  /* Empty State */
  .bundles-empty-state {
    text-align: center;
    padding: 56px 20px;
    background: #090e1a;
    border: 1px dashed rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    margin-top: 16px;
  }

  .empty-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #172033;
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px;
  }

  .empty-title {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 6px;
  }

  .empty-desc {
    font-size: 13.5px;
    color: #94a3b8;
    margin: 0 0 16px;
  }

  .empty-reset-btn {
    padding: 8px 18px;
    border-radius: 8px;
    background: #e11d48;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    border: none;
    cursor: pointer;
  }

  /* ==========================================================================
     INTERACTIVE WORKBENCH STUDIO STYLES
     ========================================================================== */

  .bundles-workbench-section {
    padding-top: 56px;
    padding-bottom: 56px;
    scroll-margin-top: 40px;
  }

  .workbench-header-block {
    max-width: 800px;
    margin: 0 auto 28px;
    text-align: center;
  }

  /* Selector Tab Bar — Snug, Balanced Pill Chips (No Awkward Empty Space) */
  .workbench-selector-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 10px;
    max-width: 960px;
    margin: 0 auto 24px;
  }

  .bundle-selector-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 9999px;
    background: #090e1a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #94a3b8;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    width: auto;
  }

  .tab-label-group {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .tab-name {
    white-space: nowrap;
  }

  .bundle-selector-tab:hover {
    background: #141c2e;
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.22);
    transform: translateY(-1px);
  }

  .bundle-selector-tab.active {
    background: #172033;
    border-color: var(--tab-accent, #e11d48);
    color: #ffffff;
    box-shadow: 0 4px 18px var(--tab-glow, rgba(225, 29, 72, 0.28)), 0 0 0 1px var(--tab-accent, #e11d48);
  }

  .tab-color-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .bundle-selector-tab.active .tab-color-dot {
    box-shadow: 0 0 8px currentColor;
  }

  .tab-count {
    font-size: 11px;
    color: #64748b;
    background: rgba(255, 255, 255, 0.06);
    padding: 1px 6px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .bundle-selector-tab.active .tab-count {
    color: #ffffff;
    background: var(--tab-accent, #e11d48);
    border: 1px solid var(--tab-accent, #e11d48);
  }

  /* The Console Container */
  .workbench-console {
    background: #060911;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 24px 60px -15px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.03);
  }

  /* Window Top Bar */
  .console-window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    background: #090e1a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .window-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .window-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-red { background: #ef4444; }
  .dot-yellow { background: #f59e0b; }
  .dot-green { background: #10b981; }

  .console-title {
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: #94a3b8;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .title-prefix {
    color: #64748b;
  }

  .title-sep {
    color: #334155;
  }

  .active-bundle-label {
    color: #f1f5f9;
  }

  .console-action-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 600;
    color: #e11d48;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .console-action-link:hover {
    color: #fb7185;
  }

  /* Studio Panels */
  .studio-bundle-panel {
    display: none;
    padding: 24px 24px 20px;
  }

  .studio-bundle-panel.is-active {
    display: block;
    animation: fadeIn 0.2s ease-in-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Summary Card inside Console */
  .studio-summary-card {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding: 20px 22px;
    background: #090e1a;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    margin-bottom: 22px;
  }

  @media (max-width: 860px) {
    .studio-summary-card {
      flex-direction: column;
    }
  }

  .studio-summary-left {
    flex: 1;
  }

  .studio-badge-cluster {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 12px;
  }

  .studio-monogram {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 800;
    font-family: var(--font-mono, monospace);
    flex-shrink: 0;
  }

  .studio-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 4px;
  }

  .studio-h3 {
    font-family: var(--font-display, 'Geist', 'Inter', sans-serif);
    font-size: 22px;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .studio-category-pill {
    font-size: 11px;
    font-weight: 600;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 2px 8px;
    border-radius: 5px;
  }

  .studio-tagline {
    font-size: 14px;
    line-height: 1.5;
    color: #94a3b8;
    margin: 0;
  }

  .studio-persona-quote {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: #cbd5e1;
    background: rgba(15, 23, 42, 0.6);
    border-left: 2px solid #e11d48;
    padding: 8px 12px;
    border-radius: 0 6px 6px 0;
  }

  .studio-summary-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .studio-metric-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    background: #0d1322;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    min-width: 100px;
  }

  .metric-val {
    font-size: 17px;
    font-weight: 750;
    color: #ffffff;
  }

  .metric-lbl {
    font-size: 10.5px;
    color: #64748b;
    margin-top: 2px;
  }

  /* Studio Sub-Tabs */
  .studio-subtabs {
    display: flex;
    align-items: center;
    gap: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 18px;
    overflow-x: auto;
  }

  .studio-subtab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 16px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: #94a3b8;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .studio-subtab:hover {
    color: #ffffff;
  }

  .studio-subtab.active {
    color: #e11d48;
    border-bottom-color: #e11d48;
  }

  /* Studio Panel Content */
  .studio-panel-content {
    display: none;
  }

  .studio-panel-content.active {
    display: block;
  }

  /* Table Tab */
  .endpoints-control-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .endpoints-search-wrap {
    position: relative;
    width: 280px;
  }

  .endpoints-search-wrap svg {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #64748b;
  }

  .local-ep-search {
    width: 100%;
    height: 36px;
    background: #090e1a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 0 12px 0 34px;
    font-size: 12.5px;
    color: #ffffff;
    outline: none;
  }

  .local-ep-search:focus {
    border-color: #e11d48;
  }

  .endpoints-meta {
    font-size: 11.5px;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .studio-table-wrap {
    background: #090e1a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow-x: auto;
  }

  .studio-endpoint-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .studio-endpoint-table thead th {
    background: #0d1322;
    text-align: left;
    padding: 12px 16px;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    white-space: nowrap;
  }

  .studio-endpoint-table tbody td {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    vertical-align: middle;
    color: #cbd5e1;
  }

  .studio-endpoint-table tbody tr:last-child td {
    border-bottom: none;
  }

  .studio-endpoint-table tbody tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  .method-badge {
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    font-weight: 750;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.04em;
    display: inline-block;
  }

  .method-post { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
  .method-get  { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
  .method-delete { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
  .method-put  { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }

  .ep-path-cell {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #f1f5f9;
  }

  .ep-path-text {
    word-break: break-all;
  }

  .btn-copy-path {
    background: none;
    border: none;
    color: #64748b;
    cursor: pointer;
    padding: 2px 4px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
    opacity: 0.6;
  }

  .studio-endpoint-table tr:hover .btn-copy-path {
    opacity: 1;
  }

  .btn-copy-path:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }

  .ep-summary-cell {
    color: #94a3b8;
    line-height: 1.45;
  }

  .credit-pill {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 700;
    color: #ffffff;
    background: #172033;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 2px 7px;
    border-radius: 5px;
    white-space: nowrap;
  }

  /* Recipe Workflow */
  .recipe-banner {
    padding: 16px 20px;
    background: #090e1a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    margin-bottom: 20px;
  }

  .recipe-badge {
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    font-weight: 700;
    color: #e11d48;
    letter-spacing: 0.1em;
    margin-bottom: 6px;
  }

  .recipe-title {
    font-size: 17px;
    font-weight: 750;
    color: #ffffff;
    margin: 0 0 6px;
  }

  .recipe-desc {
    font-size: 13.5px;
    color: #94a3b8;
    margin: 0;
  }

  .recipe-flow-pipeline {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 860px;
  }

  .recipe-step-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 16px 20px;
    background: #090e1a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
  }

  .step-num-badge {
    padding: 4px 10px;
    background: rgba(225, 29, 72, 0.15);
    border: 1px solid rgba(225, 29, 72, 0.3);
    border-radius: 6px;
    color: #fb7185;
    font-size: 11px;
    font-weight: 750;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .step-content {
    flex: 1;
  }

  .step-text {
    font-size: 14px;
    line-height: 1.55;
    color: #e2e8f0;
    margin: 0;
  }

  .step-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: absolute;
    bottom: -14px;
    left: 42px;
    z-index: 2;
    color: #e11d48;
    font-size: 12px;
  }

  /* Code Console */
  .code-console-wrapper {
    background: #090e1a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
  }

  .code-lang-selector {
    display: flex;
    align-items: center;
    background: #0d1322;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0 12px;
  }

  .lang-tab {
    padding: 10px 16px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: #94a3b8;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .lang-tab:hover {
    color: #ffffff;
  }

  .lang-tab.active {
    color: #ffffff;
    border-bottom-color: #e11d48;
  }

  .btn-copy-code {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #172033;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-copy-code:hover {
    background: #1e293b;
    color: #ffffff;
  }

  .code-blocks-container {
    padding: 16px 20px;
  }

  .code-lang-panel {
    display: none;
  }

  .code-lang-panel.active {
    display: block;
  }

  .code-pre {
    margin: 0;
    padding: 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: #38bdf8;
    white-space: pre-wrap;
    word-break: break-all;
    overflow-x: auto;
  }

  /* FAQs */
  .studio-faq-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .studio-faq-item {
    background: #090e1a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    overflow: hidden;
  }

  .faq-summary {
    padding: 14px 18px;
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .faq-chevron {
    color: #64748b;
    transition: transform 0.2s ease;
  }

  .studio-faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: #e11d48;
  }

  .faq-answer {
    padding: 0 18px 14px;
    font-size: 13.5px;
    line-height: 1.6;
    color: #94a3b8;
  }

  .faq-answer p {
    margin: 0;
  }

  /* Console Footer Bar */
  .studio-console-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    background: #090e1a;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 24px;
    border-radius: 12px;
    flex-wrap: wrap;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dot-online {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.8);
  }

  .footer-text {
    font-size: 12px;
    color: #94a3b8;
  }

  .footer-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .btn-studio-deepdive {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #e11d48;
    color: #ffffff !important;
    font-size: 13px;
    font-weight: 700;

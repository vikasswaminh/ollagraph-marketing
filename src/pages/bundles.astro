                      </td>
                      <td class="col-count">
                        <span class="count-badge font-mono">{b.endpoints.length}</span>
                      </td>
                      <td class="col-cost">
                        <span class="cost-mono-tag font-mono">~{costBand} credits</span>
                      </td>
                      <td class="col-persona">
                        <span class="persona-cell-text">{b.persona}</span>
                      </td>
                      <td class="col-action" style="text-align: right;">
                        <div class="matrix-btn-group">
                          <button
                            type="button"
                            class="matrix-inspect-btn"
                            data-target-bundle={b.slug}

                            <span>Inspect</span>
                            <span class="btn-arrow" aria-hidden="true">&darr;</span>
                          </button>
                          <a
                            href={`/bundles/${b.slug}/`}
                            class="matrix-action-link"
                            title={`Open full ${b.name} deep-dive page`}
                          >
                            <span>Deep Dive</span>
                            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
                          </a>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Compact Obsidian Dark CTA -->
    <section class="bundles-compact-cta" aria-label="Access Ollagraph API">

<script is:inline>
  function initBundlesExplorer() {
    var searchInput = document.getElementById('bundles-search-input');
    var searchClear = document.getElementById('bundles-search-clear');
    var statusBar = document.getElementById('bundles-status-bar');
    var statusText = document.getElementById('bundles-status-text');
    var resetBtn = document.getElementById('bundles-reset-btn');
    var emptyState = document.getElementById('bundles-empty-state');
    var emptyReset = document.getElementById('bundles-empty-reset');
    var cards = document.querySelectorAll('.bundle-hub-card');
    var filterPills = document.querySelectorAll('.filter-pill');

    var currentCategory = 'all';
    var searchQuery = '';

    function updateGrid() {
      var query = searchQuery.trim().toLowerCase();
      var visibleCount = 0;

      for (var i = 0; i < cards.length; i++) {
        var card = cards[i];
        var name = card.getAttribute('data-name') || '';
        var tagline = card.getAttribute('data-tagline') || '';
        var persona = card.getAttribute('data-persona') || '';
        var endpoints = card.getAttribute('data-endpoints') || '';
        var category = card.getAttribute('data-category') || '';

        var matchesCategory = (currentCategory === 'all') || (category === currentCategory);
        var matchesQuery = !query ||
          (name.indexOf(query) !== -1) ||
          (tagline.indexOf(query) !== -1) ||
          (persona.indexOf(query) !== -1) ||
          (endpoints.indexOf(query) !== -1);

        if (matchesCategory && matchesQuery) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      }

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.removeAttribute('hidden');
          emptyState.style.display = 'block';
        } else {
          emptyState.setAttribute('hidden', '');
          emptyState.style.display = 'none';
        }
      }

      if (searchClear) {
        if (query.length > 0) {
          searchClear.removeAttribute('hidden');
        } else {
          searchClear.setAttribute('hidden', '');
        }
      }

      if (statusBar && statusText) {
        if (query.length > 0 || currentCategory !== 'all') {
          statusBar.removeAttribute('hidden');
          statusBar.style.display = 'flex';
          var text = 'Showing <strong>' + visibleCount + '</strong> of ' + cards.length + ' bundles';
          if (query.length > 0) text += ' matching "<strong>' + query + '</strong>"';
          statusText.innerHTML = text;
        } else {
          statusBar.setAttribute('hidden', '');
          statusBar.style.display = 'none';
        }
      }
    }

    // Category filter pills
    for (var p = 0; p < filterPills.length; p++) {
      filterPills[p].addEventListener('click', function() {
        for (var k = 0; k < filterPills.length; k++) {
          filterPills[k].classList.remove('active');
          filterPills[k].setAttribute('aria-selected', 'false');
        }
        this.classList.add('active');
        this.setAttribute('aria-selected', 'true');
        currentCategory = this.getAttribute('data-category') || 'all';
        updateGrid();
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        searchQuery = e.target.value;
        updateGrid();
      });
    }

    if (searchClear) {
      searchClear.addEventListener('click', function() {
        if (searchInput) {
          searchInput.value = '';
          searchQuery = '';
          searchInput.focus();
          updateGrid();
        }
      });
    }

    function resetAllFilters() {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      currentCategory = 'all';
      for (var k = 0; k < filterPills.length; k++) {
        if (filterPills[k].getAttribute('data-category') === 'all') {
          filterPills[k].classList.add('active');
        } else {
          filterPills[k].classList.remove('active');
        }
      }
      updateGrid();
    }

    if (resetBtn) resetBtn.addEventListener('click', resetAllFilters);
    if (emptyReset) emptyReset.addEventListener('click', resetAllFilters);

    // ==========================================
    // STUDIO WORKBENCH SWITCHER
    // ==========================================
    var selectorTabs = document.querySelectorAll('.bundle-selector-tab');
    var studioPanels = document.querySelectorAll('.studio-bundle-panel');
    var activeLabel = document.getElementById('console-active-label');
    var deepdiveLink = document.getElementById('console-deepdive-link');

    function setActiveBundle(slug, shouldScroll) {
      if (!slug) return;

      // Update selector tabs
      for (var t = 0; t < selectorTabs.length; t++) {
        var tab = selectorTabs[t];
        if (tab.getAttribute('data-slug') === slug) {
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
        } else {
          tab.classList.remove('active');
          tab.setAttribute('aria-selected', 'false');
        }
      }

      // Update cards is-active ring
      for (var c = 0; c < cards.length; c++) {
        if (cards[c].getAttribute('data-slug') === slug) {
          cards[c].classList.add('is-active');
        } else {
          cards[c].classList.remove('is-active');
        }
      }

      // Update panels
      for (var p = 0; p < studioPanels.length; p++) {
        var panel = studioPanels[p];
        if (panel.getAttribute('data-bundle-slug') === slug) {
          panel.classList.add('is-active');
        } else {
          panel.classList.remove('is-active');
        }
      }

      // Update topbar title & link
      if (activeLabel) {
        activeLabel.textContent = slug.toUpperCase() + ' BUNDLE';
      }
      if (deepdiveLink) {
        deepdiveLink.setAttribute('href', '/bundles/' + slug + '/');
      }

      if (shouldScroll) {
        var workbenchEl = document.getElementById('bundles-workbench');
        if (workbenchEl) {
          workbenchEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      // Update hash without jumping
      try {
        if (history.replaceState) {
          history.replaceState(null, '', '#b-' + slug);
        }
      } catch (err) {}
    }

    // Selector tab click
    for (var st = 0; st < selectorTabs.length; st++) {
      selectorTabs[st].addEventListener('click', function() {
        var slug = this.getAttribute('data-slug');
        setActiveBundle(slug, false);
      });
    }

    // Cards "Inspect" click & card body click
    var inspectBtns = document.querySelectorAll('[data-target-bundle]');
    for (var ib = 0; ib < inspectBtns.length; ib++) {
      inspectBtns[ib].addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var targetSlug = this.getAttribute('data-target-bundle');
        setActiveBundle(targetSlug, true);
      });
    }

    for (var c = 0; c < cards.length; c++) {
      cards[c].addEventListener('click', function(e) {
        if (e.target.closest('.btn-card-dive') || e.target.closest('.btn-card-inspect')) return;
        var slug = this.getAttribute('data-slug');
        setActiveBundle(slug, true);
      });
    }

    // Initialize from URL hash if present
    if (window.location.hash) {
      var hashSlug = window.location.hash.replace(/^#b-/, '').replace(/^#/, '');
      if (hashSlug) {
        setActiveBundle(hashSlug, false);
      }
    }

    // ==========================================
    // STUDIO SUB-TABS (Endpoints, Recipe, Samples, FAQ)
    // ==========================================
    for (var sp = 0; sp < studioPanels.length; sp++) {
      (function(panel) {
        var subtabs = panel.querySelectorAll('.studio-subtab');
        var panelContents = {
          endpoints: panel.querySelector('.tab-panel-endpoints'),
          recipe: panel.querySelector('.tab-panel-recipe'),
          samples: panel.querySelector('.tab-panel-samples'),
          faq: panel.querySelector('.tab-panel-faq'),
        };

        for (var st = 0; st < subtabs.length; st++) {
          subtabs[st].addEventListener('click', function() {
            var tabName = this.getAttribute('data-tab');
            for (var k = 0; k < subtabs.length; k++) subtabs[k].classList.remove('active');
            this.classList.add('active');

            for (var key in panelContents) {
              if (panelContents[key]) {
                if (key === tabName) {
                  panelContents[key].classList.add('active');
                } else {
                  panelContents[key].classList.remove('active');
                }
              }
            }
          });
        }

        // Local endpoint search inside this bundle
        var epSearch = panel.querySelector('.local-ep-search');
        if (epSearch) {
          epSearch.addEventListener('input', function(e) {
            var epQuery = e.target.value.toLowerCase().trim();
            var rows = panel.querySelectorAll('.ep-row');
            for (var r = 0; r < rows.length; r++) {
              var searchData = rows[r].getAttribute('data-ep-search') || '';
              if (!epQuery || searchData.indexOf(epQuery) !== -1) {
                rows[r].style.display = '';
              } else {
                rows[r].style.display = 'none';
              }
            }
          });
        }

        // Code sample language tabs
        var langTabs = panel.querySelectorAll('.lang-tab');
        var langPanels = {
          curl: panel.querySelector('.lang-curl'),
          python: panel.querySelector('.lang-python'),
          node: panel.querySelector('.lang-node'),
        };

        for (var lt = 0; lt < langTabs.length; lt++) {
          langTabs[lt].addEventListener('click', function() {
            var lang = this.getAttribute('data-lang');
            for (var j = 0; j < langTabs.length; j++) langTabs[j].classList.remove('active');
            this.classList.add('active');

            for (var lk in langPanels) {
              if (langPanels[lk]) {
                if (lk === lang) {
                  langPanels[lk].classList.add('active');
                } else {
                  langPanels[lk].classList.remove('active');
                }
              }
            }
          });
        }

        // Copy Code button
        var copyCodeBtn = panel.querySelector('.btn-copy-code');
        if (copyCodeBtn) {
          copyCodeBtn.addEventListener('click', function() {
            var activeCodePre = panel.querySelector('.code-lang-panel.active code');
            if (activeCodePre) {
              var text = activeCodePre.textContent || '';
              navigator.clipboard.writeText(text).then(function() {
                var originalHtml = copyCodeBtn.innerHTML;
                copyCodeBtn.innerHTML = '<span>Copied! &#10003;</span>';
                copyCodeBtn.style.color = '#34d399';
                setTimeout(function() {
                  copyCodeBtn.innerHTML = originalHtml;
                  copyCodeBtn.style.color = '';
                }, 2000);
              });
            }
          });
        }
      })(studioPanels[sp]);
    }

    // Copy endpoint path buttons
    var copyPathBtns = document.querySelectorAll('.btn-copy-path');
    for (var cp = 0; cp < copyPathBtns.length; cp++) {
      copyPathBtns[cp].addEventListener('click', function(e) {
        e.stopPropagation();
        var pathText = this.getAttribute('data-copy-text');
        var btn = this;
        if (pathText) {
          navigator.clipboard.writeText(pathText).then(function() {
            btn.style.color = '#34d399';
            setTimeout(function() {
              btn.style.color = '';
            }, 1500);
          });
        }
      });
    }

    // Keyboard shortcut /
    document.addEventListener('keydown', function(e) {
      var activeEl = document.activeElement;
      var isInput = activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA');

      if (e.key === '/' && !isInput) {
        e.preventDefault();
        if (searchInput) searchInput.focus();
      } else if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (searchInput) searchInput.focus();
      } else if (e.key === 'Escape' && document.activeElement === searchInput) {
        if (searchInput) searchInput.blur();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBundlesExplorer);
  } else {
    initBundlesExplorer();
  }
  document.addEventListener('astro:page-load', initBundlesExplorer);
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navHtml, footerHtml } from '../chrome';
import bundles from '../data/bundles.json';

interface Endpoint {
  method: string;
  path: string;
  credits: number;
  summary: string;
}

interface Bundle {
  slug: string;
  name: string;
  tagline: string;
  persona: string;
  color: string;
  endpoints: Endpoint[];
  recipe: { title: string; steps: string[] };
  samples: { curl: string; python: string; node: string };
  faq: { q: string; a: string }[];
}

const allBundles = bundles as Bundle[];
const totalEndpoints = allBundles.reduce((acc, b) => acc + b.endpoints.length, 0);

interface ThemeDef {
  accent: string;
  bgSoft: string;
  borderSoft: string;
  badgeBg: string;
  badgeColor: string;
  glow: string;
}

const BUNDLE_THEMES: Record<string, ThemeDef> = {
  lime: {
    accent: '#10b981',
    bgSoft: 'rgba(16, 185, 129, 0.1)',
    borderSoft: 'rgba(16, 185, 129, 0.25)',
    badgeBg: '#ecfdf5',
    badgeColor: '#059669',
    glow: 'rgba(16, 185, 129, 0.2)',
  },
  teal: {
    accent: '#0d9488',
    bgSoft: 'rgba(13, 148, 136, 0.1)',
    borderSoft: 'rgba(13, 148, 136, 0.25)',
    badgeBg: '#f0fdfa',
    badgeColor: '#0f766e',
    glow: 'rgba(13, 148, 136, 0.2)',
  },
  blue: {
    accent: '#2563eb',
    bgSoft: 'rgba(37, 99, 235, 0.1)',
    borderSoft: 'rgba(37, 99, 235, 0.25)',
    badgeBg: '#eff6ff',
    badgeColor: '#1d4ed8',
    glow: 'rgba(37, 99, 235, 0.2)',
  },
  amber: {
    accent: '#f59e0b',
    bgSoft: 'rgba(245, 158, 11, 0.1)',
    borderSoft: 'rgba(245, 158, 11, 0.25)',
    badgeBg: '#fffbeb',
    badgeColor: '#b45309',
    glow: 'rgba(245, 158, 11, 0.2)',
  },
  violet: {
    accent: '#8b5cf6',
    bgSoft: 'rgba(139, 92, 246, 0.1)',
    borderSoft: 'rgba(139, 92, 246, 0.25)',
    badgeBg: '#f5f3ff',
    badgeColor: '#6d28d9',
    glow: 'rgba(139, 92, 246, 0.2)',
  },
  rose: {
    accent: '#e11d48',
    bgSoft: 'rgba(225, 29, 72, 0.1)',
    borderSoft: 'rgba(225, 29, 72, 0.25)',
    badgeBg: '#fff1f2',
    badgeColor: '#be123c',
    glow: 'rgba(225, 29, 72, 0.2)',
  },
  slate: {
    accent: '#64748b',
    bgSoft: 'rgba(100, 116, 139, 0.1)',
    borderSoft: 'rgba(100, 116, 139, 0.25)',
    badgeBg: '#f1f5f9',
    badgeColor: '#334155',
    glow: 'rgba(100, 116, 139, 0.2)',
  },
  emerald: {
    accent: '#059669',
    bgSoft: 'rgba(5, 150, 105, 0.1)',
    borderSoft: 'rgba(5, 150, 105, 0.25)',
    badgeBg: '#ecfdf5',
    badgeColor: '#047857',
    glow: 'rgba(5, 150, 105, 0.2)',
  },
  red: {
    accent: '#ef4444',
    bgSoft: 'rgba(239, 68, 68, 0.1)',
    borderSoft: 'rgba(239, 68, 68, 0.25)',
    badgeBg: '#fef2f2',
    badgeColor: '#b91c1c',
    glow: 'rgba(239, 68, 68, 0.2)',
  },
  cyan: {
    accent: '#06b6d4',
    bgSoft: 'rgba(6, 182, 212, 0.1)',
    borderSoft: 'rgba(6, 182, 212, 0.25)',
    badgeBg: '#f0f9ff',
    badgeColor: '#0369a1',
    glow: 'rgba(6, 182, 212, 0.2)',
  },
};

const CATEGORIES = [
  { id: 'all', label: 'All Bundles', slugs: allBundles.map(b => b.slug) },
  { id: 'ai', label: 'AI & Search', slugs: ['aeo', 'seo', 'agent-tools'] },
  { id: 'data', label: 'Data & Scraping', slugs: ['scraping', 'conversion'] },
  { id: 'infra', label: 'Domains & Infra', slugs: ['dns', 'email', 'domain-intelligence'] },
  { id: 'security', label: 'Security & Audits', slugs: ['site-audit', 'security'] },
];

function getCategoryForSlug(slug: string): string {
  if (['aeo', 'seo', 'agent-tools'].includes(slug)) return 'ai';
  if (['scraping', 'conversion'].includes(slug)) return 'data';
  if (['dns', 'email', 'domain-intelligence'].includes(slug)) return 'infra';
  return 'security';
}

function getCategoryLabel(slug: string): string {
  if (['aeo', 'seo', 'agent-tools'].includes(slug)) return 'AI & Search';
  if (['scraping', 'conversion'].includes(slug)) return 'Data & Scraping';
  if (['dns', 'email', 'domain-intelligence'].includes(slug)) return 'Domains & Infra';
  return 'Security & Audits';
}

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "API Bundles & Workflows — Ollagraph",
  description: `Ten curated bundles compose Ollagraph’s ${totalEndpoints} API operations into workflows: AEO, SEO, DNS, Email, Domain Intelligence, Scraping, Conversion, Site Audit, Security, and Agent Tools.`,
  url: "https://ollagraph.com/bundles/",
};

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: allBundles.map((b, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `https://ollagraph.com/bundles/${b.slug}/`,
    name: `${b.name} Bundle`,
    description: b.tagline,
  })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Ollagraph", item: "https://ollagraph.com/" },
    { "@type": "ListItem", position: 2, name: "Bundles", item: "https://ollagraph.com/bundles/" },
  ],
};

const nav = navHtml('bundles');
const footer = footerHtml();
---

<BaseLayout
  title={`API Bundles — 10 Use-Case Toolkits for AI Agents — Ollagraph`}
  description={`Ten curated bundles group Ollagraph’s ${totalEndpoints} API operations into production workflows: AEO, SEO, DNS, email, scraping, conversion, security and agent tools. One bearer token.`}
  canonical="https://ollagraph.com/bundles/"
  jsonLd={[collectionLd, itemListLd, breadcrumbLd]}
>
  <Fragment set:html={nav} />

  <main class="bundles-page">
    <!-- Top Ambient Glow -->
    <div class="bundles-hero-glow" aria-hidden="true"></div>

    <!-- Hero Header -->
    <header class="bundles-hero">
      <div class="bundles-hero-inner">
        <div class="bundles-pill">
          <span class="bundles-pulse-dot" aria-hidden="true"></span>
          <span>10 WORKFLOW BUNDLES · ONE BEARER TOKEN · {totalEndpoints} ENDPOINTS · MCP READY</span>
        </div>

        <h1 class="bundles-title">
          Workflows, not endpoints.<br />
          Pick a bundle. <span class="bundles-title-accent">Ship.</span>
        </h1>

        <p class="bundles-subtitle">
          Ten curated bundles compose Ollagraph's API into the workflows autonomous AI agents and engineers actually run. Same token. Flat 1 credit base. One MCP server.
        </p>

        <div class="bundles-hero-cta">
          <a class="btn-bundles-primary" href="/contactus">
            <span>Request access</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn-bundles-secondary" href="#bundles-workbench">
            <span>Open Interactive Studio</span>
            <span class="btn-arrow" aria-hidden="true">&darr;</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Toolbar: Search & Category Filter Pills -->
    <section class="bundles-toolbar-section">
      <div class="bundles-container">
        <div class="bundles-toolbar">
          <div class="bundles-search-wrap">
            <svg class="search-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              id="bundles-search-input"
              class="bundles-search-input"
              placeholder="Search bundles by name, keyword, or endpoint (e.g. AEO, DNS, WHOIS, PDF, scrape, robots)..."
              autocomplete="off"
              spellcheck="false"
              aria-label="Search API bundles"
            />
            <button type="button" id="bundles-search-clear" class="search-clear-btn" aria-label="Clear search" hidden>
              &#10005;
            </button>
            <kbd class="search-kbd" title="Press / to search">/</kbd>
          </div>

          <!-- Category Filter Pills -->
          <div class="bundles-filter-pills" role="tablist" aria-label="Filter bundles by category">
            {CATEGORIES.map((cat, idx) => (
              <button
                class={`filter-pill ${idx === 0 ? 'active' : ''}`}
                data-category={cat.id}
                type="button"
                role="tab"
                aria-selected={idx === 0 ? "true" : "false"}
              >
                {cat.id === 'all' && <span class="filter-dot"></span>}
                <span>{cat.label}</span>
                <span class="filter-badge">
                  {cat.id === 'all' ? allBundles.length : cat.slugs.length}
                </span>
              </button>
            ))}
          </div>

          <div class="bundles-status-bar" id="bundles-status-bar" hidden>
            <span id="bundles-status-text"></span>
            <button id="bundles-reset-btn" class="bundles-reset-btn" type="button">Reset search</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Curated Bundles Grid (10 Cards) -->
    <section class="bundles-section bundles-grid-section">
      <div class="bundles-container">
        <div class="section-heading-wrap">
          <div class="h-eyebrow">CURATED TOOLKITS</div>
          <h2 class="section-h2">10 Purpose-Built API Workflows</h2>
          <p class="section-sub">
            Click any bundle to inspect its full endpoint signature, autonomous agent recipe, and code samples in the Studio below.
          </p>
        </div>

        <div class="bundles-grid" id="bundles-grid">
          {allBundles.map((b, idx) => {
            const theme = BUNDLE_THEMES[b.color] || BUNDLE_THEMES.rose;
            const totalCredits = b.endpoints.reduce((acc, ep) => acc + (ep.credits ?? 0), 0);
            const costBand = Math.round(totalCredits / 4);
            const previewEndpoints = b.endpoints.slice(0, 3);
            const categoryId = getCategoryForSlug(b.slug);
            const categoryLabel = getCategoryLabel(b.slug);

            return (
              <div
                class={`bundle-hub-card bundle-color-${b.color} ${idx === 0 ? 'is-active' : ''}`}
                id={`card-${b.slug}`}
                data-slug={b.slug}
                data-category={categoryId}
                data-name={b.name.toLowerCase()}
                data-tagline={b.tagline.toLowerCase()}
                data-persona={b.persona.toLowerCase()}
                data-endpoints={b.endpoints.map(e => `${e.method} ${e.path} ${e.summary}`).join(' ').toLowerCase()}
                style={`--bundle-accent: ${theme.accent}; --bundle-glow: ${theme.glow}; --bundle-border: ${theme.borderSoft};`}
              >
                <!-- Top Accent Line -->
                <div class="card-accent-bar" style={`background-color: ${theme.accent};`}></div>

                <div class="card-top-header">
                  <div class="card-icon-wrap" style={`background-color: ${theme.bgSoft}; color: ${theme.accent}; border-color: ${theme.borderSoft};`}>
                    <span class="card-monogram font-mono">{b.name.slice(0, 2).toUpperCase()}</span>
                  </div>
                  <div class="card-title-group">
                    <div class="card-title-row">
                      <h3 class="card-bundle-name">{b.name}</h3>
                      <span class="card-category-tag">{categoryLabel}</span>
                    </div>
                    <span class="card-endpoints-badge">{b.endpoints.length} endpoints</span>
                  </div>
                </div>

                <p class="card-tagline">{b.tagline}</p>

                <!-- Persona snippet -->
                <div class="card-persona-wrap">
                  <span class="persona-label">Built for:</span>
                  <span class="persona-text">{b.persona}</span>
                </div>

                <!-- Preview sample endpoints -->
                <div class="card-endpoints-preview">
                  <span class="preview-header">Sample endpoints</span>
                  <div class="preview-list">
                    {previewEndpoints.map(ep => (
                      <div class="preview-item">
                        <span class={`ep-mini-method ep-mini-${ep.method.toLowerCase()}`}>{ep.method}</span>
                        <span class="ep-mini-path font-mono">{ep.path}</span>
                      </div>
                    ))}
                    {b.endpoints.length > 3 && (
                      <span class="ep-mini-more font-mono">+{b.endpoints.length - 3} more</span>
                    )}
                  </div>
                </div>

                <div class="card-footer">
                  <span class="cost-band-pill">
                    <span class="cost-band-dot" style={`background-color: ${theme.accent};`}></span>
                    ~{costBand} credits / run
                  </span>

                  <div class="card-actions-group">
                    <button
                      type="button"
                      class="btn-card-inspect"
                      data-target-bundle={b.slug}
                      title="Inspect this bundle in the Studio workbench"
                    >
                      <span>Inspect</span>
                      <span class="inspect-arrow">&darr;</span>
                    </button>
                    <a
                      href={`/bundles/${b.slug}/`}
                      class="btn-card-dive"
                      title={`Open full ${b.name} deep-dive page`}
                    >
                      <span>Deep Dive</span>
                      <span class="action-arrow">&rarr;</span>
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <!-- Empty search results state -->
        <div class="bundles-empty-state" id="bundles-empty-state" hidden>
          <div class="empty-icon-wrap">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <h3 class="empty-title">No matching bundles found</h3>
          <p class="empty-desc">We couldn't find any bundle matching your query. Try searching for AEO, DNS, Scrape, or Python.</p>
          <button class="empty-reset-btn" id="bundles-empty-reset" type="button">View all bundles</button>
        </div>
      </div>
    </section>

    <!-- INTERACTIVE WORKBENCH STUDIO (Solves the 10-table stacking problem) -->
    <section class="bundles-section bundles-workbench-section" id="bundles-workbench">
      <div class="bundles-container">
        <div class="workbench-header-block">
          <div class="h-eyebrow">INTERACTIVE WORKFLOW STUDIO</div>
          <h2 class="section-h2">Inspect Active Bundle &amp; Endpoints</h2>
          <p class="section-sub">
            Live operations, execution recipe chains, and plug-and-play code snippets for autonomous agents. Select any bundle to switch context immediately.
          </p>
        </div>

        <!-- Bundle Quick Selector Tabs (2-Row Clean Grid) -->
        <div class="workbench-selector-bar" role="tablist" aria-label="Select active bundle for studio">
          {allBundles.map((b, idx) => {
            const theme = BUNDLE_THEMES[b.color] || BUNDLE_THEMES.rose;
            return (
              <button
                class={`bundle-selector-tab ${idx === 0 ? 'active' : ''}`}
                data-slug={b.slug}
                type="button"
                role="tab"
                aria-selected={idx === 0 ? "true" : "false"}
                style={`--tab-accent: ${theme.accent}; --tab-glow: ${theme.glow};`}
              >
                <div class="tab-label-group">
                  <span class="tab-color-dot" style={`background-color: ${theme.accent};`}></span>
                  <span class="tab-name">{b.name}</span>
                </div>
                <span class="tab-count font-mono">{b.endpoints.length}</span>
              </button>
            );
          })}
        </div>

        <!-- The Studio Console Container -->
        <div class="workbench-console">
          <!-- Top Window Bar -->
          <div class="console-window-bar">
            <div class="window-controls">
              <span class="window-dot dot-red"></span>
              <span class="window-dot dot-yellow"></span>
              <span class="window-dot dot-green"></span>
            </div>
            <div class="console-title font-mono">
              <span class="title-prefix">OLLAGRAPH STUDIO</span>
              <span class="title-sep">//</span>
              <span class="active-bundle-label font-bold" id="console-active-label">AEO BUNDLE</span>
            </div>
            <div class="console-window-actions">
              <a href="/bundles/aeo/" id="console-deepdive-link" class="console-action-link">
                <span>Open full deep dive</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>

          <!-- Studio Panels (one per bundle, toggled by JS) -->
          {allBundles.map((b, bIdx) => {
            const theme = BUNDLE_THEMES[b.color] || BUNDLE_THEMES.rose;
            const totalCredits = b.endpoints.reduce((acc, ep) => acc + (ep.credits ?? 0), 0);
            const costBand = Math.round(totalCredits / 4);

            return (
              <div
                class={`studio-bundle-panel ${bIdx === 0 ? 'is-active' : ''}`}
                id={`panel-${b.slug}`}
                data-bundle-slug={b.slug}
              >
                <!-- Bundle Summary Header inside Console -->
                <div class="studio-summary-card">
                  <div class="studio-summary-left">
                    <div class="studio-badge-cluster">
                      <div class="studio-monogram" style={`background-color: ${theme.bgSoft}; color: ${theme.accent}; border: 1px solid ${theme.borderSoft};`}>
                        {b.name.slice(0, 2).toUpperCase()}
                      </div>
                      <div>
                        <div class="studio-title-row">
                          <h3 class="studio-h3">{b.name} Bundle</h3>
                          <span class="studio-category-pill">{getCategoryLabel(b.slug)}</span>
                        </div>
                        <p class="studio-tagline">{b.tagline}</p>
                      </div>
                    </div>

                    <div class="studio-persona-quote">
                      <span class="persona-icon">&#128100;</span>
                      <span>{b.persona}</span>
                    </div>
                  </div>

                  <div class="studio-summary-right">
                    <div class="studio-metric-box">
                      <span class="metric-val font-mono">{b.endpoints.length}</span>
                      <span class="metric-lbl">Operations</span>
                    </div>
                    <div class="studio-metric-box">
                      <span class="metric-val font-mono">~{costBand} cr</span>
                      <span class="metric-lbl">Est. Run Band</span>
                    </div>
                    <div class="studio-metric-box">
                      <span class="metric-val font-mono">1 Token</span>
                      <span class="metric-lbl">All Endpoints</span>
                    </div>
                  </div>
                </div>

                <!-- Studio Navigation Sub-Tabs -->
                <div class="studio-subtabs" role="tablist">
                  <button class="studio-subtab active" data-tab="endpoints" type="button">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    <span>Endpoints ({b.endpoints.length})</span>
                  </button>
                  <button class="studio-subtab" data-tab="recipe" type="button">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                    <span>Agent Recipe Workflow</span>
                  </button>
                  <button class="studio-subtab" data-tab="samples" type="button">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                    <span>Live Code Samples</span>
                  </button>
                  <button class="studio-subtab" data-tab="faq" type="button">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    <span>FAQs ({b.faq.length})</span>
                  </button>
                </div>

                <!-- Tab Panel 1: Endpoints -->
                <div class="studio-panel-content tab-panel-endpoints active">
                  <div class="endpoints-control-bar">
                    <div class="endpoints-search-wrap">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                      <input
                        type="text"
                        class="local-ep-search"
                        placeholder={`Filter ${b.name} endpoints...`}
                        aria-label={`Filter ${b.name} endpoints`}
                      />
                    </div>
                    <div class="endpoints-meta font-mono">
                      <span>Showing {b.endpoints.length} operations</span>
                      <span>·</span>
                      <span>Flat 1-3 cr / call</span>
                    </div>
                  </div>

                  <div class="studio-table-wrap">
                    <table class="studio-endpoint-table">
                      <thead>
                        <tr>
                          <th style="width: 80px;">Method</th>
                          <th style="width: 320px;">Endpoint Path</th>
                          <th>Summary</th>
                          <th style="width: 80px; text-align: right;">Credits</th>
                        </tr>
                      </thead>
                      <tbody>
                        {b.endpoints.map((ep) => (
                          <tr class="ep-row" data-ep-search={`${ep.method} ${ep.path} ${ep.summary}`.toLowerCase()}>
                            <td>
                              <span class={`method-badge method-${ep.method.toLowerCase()}`}>{ep.method}</span>
                            </td>
                            <td class="font-mono ep-path-cell">
                              <span class="ep-path-text">{ep.path}</span>
                              <button
                                type="button"
                                class="btn-copy-path"
                                data-copy-text={ep.path}
                                title="Copy endpoint path"
                                aria-label="Copy endpoint path"
                              >
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                              </button>
                            </td>
                            <td class="ep-summary-cell">{ep.summary}</td>
                            <td style="text-align: right;">
                              <span class="credit-pill">{ep.credits} cr</span>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>

                <!-- Tab Panel 2: Agent Recipe Workflow -->
                <div class="studio-panel-content tab-panel-recipe">
                  <div class="recipe-banner">
                    <div class="recipe-badge">AGENT WORKFLOW RECIPE</div>

    </section>

    <!-- Section: White-Label -->
    <section class="py-16 sm:py-24 border-b border-ink-200 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-ink-200 bg-ink-50 text-xs font-mono font-semibold text-ink-600 mb-4">
          WHITE-LABEL
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950 mb-4">
          Your agency's report. Powered by our API.
        </h2>
        <p class="text-sm sm:text-base text-ink-600 leading-relaxed mb-8">
          Call the audit endpoints from your reporting pipeline and render the results with your branding. The client sees your report &mdash; clean JSON in, your-brand deliverable out. Run one workspace per client for isolated billing and rate limits, schedule the re-audit, and report the trend instead of a one-off snapshot.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a class="inline-flex items-center px-6 py-2.5 text-sm font-medium rounded-lg border border-ink-300 bg-white text-ink-700 hover:bg-ink-50 hover:text-ink-900 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 shadow-sm hover:shadow" href="/observability">
            See per-URL observability
          </a>
          <a class="inline-flex items-center px-6 py-2.5 text-sm font-medium rounded-lg border border-ink-300 bg-white text-ink-700 hover:bg-ink-50 hover:text-ink-900 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 shadow-sm hover:shadow" href="/pricing">
            View pricing
          </a>
        </div>
      </div>
    </section>

    <!-- Section 5: Final CTA -->
    <section class="py-20 sm:py-28 bg-white border-t border-ink-200 relative overflow-hidden" id="signup">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="bottom-cta-card relative rounded-2xl border border-ink-800 text-white p-8 sm:p-12 lg:p-14 shadow-2xl shadow-ink-950/30 overflow-hidden text-center">
          <!-- Ambient Glow Accents -->
          <div class="absolute -top-28 -right-28 w-80 h-80 rounded-full bg-brand/20 blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-28 -left-28 w-80 h-80 rounded-full bg-emerald-500/15 blur-3xl pointer-events-none"></div>

          <!-- Top Chip -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-ink-900/90 border border-ink-700 text-xs font-mono mb-6 shadow-sm relative z-10">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-white font-semibold">1,000 credits on signup</span>
            <span class="text-ink-500 select-none">&middot;</span>
            <span class="text-ink-300 font-normal">No credit card required</span>
          </div>

          <!-- Title -->
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4 relative z-10">
            Prove it on one client <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-brand to-rose-300">this week</span>.
          </h2>

          <!-- Subtitle -->
          <p class="text-sm sm:text-base text-ink-300 max-w-xl mx-auto leading-relaxed mb-8 relative z-10">
            1,000 free credits on signup — enough to run a full client audit and ship a polished, white-label deliverable. One bearer token, failed calls auto-refund.
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-wrap items-center justify-center gap-3 relative z-10">
            <a class="relative group overflow-hidden inline-flex items-center px-6 py-3 text-sm font-semibold rounded-lg bg-brand text-white shadow-lg shadow-brand/25 hover:shadow-xl hover:shadow-brand/40 hover:bg-brand-hover transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] focus:ring-2 focus:ring-brand/40" href="/contactus">
              <span class="relative z-10 flex items-center">Request access <span class="ml-1.5 transition-transform duration-200 group-hover:translate-x-1">→</span></span>
              <span class="absolute top-0 -left-full w-full h-full bg-white/20 transform -skew-x-12 group-hover:translate-x-[250%] transition-transform duration-700 ease-out"></span>
            </a>
            <a class="inline-flex items-center px-6 py-3 text-sm font-medium rounded-lg border border-ink-700 bg-ink-900/80 text-ink-200 hover:bg-ink-800 hover:text-white transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 shadow-sm" href="/aeo">
              See AEO audits <span class="ml-1 text-ink-400">→</span>
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="mt-8 pt-6 border-t border-ink-800/80 flex flex-wrap items-center justify-center gap-6 text-[11px] font-mono text-ink-400 relative z-10">
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5l3.5 3.5 6.5-7"/></svg>
              No card required
            </span>
            <span class="text-ink-700 hidden sm:inline">&middot;</span>
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5l3.5 3.5 6.5-7"/></svg>
              White-label JSON Output
            </span>
            <span class="text-ink-700 hidden sm:inline">&middot;</span>
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5l3.5 3.5 6.5-7"/></svg>
              Auto-Refund on Failures

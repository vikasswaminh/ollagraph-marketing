<ul>
  <li><strong>max_links</strong> — <em>Endpoints:</em> broken-links-audit — <em>Description:</em> Max links to check (up to 200) — <em>Default:</em> 50</li>
  <li><strong>concurrency</strong> — <em>Endpoints:</em> broken-links-audit — <em>Description:</em> Parallel link checks (up to 24) — <em>Default:</em> 8</li>
  <li><strong>timeout_seconds</strong> — <em>Endpoints:</em> broken-links-audit — <em>Description:</em> Per-link timeout — <em>Default:</em> 8</li>
  <li><strong>top_k</strong> — <em>Endpoints:</em> keyword-extract — <em>Description:</em> Number of keywords — <em>Default:</em> 20</li>

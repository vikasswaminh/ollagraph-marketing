<pre><code>import os
import requests

def scrape_rendered(url: str):
    resp = requests.post(
        "https://api.ollagraph.com/v1/scrape",
        headers=&#123;"Authorization": f"Bearer &#123;os.environ['OLLAGRAPH_API_KEY']&#125;"&#125;,

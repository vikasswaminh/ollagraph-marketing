---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { navHtml, footerHtml } from '../../chrome';
import { posts } from '../../data/posts';

const sorted = [...posts].sort((a, b) => b.date.localeCompare(a.date));

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Ollagraph blog",
  description: "In-depth writing on building with web data — for AI engineering, sales intelligence, real estate analytics, and more.",
  url: "https://ollagraph.com/blog/",
  blogPost: sorted.map((p) => ({
    "@type": "BlogPosting",
    headline: p.title,
    description: p.description,
    datePublished: p.date,
    url: `https://ollagraph.com/blog/${p.slug}/`,
  })),
};
const nav = navHtml('blog');
const footer = footerHtml();
---
<BaseLayout
  title="Blog — Ollagraph"
  description="In-depth writing on building with web data — for AI teams, RevOps, and data engineers."
  jsonLd={[collectionLd]}
>
  <Fragment set:html={nav} />
  <section class="section" style="padding-top:80px; text-align:center;">
    <div class="container" style="max-width:720px;">
      <h1 class="h-display h-1" style="margin:0 0 18px;">Blog</h1>
      <p class="copy-lg">
        In-depth writing on the open web — for AI teams, RevOps, and data engineers.
      </p>
    </div>
  </section>
  <section class="section-tight">
    <div class="container" style="max-width:760px; display:flex; flex-direction:column; gap:16px;">
      {sorted.map((p) => (
        <a class="recipe-card" href={`/blog/${p.slug}/`}>
          <div style="font-size:12px; color:var(--text-dim); display:flex; gap:8px; flex-wrap:wrap;">
            <span>{p.date}</span><span>·</span><span>{p.readingTime} min read</span><span>·</span><span>{p.tags.join(", ")}</span>
          </div>
          <h3 style="font-size:18px; margin:8px 0;">{p.title}</h3>
          <p>{p.description}</p>
        </a>
      ))}
    </div>
  </section>
  <Fragment set:html={footer} />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import bodyHtml from '../../bodies/legal-privacy.body.html?raw';
import { navHtml, footerHtml } from '../../chrome';

const rendered = bodyHtml
  .replace('<div id="nav-root"></div>', navHtml(""))
  .replace('<div id="footer-root"></div>', footerHtml());
---
<BaseLayout title="Privacy Policy — Ollagraph" description="How Ollagraph collects, uses, and protects personal data.">
  <Fragment set:html={rendered} />
</BaseLayout>

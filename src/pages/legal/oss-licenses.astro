// Group by license family for the summary table.
const families: Record<string, number> = {};
for (const p of packages) families[p.family] = (families[p.family] || 0) + 1;
const familyEntries = Object.entries(families).sort((a, b) => b[1] - a[1]);
---
<BaseLayout title="Open-source licenses — Ollagraph" description="Complete list of every open-source dependency used in the Ollagraph API, with each one's license, version, and family.">
  <Fragment set:html={navHtml('')} />
  <div class="article">
    <h1 class="h-display h-1">Open-source licenses</h1>
    <article class="prose">
      <p>Last updated: 2026-05-24</p>
      <p>
        Ollagraph is built on a foundation of carefully chosen open-source
        software. This page lists every Python dependency in our production API
        image along with its license and version, generated directly from the
        running production environment via <code>pip-licenses</code>. Updated on
        every dependency-bump release.
      </p>

      <h2>License-family summary</h2>
      <table>
        <thead>
          <tr><th>License family</th><th>Packages</th></tr>
        </thead>
        <tbody>
          {familyEntries.map(([f, count]) => (
            <tr><td>{f}</td><td>{count}</td></tr>
          ))}
        </tbody>
      </table>

      <h2>Note on pyphen (LGPL / MPL)</h2>
      <p>
        The <code>pyphen</code> hyphenation library is dual-licensed under
        GPLv2+, LGPLv2+, or MPL-1.1. We use it only internally as a transitive
        dependency of <code>textstat</code> (which powers
        <code>/v1/seo/readability</code>). Both LGPL and MPL are file-level
        (weak) copyleft licenses: they permit commercial network-service use
        without requiring source disclosure. We do not modify, re-distribute, or
        expose <code>pyphen</code> directly to customers. If you would prefer us
        to remove this dependency, contact
        <a href="mailto:legal@ollagraph.com">legal@ollagraph.com</a>.
      </p>

      <h2>Full dependency list</h2>
      <table>
        <thead>
          <tr>
            <th>Package</th>
            <th>Version</th>
            <th>License</th>
            <th>Family</th>
          </tr>
        </thead>
        <tbody>
          {packages.map((p) => (
            <tr>
              <td><code>{p.name}</code></td>
              <td>{p.version}</td>
              <td>{p.license}</td>
              <td>{p.family}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <p>
        Don't see a package you expected? It may be a JavaScript dependency
        (those live on the marketing-site build pipeline, not the API). Email
        <a href="mailto:legal@ollagraph.com">legal@ollagraph.com</a> with the
        package name.
      </p>
    </article>
  </div>
  <Fragment set:html={footerHtml()} />
</BaseLayout>

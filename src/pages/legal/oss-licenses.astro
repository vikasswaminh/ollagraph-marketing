---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { navHtml, footerHtml } from '../../chrome';

// Snapshot of `pip-licenses --format=markdown` taken from the live
// Ollagraph production API image on 2026-05-24. Regenerate when
// dependencies change.

interface Pkg { name: string; version: string; license: string; family: string; }

function fam(license: string): string {
  const l = license.toLowerCase();
  if (l.includes("mit")) return "MIT";
  if (l.includes("bsd")) return "BSD";
  if (l.includes("apache")) return "Apache 2.0";
  if (l.includes("isc")) return "ISC";
  if (l.includes("psf") || l.includes("python software foundation")) return "PSF";
  if (l.includes("mozilla public license") || l.includes("mpl")) return "MPL";
  if (l.includes("lgpl")) return "LGPL (weak copyleft)";
  if (l.includes("agpl")) return "AGPL (network copyleft)";
  if (l.includes("gpl")) return "GPL (copyleft)";
  if (l.includes("w3c")) return "W3C";
  if (l.includes("0bsd")) return "0BSD";
  return "Other";
}

const packages: Pkg[] = [
  { name: "PyYAML", version: "6.0.3", license: "MIT License" },
  { name: "aiohappyeyeballs", version: "2.6.2", license: "PSF" },
  { name: "aiohttp", version: "3.13.5", license: "Apache-2.0 AND MIT" },
  { name: "aiosignal", version: "1.4.0", license: "Apache 2.0" },
  { name: "amqp", version: "5.3.1", license: "BSD" },
  { name: "annotated-types", version: "0.7.0", license: "MIT" },
  { name: "anyio", version: "4.13.0", license: "MIT" },
  { name: "argon2-cffi", version: "23.1.0", license: "MIT" },
  { name: "asyncpg", version: "0.30.0", license: "Apache 2.0" },
  { name: "attrs", version: "26.1.0", license: "MIT" },
  { name: "beautifulsoup4", version: "4.12.3", license: "MIT" },
  { name: "billiard", version: "4.2.4", license: "BSD" },
  { name: "celery", version: "5.4.0", license: "BSD" },
  { name: "certifi", version: "2026.5.20", license: "Mozilla Public License 2.0" },
  { name: "cffi", version: "1.17.1", license: "MIT" },
  { name: "chardet", version: "7.4.3", license: "0BSD" },
  { name: "charset-normalizer", version: "3.4.7", license: "MIT" },
  { name: "click", version: "8.4.1", license: "BSD-3-Clause" },
  { name: "cryptography", version: "46.0.0", license: "Apache-2.0 OR BSD-3-Clause" },
  { name: "cssselect", version: "1.4.0", license: "BSD-3-Clause" },
  { name: "curl_cffi", version: "0.7.4", license: "MIT" },
  { name: "dnspython", version: "2.7.0", license: "ISC" },
  { name: "et_xmlfile", version: "2.0.0", license: "MIT" },
  { name: "extruct", version: "0.18.0", license: "BSD" },
  { name: "fastapi", version: "0.115.6", license: "MIT" },
  { name: "geoip2", version: "4.8.0", license: "Apache 2.0" },
  { name: "h11", version: "0.16.0", license: "MIT" },
  { name: "h3", version: "4.4.2", license: "Apache 2.0" },
  { name: "html-text", version: "0.7.1", license: "MIT" },
  { name: "html5lib", version: "1.1", license: "MIT" },
  { name: "httpcore", version: "1.0.9", license: "BSD-3-Clause" },
  { name: "httptools", version: "0.7.1", license: "MIT" },
  { name: "httpx", version: "0.28.1", license: "BSD" },
  { name: "idna", version: "3.16", license: "BSD-3-Clause" },
  { name: "kombu", version: "5.6.2", license: "BSD-3-Clause" },
  { name: "lxml", version: "5.3.0", license: "BSD" },
  { name: "markdownify", version: "0.13.1", license: "MIT" },
  { name: "maxminddb", version: "2.8.2", license: "Apache 2.0" },
  { name: "mf2py", version: "2.0.1", license: "MIT" },
  { name: "multidict", version: "6.7.1", license: "Apache 2.0" },
  { name: "numpy", version: "2.2.6", license: "BSD" },
  { name: "openpyxl", version: "3.1.5", license: "MIT" },
  { name: "pdfminer.six", version: "20231228", license: "MIT" },
  { name: "pdfplumber", version: "0.11.4", license: "MIT" },
  { name: "pillow", version: "12.2.0", license: "MIT-CMU" },
  { name: "pydantic", version: "2.10.4", license: "MIT" },
  { name: "pydantic_core", version: "2.27.2", license: "MIT" },
  { name: "pypdfium2", version: "5.8.0", license: "BSD-3-Clause + Apache-2.0" },
  { name: "pyphen", version: "0.17.2", license: "GPLv2+ / LGPLv2+ / MPL-1.1 (used internally only — see note below)" },
  { name: "pyrdfa3", version: "3.6.5", license: "W3C License" },
  { name: "python-dateutil", version: "2.9.0", license: "Apache 2.0 / BSD" },
  { name: "python-docx", version: "1.1.2", license: "MIT" },
  { name: "python-dotenv", version: "1.2.2", license: "BSD-3-Clause" },
  { name: "python-pptx", version: "1.0.2", license: "MIT" },
  { name: "python-whois", version: "0.9.5", license: "MIT" },
  { name: "rdflib", version: "7.6.0", license: "BSD" },
  { name: "readability-lxml", version: "0.8.1", license: "Apache 2.0" },
  { name: "redis", version: "5.2.1", license: "MIT" },
  { name: "requests", version: "2.34.2", license: "Apache 2.0" },
  { name: "scipy", version: "1.14.1", license: "BSD" },
  { name: "sentry-sdk", version: "2.19.2", license: "BSD" },
  { name: "starlette", version: "0.41.3", license: "BSD" },
  { name: "stripe", version: "11.4.1", license: "MIT" },
  { name: "textstat", version: "0.7.4", license: "MIT" },
  { name: "timezonefinder", version: "6.5.9", license: "MIT" },
  { name: "tldextract", version: "5.1.3", license: "BSD" },
  { name: "ua-parser", version: "1.0.2", license: "Apache 2.0" },
  { name: "urllib3", version: "2.7.0", license: "MIT" },
  { name: "user-agents", version: "2.2.0", license: "MIT" },
  { name: "uvicorn", version: "0.32.1", license: "BSD" },
  { name: "uvloop", version: "0.22.1", license: "Apache 2.0 / MIT" },
  { name: "vine", version: "5.1.0", license: "BSD" },
  { name: "w3lib", version: "2.4.1", license: "BSD-3-Clause" },
  { name: "websockets", version: "16.0", license: "BSD-3-Clause" },
  { name: "xlsxwriter", version: "3.2.9", license: "BSD" },
  { name: "yarl", version: "1.24.2", license: "Apache 2.0" },
].map(p => ({...p, family: fam(p.license)}));

// Group by license family for the summary table.
const families: Record<string, number> = {};
for (const p of packages) families[p.family] = (families[p.family] || 0) + 1;
const familyEntries = Object.entries(families).sort((a, b) => b[1] - a[1]);
---
<BaseLayout title="Open-source licenses — Ollagraph" description="Complete list of every open-source dependency used in the Ollagraph API, with each one's license, version, and family.">
  <Fragment set:html={navHtml('')} />
  
  <div class="legal-page">
    <div class="legal-hero-glow" aria-hidden="true"></div>

    <header class="legal-hero">
      <div class="legal-hero-inner">
        <div class="legal-badge">
          <span class="legal-badge-dot" aria-hidden="true"></span>
          OPEN SOURCE
        </div>
        <h1 class="legal-title">Open-source licenses</h1>
        <div class="legal-meta-row">
          <span class="legal-meta-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Last updated: 2026-05-24
          </span>
          <span class="legal-meta-sep">•</span>
          <span class="legal-meta-pill">Production Dependencies</span>
          <span class="legal-meta-sep">•</span>
          <span class="legal-meta-pill">76 Packages</span>
          <span class="legal-meta-sep">•</span>
          <span class="legal-meta-pill">Permissive &amp; Copyleft Audit</span>
        </div>

        <nav class="legal-nav-bar" aria-label="Legal policies">
          <a href="/legal/terms" class="legal-nav-item">Terms of Service</a>
          <a href="/legal/privacy" class="legal-nav-item">Privacy Policy</a>
          <a href="/legal/cookies" class="legal-nav-item">Cookie Policy</a>
          <a href="/legal/acceptable-use" class="legal-nav-item">Acceptable Use</a>
          <a href="/legal/subprocessors" class="legal-nav-item">Subprocessors</a>
          <a href="/legal/api-versioning" class="legal-nav-item">API Versioning</a>
          <a href="/legal/oss-licenses" class="legal-nav-item active" aria-current="page"><span class="legal-nav-dot"></span>OSS Licenses</a>
        </nav>
      </div>
    </header>

    <div class="legal-container">
      <!-- Intro Card -->
      <div class="legal-card legal-card--intro">
        <p class="legal-p">
          Ollagraph is built on a foundation of carefully chosen open-source software. This page lists every Python dependency in our production API image along with its license and version, generated directly from the running production environment via <code class="legal-code">pip-licenses</code>. Updated on every dependency-bump release.
        </p>
      </div>

      <!-- License-family summary Card -->
      <div class="legal-card">
        <div class="legal-card-header">
          <div class="legal-card-title-group">
            <span class="legal-card-icon legal-card-icon--default">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path>
                <path d="M22 12A10 10 0 0 0 12 2v10z"></path>
              </svg>
            </span>
            <h2 class="legal-card-h2">License-family summary</h2>
          </div>
        </div>
        <div class="legal-table-wrap">
          <table class="legal-table">
            <thead>
              <tr>
                <th>License family</th>
                <th class="legal-th-right">Packages</th>
              </tr>
            </thead>
            <tbody>
              {familyEntries.map(([f, count]) => (
                <tr>
                  <td><strong>{f}</strong></td>
                  <td class="legal-td-right"><span class="legal-count-badge">{count}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Note on pyphen (LGPL / MPL) -->
      <div class="legal-card">
        <div class="legal-card-header">
          <div class="legal-card-title-group">
            <span class="legal-card-icon legal-card-icon--default">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
            </span>
            <h2 class="legal-card-h2">Note on pyphen (LGPL / MPL)</h2>
          </div>
        </div>
        <p class="legal-p">
          The <code class="legal-code">pyphen</code> hyphenation library is dual-licensed under GPLv2+, LGPLv2+, or MPL-1.1. We use it only internally as a transitive dependency of <code class="legal-code">textstat</code> (which powers <code class="legal-code">/v1/seo/readability</code>). Both LGPL and MPL are file-level (weak) copyleft licenses: they permit commercial network-service use without requiring source disclosure. We do not modify, re-distribute, or expose <code class="legal-code">pyphen</code> directly to customers. If you would prefer us to remove this dependency, contact <a href="mailto:legal@ollagraph.com">legal@ollagraph.com</a>.
        </p>
      </div>

      <!-- Full dependency list -->
      <div class="legal-card">
        <div class="legal-card-header">
          <div class="legal-card-title-group">
            <span class="legal-card-icon legal-card-icon--default">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
            </span>
            <h2 class="legal-card-h2">Full dependency list</h2>
          </div>
          <span class="subp-badge">{packages.length} production packages</span>
        </div>
        <div class="legal-table-wrap">
          <table class="legal-table">
            <thead>
              <tr>
                <th>Package</th>
                <th>Version</th>
                <th>License</th>
                <th>Family</th>
              </tr>
            </thead>
            <tbody>
              {packages.map((p) => (
                <tr>
                  <td><code class="legal-code">{p.name}</code></td>
                  <td class="font-mono text-xs text-ink-600">{p.version}</td>
                  <td>{p.license}</td>
                  <td>
                    <span class={`license-pill ${
                      p.family.includes('MIT') ? 'license-pill--mit' :
                      p.family.includes('BSD') ? 'license-pill--bsd' :
                      p.family.includes('Apache') ? 'license-pill--apache' :
                      'license-pill--other'
                    }`}>
                      {p.family}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="legal-p legal-p--spaced">
          Don't see a package you expected? It may be a JavaScript dependency (those live on the marketing-site build pipeline, not the API). Email <a href="mailto:legal@ollagraph.com">legal@ollagraph.com</a> with the package name.
        </p>
      </div>
    </div>
  </div>

  <Fragment set:html={footerHtml()} />

  <style>
    .legal-table-wrap {
      overflow-x: auto;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      background: #ffffff;
      margin-top: 6px;
    }
    .legal-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13.5px;
      text-align: left;
    }
    .legal-table th {
      background: #f8fafc;
      color: #0f172a;
      font-family: var(--font-mono, monospace);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 11px 16px;
      border-bottom: 1px solid #e2e8f0;
      white-space: nowrap;
    }
    .legal-th-right,
    .legal-td-right {
      text-align: right;
    }
    .legal-p--spaced {
      margin-top: 20px;
    }
    .legal-table td {
      padding: 10px 16px;
      border-bottom: 1px solid #f1f5f9;
      color: #475569;
      font-size: 13.5px;
      line-height: 1.5;
    }
    .legal-table tr:last-child td {
      border-bottom: none;
    }
    .legal-table tr:hover td {
      background: #fafbfd;
    }
    .legal-count-badge {
      display: inline-block;
      font-family: var(--font-mono, monospace);
      font-size: 11.5px;
      font-weight: 700;
      color: #0f172a;
      background: #f1f5f9;
      padding: 2px 8px;
      border-radius: 4px;
      border: 1px solid #e2e8f0;
    }
    .license-pill {
      display: inline-block;
      font-family: var(--font-mono, monospace);
      font-size: 10.5px;
      font-weight: 600;
      padding: 2px 7px;
      border-radius: 4px;
      white-space: nowrap;
    }
    .license-pill--mit {
      background: #f0fdf4;
      color: #166534;
      border: 1px solid #bbf7d0;
    }
    .license-pill--bsd {
      background: #eff6ff;
      color: #1e40af;
      border: 1px solid #bfdbfe;
    }
    .license-pill--apache {
      background: #fefce8;
      color: #854d0e;
      border: 1px solid #fef08a;
    }
    .license-pill--other {
      background: #f8fafc;
      color: #475569;
      border: 1px solid #e2e8f0;
    }
  </style>
</BaseLayout>

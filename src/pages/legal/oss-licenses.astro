---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { navHtml, footerHtml } from '../../chrome';

// Snapshot of `pip-licenses --format=markdown` taken from the live
// Ollagraph production API image on 2026-05-24. Regenerate when
// dependencies change.

interface Pkg { name: string; version: string; license: string; family: string; }

function fam(license: string): string {
  const l = license.toLowerCase();
  if (l.includes("mit")) return "MIT";
  if (l.includes("bsd")) return "BSD";
  if (l.includes("apache")) return "Apache 2.0";
  if (l.includes("isc")) return "ISC";
  if (l.includes("psf") || l.includes("python software foundation")) return "PSF";
  if (l.includes("mozilla public license") || l.includes("mpl")) return "MPL";
  if (l.includes("lgpl")) return "LGPL (weak copyleft)";
  if (l.includes("agpl")) return "AGPL (network copyleft)";
  if (l.includes("gpl")) return "GPL (copyleft)";
  if (l.includes("w3c")) return "W3C";
  if (l.includes("0bsd")) return "0BSD";
  return "Other";
}

const packages: Pkg[] = [

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import bundles from '../../data/bundles.json';
import { navHtml, footerHtml } from '../../chrome';

interface Endpoint {
  method: string;
  path: string;
  credits: number;
  summary: string;
}

interface Bundle {
  slug: string;
  name: string;
  tagline: string;
  persona: string;
  color: string;
  endpoints: Endpoint[];
  recipe: { title: string; steps: string[] };
  samples: { curl: string; python: string; node: string };
  faq: { q: string; a: string }[];
}

export async function getStaticPaths() {
  const all = bundles as Bundle[];
  return all.map((bundle) => ({
    params: { slug: bundle.slug },
    props: { bundle },
  }));
}

const { bundle } = Astro.props as { bundle: Bundle };
const allBundles = bundles as Bundle[];

const bundleIndex = allBundles.findIndex((b) => b.slug === bundle.slug);
const prevBundle = allBundles[(bundleIndex - 1 + allBundles.length) % allBundles.length];
const nextBundle = allBundles[(bundleIndex + 1) % allBundles.length];

interface ThemeDef {
  accent: string;
  bgSoft: string;
  borderSoft: string;
  badgeBg: string;
  badgeColor: string;
}

const BUNDLE_THEMES: Record<string, ThemeDef> = {
  lime: {
    accent: '#10b981',
    bgSoft: '#ecfdf5',
    borderSoft: '#a7f3d0',
    badgeBg: '#ecfdf5',
    badgeColor: '#059669',
  },
  teal: {
    accent: '#0d9488',
    bgSoft: '#f0fdfa',
    borderSoft: '#99f6e4',
    badgeBg: '#f0fdfa',
    badgeColor: '#0f766e',
  },
  blue: {
    accent: '#2563eb',
    bgSoft: '#eff6ff',
    borderSoft: '#bfdbfe',
    badgeBg: '#eff6ff',
    badgeColor: '#1d4ed8',
  },
  amber: {
    accent: '#d97706',
    bgSoft: '#fffbeb',
    borderSoft: '#fde68a',
    badgeBg: '#fffbeb',
    badgeColor: '#b45309',
  },
  violet: {
    accent: '#7c3aed',
    bgSoft: '#f5f3ff',
    borderSoft: '#ddd6fe',
    badgeBg: '#f5f3ff',
    badgeColor: '#6d28d9',
  },
  rose: {
    accent: '#e11d48',
    bgSoft: '#fff1f2',
    borderSoft: '#fecdd3',
    badgeBg: '#fff1f2',
    badgeColor: '#be123c',
  },
  slate: {
    accent: '#475569',
    bgSoft: '#f8fafc',
    borderSoft: '#cbd5e1',
    badgeBg: '#f1f5f9',
    badgeColor: '#334155',
  },
  emerald: {
    accent: '#059669',
    bgSoft: '#ecfdf5',
    borderSoft: '#a7f3d0',
    badgeBg: '#ecfdf5',
    badgeColor: '#047857',
  },
  red: {
    accent: '#dc2626',
    bgSoft: '#fef2f2',
    borderSoft: '#fecaca',
    badgeBg: '#fef2f2',
    badgeColor: '#b91c1c',
  },
  cyan: {
    accent: '#0284c7',
    bgSoft: '#f0f9ff',
    borderSoft: '#bae6fd',
    badgeBg: '#f0f9ff',
    badgeColor: '#0369a1',
  },
};

const theme = BUNDLE_THEMES[bundle.color] || BUNDLE_THEMES.rose;
const prevTheme = BUNDLE_THEMES[prevBundle.color] || BUNDLE_THEMES.rose;
const nextTheme = BUNDLE_THEMES[nextBundle.color] || BUNDLE_THEMES.rose;

const cleanTagline = (text: string) => {
  if (!text) return '';
  const cleaned = text.replace(/^\d+\s+endpoints(?::|\s+for|\s+composing|\s+to|\s+that)?\s*/i, '');
  return cleaned.charAt(0).toUpperCase() + cleaned.slice(1);
};

const totalCredits = bundle.endpoints.reduce((acc, ep) => acc + (ep.credits ?? 0), 0);
const costBand = Math.round(totalCredits / 4);

const firstPath = bundle.endpoints[0]?.path || '/';
const docsAnchor = firstPath.replace(/^\/+/, '').replace(/\//g, '-');
const docsHref = `https://api.ollagraph.com/docs#${docsAnchor}`;
const canonicalUrl = `https://ollagraph.com/bundles/${bundle.slug}/`;

const webPageLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${bundle.name} Bundle — Ollagraph API Workflows`,
  description: bundle.tagline,
  url: canonicalUrl,
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Ollagraph", item: "https://ollagraph.com/" },
    { "@type": "ListItem", position: 2, name: "Bundles", item: "https://ollagraph.com/bundles/" },
    { "@type": "ListItem", position: 3, name: `${bundle.name} Bundle`, item: canonicalUrl },
  ],
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: bundle.faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};

const nav = navHtml('bundles');
const footer = footerHtml();
---

<BaseLayout
  title={`${bundle.name} Bundle — Ollagraph API Workflows`}
  description={bundle.tagline}
  canonical={canonicalUrl}
  jsonLd={[webPageLd, breadcrumbLd, faqLd]}
>
  <Fragment set:html={nav} />

  <main class="bundle-detail-page">
    <!-- Ambient top glow -->
    <div class="bundle-hero-glow" aria-hidden="true"></div>

    <!-- Hero Header -->
    <header class="bundle-hero">
      <div class="bundle-hero-inner">
        <!-- Navigation bar -->
        <div class="bundle-nav-row">
          <a class="bundle-back-link" href="/bundles">
            <span aria-hidden="true">&larr;</span> All bundles
          </a>
          <span class="bundle-index-tag">
            {String(bundleIndex + 1).padStart(2, '0')} / {String(allBundles.length).padStart(2, '0')}
          </span>
        </div>

        <!-- Pill badge -->
        <div class="bundle-hero-pill">
          <span class="pill-color-dot" style={`background-color: ${theme.accent};`}></span>
          <span>{bundle.name} BUNDLE · {bundle.endpoints.length} ENDPOINTS</span>
        </div>

        <h1 class="bundle-title">
          {bundle.name} <span class="bundle-title-accent" style={`text-decoration-color: ${theme.accent}55;`}>Bundle</span>
        </h1>

        <p class="bundle-tagline">
          {bundle.tagline}
        </p>

        <!-- Persona Callout Box -->
        <div class="bundle-persona-box">
          <span class="persona-callout-label">Target Persona &amp; Use Cases:</span>
          <p class="persona-callout-text">{bundle.persona}</p>
        </div>

        <!-- Hero Actions -->
        <div class="bundle-hero-actions">
          <a class="btn-hero-primary" href="/contactus">
            <span>Try this bundle</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn-hero-secondary" href={docsHref} target="_blank" rel="noopener">
            <span>View on API docs</span>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </div>

        <!-- Specs summary chips -->
        <div class="bundle-specs-summary">
          <div class="spec-chip">
            <span class="spec-chip-val">{bundle.endpoints.length}</span>
            <span class="spec-chip-lbl">Endpoints</span>
          </div>
          <span class="spec-chip-sep" aria-hidden="true">·</span>
          <div class="spec-chip">
            <span class="spec-chip-val">~{costBand} cr</span>
            <span class="spec-chip-lbl">Workflow Band</span>
          </div>
          <span class="spec-chip-sep" aria-hidden="true">·</span>
          <div class="spec-chip">
            <span class="spec-chip-val">Bearer Auth</span>
            <span class="spec-chip-lbl">Unified Token</span>
          </div>
          <span class="spec-chip-sep" aria-hidden="true">·</span>
          <div class="spec-chip">
            <span class="spec-chip-val">MCP Server</span>
            <span class="spec-chip-lbl">Compatible</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <div class="bundle-content-wrap">
      <div class="bundle-container">
        <!-- Section 1: Endpoints Table -->
        <section class="bundle-section" id="endpoints">
          <div class="content-card">
            <div class="card-accent-strip" style={`background-color: ${theme.accent};`}></div>
            <div class="section-card-header">
              <div class="h-eyebrow">SPECIFICATION</div>
              <h2 class="card-h2">Endpoints in this bundle</h2>
              <p class="card-desc">
                Each endpoint is independently callable. Bundle membership is for discovery only &mdash; you do not need to opt in.
              </p>
            </div>

            <div class="endpoints-table-wrap">
              <table class="endpoints-table">
                <thead>
                  <tr>
                    <th style="width: 86px;">Method</th>
                    <th>Endpoint Path</th>
                    <th style="width: 86px;">Credits</th>
                    <th>Operation Summary</th>
                  </tr>
                </thead>
                <tbody>
                  {bundle.endpoints.map((ep) => (
                    <tr>
                      <td class="col-method">
                        <span class={`method-badge method-${ep.method.toLowerCase()}`}>{ep.method}</span>
                      </td>
                      <td class="col-path font-mono">{ep.path}</td>
                      <td class="col-credits font-mono">
                        {ep.credits === 0 ? (
                          <span class="credit-pill-free">Free</span>
                        ) : (
                          <span class="credit-pill">{ep.credits} cr</span>
                        )}
                      </td>
                      <td class="col-summary">{ep.summary}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- Section 2: Production Recipe -->
        <section class="bundle-section" id="recipe">
          <div class="content-card">
            <div class="card-accent-strip" style={`background-color: ${theme.accent};`}></div>
            <div class="section-card-header">
              <div class="h-eyebrow">PRODUCTION RECIPE</div>
              <h2 class="card-h2">{bundle.recipe.title}</h2>
              <p class="card-desc">
                Recommended step-by-step workflow sequence for composing these endpoints in production:
              </p>
            </div>

            <div class="recipe-steps-grid">
              {bundle.recipe.steps.map((step, idx) => (
                <div class="recipe-step-card">
                  <div class="recipe-step-num" style={`background-color: ${theme.bgSoft}; color: ${theme.accent}; border-color: ${theme.borderSoft};`}>
                    {String(idx + 1).padStart(2, '0')}
                  </div>
                  <div class="recipe-step-content">
                    <span class="step-label">Step {idx + 1}</span>
                    <p class="step-text">{step}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- Section 3: Interactive Sample Request Code -->
        <section class="bundle-section" id="sample-code">
          <div class="content-card">
            <div class="card-accent-strip" style={`background-color: ${theme.accent};`}></div>
            <div class="section-card-header">
              <div class="h-eyebrow">INTEGRATION CODE</div>
              <h2 class="card-h2">Try a request</h2>
              <p class="card-desc">
                Pick a language. Copy-pasteable code snippet configured with your standard Bearer token header.
              </p>
            </div>

            <div class="code-terminal-frame">
              <div class="terminal-header">
                <div class="terminal-dots">
                  <span class="mac-dot mac-dot-red"></span>
                  <span class="mac-dot mac-dot-yellow"></span>
                  <span class="mac-dot mac-dot-green"></span>
                </div>

                <div class="language-tabs" role="tablist" aria-label="Code language tabs">
                  <button type="button" class="lang-tab active" data-lang="curl" role="tab" aria-selected="true">
                    cURL
                  </button>
                  <button type="button" class="lang-tab" data-lang="python" role="tab" aria-selected="false">
                    Python (httpx)
                  </button>
                  <button type="button" class="lang-tab" data-lang="node" role="tab" aria-selected="false">
                    Node.js (fetch)
                  </button>
                </div>

                <button type="button" class="terminal-copy-btn" id="bundle-copy-btn" aria-label="Copy code snippet">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                  </svg>
                  <span id="copy-btn-text">Copy</span>
                </button>
              </div>

              <div class="terminal-body">
                <pre class="code-pane active" id="pane-curl"><code>{bundle.samples.curl}</code></pre>
                <pre class="code-pane" id="pane-python" hidden><code>{bundle.samples.python}</code></pre>
                <pre class="code-pane" id="pane-node" hidden><code>{bundle.samples.node}</code></pre>
              </div>
            </div>
          </div>
        </section>

        <!-- Section 4: Bundle FAQ -->
        <section class="bundle-section" id="faq">
          <div class="content-card">
            <div class="card-accent-strip" style={`background-color: ${theme.accent};`}></div>
            <div class="section-card-header">
              <div class="h-eyebrow">FREQUENTLY ASKED QUESTIONS</div>
              <h2 class="card-h2">{bundle.name} bundle FAQ</h2>
              <p class="card-desc">
                Common questions about rate limits, execution behavior, and parameters for this workflow.
              </p>
            </div>

            <div class="bundle-faq-list">
              {bundle.faq.map((item) => (
                <details class="bundle-faq-item">
                  <summary class="faq-summary">
                    <span class="faq-question">{item.q}</span>
                    <span class="faq-icon-arrow" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </span>
                  </summary>
                  <div class="faq-answer">
                    <p>{item.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </section>

        <!-- Next / Prev Bundle Navigation -->
        <section class="bundle-nav-section" aria-label="Explore other bundles">
          <div class="bundle-nav-grid">
            <a
              class="nav-bundle-card nav-prev"
              href={`/bundles/${prevBundle.slug}/`}
              style={`--nav-accent: ${prevTheme.accent}; --nav-bg-soft: ${prevTheme.bgSoft}; --nav-border-soft: ${prevTheme.borderSoft};`}
            >
              <div class="nav-card-top">
                <span class="nav-direction-badge">
                  <span class="nav-arrow" aria-hidden="true">&larr;</span>
                  <span>Previous bundle</span>
                </span>
                <span class="nav-count-badge font-mono">{prevBundle.endpoints.length} endpoints</span>
              </div>
              <div class="nav-bundle-name-row">
                <span class="nav-dot" style={`background-color: ${prevTheme.accent};`}></span>
                <span class="nav-bundle-name">{prevBundle.name} Bundle</span>
              </div>
              <p class="nav-bundle-desc">{cleanTagline(prevBundle.tagline)}</p>
            </a>

            <a
              class="nav-bundle-card nav-next"
              href={`/bundles/${nextBundle.slug}/`}
              style={`--nav-accent: ${nextTheme.accent}; --nav-bg-soft: ${nextTheme.bgSoft}; --nav-border-soft: ${nextTheme.borderSoft};`}
            >
              <div class="nav-card-top nav-top-next">
                <span class="nav-count-badge font-mono">{nextBundle.endpoints.length} endpoints</span>
                <span class="nav-direction-badge">
                  <span>Next bundle</span>
                  <span class="nav-arrow" aria-hidden="true">&rarr;</span>
                </span>
              </div>
              <div class="nav-bundle-name-row">
                <span class="nav-bundle-name">{nextBundle.name} Bundle</span>
                <span class="nav-dot" style={`background-color: ${nextTheme.accent};`}></span>
              </div>
              <p class="nav-bundle-desc">{cleanTagline(nextBundle.tagline)}</p>
            </a>
          </div>
        </section>
      </div>
    </div>

    <!-- Bottom Compact Developer CTA -->
    <section class="bundle-compact-cta" aria-label="Access Ollagraph API">
      <div class="cta-glow-left" aria-hidden="true"></div>
      <div class="cta-glow-right" aria-hidden="true"></div>

      <div class="compact-cta-inner">
        <div class="compact-cta-pill">
          <span class="pill-green-dot" aria-hidden="true"></span>
          <span class="pill-credits">1,000 free credits</span>
          <span class="pill-sep">·</span>
          <span class="pill-tagline">No card required</span>
        </div>

        <h2 class="compact-cta-title">Ship with the {bundle.name} bundle.</h2>

        <p class="compact-cta-desc">
          1,000 credits on signup. No card. Every endpoint in this bundle is live from minute one.
        </p>

        <div class="compact-cta-actions">
          <a class="btn-cta-crimson" href="/contactus">
            <span>Try this bundle</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn-cta-dark" href={docsHref} target="_blank" rel="noopener">
            <span>View on docs</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="compact-cta-trust">
          <div class="trust-item">
            <span class="trust-check">&#10003;</span>
            <span>No credit card required</span>
          </div>
          <span class="trust-sep">·</span>
          <div class="trust-item">
            <span class="trust-check">&#10003;</span>
            <span>Flat 1 credit / call base</span>
          </div>
          <span class="trust-sep">·</span>
          <div class="trust-item">
            <span class="trust-check">&#10003;</span>
            <span>All {bundle.endpoints.length} endpoints ready</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Fragment set:html={footer} />
</BaseLayout>

<style>
  /* ==========================================================================
     DYNAMIC BUNDLE DETAIL PAGE — MODERN CLEAN DESIGN SYSTEM
     ========================================================================== */

  .bundle-detail-page {
    position: relative;
    background: #ffffff;
    color: #0f172a;
    min-height: 100vh;
    overflow: hidden;
  }

  .bundle-hero-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 1200px;
    height: 480px;
    background: radial-gradient(ellipse 65% 50% at 50% 0%, rgba(225, 29, 72, 0.05) 0%, rgba(37, 99, 235, 0.03) 45%, transparent 75%);
    pointer-events: none;
    z-index: 0;
  }

  .bundle-container {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }

  /* ---- Hero Header ---- */
  .bundle-hero {
    position: relative;
    z-index: 1;
    padding: 48px 20px 24px;
  }

  .bundle-hero-inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .bundle-nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .bundle-back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .bundle-back-link:hover {
    color: #e11d48;
  }

  .bundle-index-tag {
    font-family: var(--font-mono, monospace);
    font-size: 11.5px;
    font-weight: 600;
    color: #94a3b8;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 2px 8px;
    border-radius: 6px;
  }

  .bundle-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 14px;
    border-radius: 9999px;
    border: 1px solid rgba(225, 29, 72, 0.2);
    background: rgba(225, 29, 72, 0.04);
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.06em;
    color: #475569;
    margin-bottom: 18px;
    box-shadow: 0 1px 2px rgba(225, 29, 72, 0.05);
  }

  .pill-color-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }

  .bundle-title {
    font-family: var(--font-display, 'Geist', 'Inter', sans-serif);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 850;
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: #020617;
    margin: 0 0 16px;
  }

  .bundle-title-accent {
    text-decoration: underline;
    text-decoration-thickness: 4px;
    text-underline-offset: 6px;
  }

  .bundle-tagline {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    line-height: 1.62;
    color: #475569;
    max-width: 720px;
    margin: 0 auto 20px;
  }

  .bundle-persona-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 14px 18px;
    max-width: 720px;
    margin: 0 auto 26px;
    text-align: left;
  }

  .persona-callout-label {
    display: block;
    font-family: var(--font-mono, monospace);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
    margin-bottom: 4px;
  }

  .persona-callout-text {
    font-size: 13.5px;
    line-height: 1.55;
    color: #334155;
    margin: 0;
    font-style: italic;
  }

  .bundle-hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 42px;
    padding: 0 22px;
    border-radius: 8px;
    background: #e11d48;
    color: #ffffff !important;
    font-weight: 650;
    font-size: 14px;
    text-decoration: none !important;
    box-shadow: 0 4px 14px rgba(225, 29, 72, 0.3);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-hero-primary:hover {
    background: #be123c;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(225, 29, 72, 0.4);
  }

  .btn-hero-secondary {

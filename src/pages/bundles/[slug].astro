---
import BaseLayout from '../../layouts/BaseLayout.astro';
import bundles from '../../content/bundles.json';
import { navHtml, footerHtml } from '../../chrome';

interface Endpoint {
  method: string;
  path: string;
  credits: number;
  summary: string;
}
interface Bundle {
  slug: string;
  name: string;
  tagline: string;
  persona: string;
  color: string;
  endpoints: Endpoint[];
  recipe: { title: string; steps: string[] };
  samples: { curl: string; python: string; node: string };
  faq: { q: string; a: string }[];
}

export async function getStaticPaths() {
  const all = bundles as Bundle[];
  return all.map((bundle) => ({
    params: { slug: bundle.slug },
    props: { bundle },
  }));
}

const { bundle } = Astro.props as { bundle: Bundle };

// Color map — same set used elsewhere on the marketing site (matches the
// CSS custom properties in /styles.css for the named ones, with hex
// fallbacks for the two that aren't tokens). Used for the accent top rule
// on each card on this page so each bundle gets a visual signature.
const COLOR_MAP: Record<string, string> = {
  lime:    '#1D4ED8',
  teal:    '#0d9488',
  blue:    '#2563EB',
  amber:   '#92600A',
  violet:  '#7c3aed',
  rose:    '#e11d48',
  slate:   '#64748b',
  emerald: '#1B7A4E',
  red:     '#b91c1c',
  cyan:    '#0e7490',
};
const accent = COLOR_MAP[bundle.color] || '#1D4ED8';

// Escape HTML for any field we drop into a template literal — these strings
// originate from a checked-in JSON file (trusted) but we still want safe
// rendering in case future edits introduce angle brackets in summaries.
const esc = (s: string) =>
  s.replace(/&/g, '&amp;')
   .replace(/</g, '&lt;')
   .replace(/>/g, '&gt;')
   .replace(/"/g, '&quot;');

// Anchor on the Swagger UI page for the first endpoint in the bundle.
// FastAPI/Swagger generates anchors of the form `operations-{tag}-{operationId}`
// but a plain path-based fragment is good enough for a "View on docs" deeplink
// — Swagger UI scrolls to the closest match.
const firstPath = bundle.endpoints[0]?.path || '/';
const docsAnchor = firstPath.replace(/^\/+/, '').replace(/\//g, '-');
const docsHref = `https://api.ollagraph.com/docs#${docsAnchor}`;

const endpointRowsHtml = bundle.endpoints.map((ep) => `
  <tr>
    <td><span class="method method-${esc(ep.method.toLowerCase())}">${esc(ep.method)}</span></td>
    <td class="path-cell text-mono">${esc(ep.path)}</td>
    <td class="credits-cell">${ep.credits}</td>
    <td class="summary-cell">${esc(ep.summary)}</td>
  </tr>`).join('');

const recipeStepsHtml = bundle.recipe.steps
  .map((step) => `<li>${esc(step)}</li>`)
  .join('');

const faqHtml = bundle.faq.map((item) => `
  <details class="faq-item">
    <summary>${esc(item.q)}</summary>
    <p>${esc(item.a)}</p>
  </details>`).join('');

const samplesHtml = `
  <details class="code-tab" open>
    <summary><span class="code-tab-label">curl</span></summary>
    <pre class="code-block"><code>${esc(bundle.samples.curl)}</code></pre>
  </details>
  <details class="code-tab">
    <summary><span class="code-tab-label">python</span></summary>
    <pre class="code-block"><code>${esc(bundle.samples.python)}</code></pre>
  </details>
  <details class="code-tab">
    <summary><span class="code-tab-label">node</span></summary>
    <pre class="code-block"><code>${esc(bundle.samples.node)}</code></pre>
  </details>`;

const body = `
  <div class="bg-grid"></div>
  <div class="bg-noise"></div>
  ${navHtml('bundles')}

  <!-- Hero -->
  <section style="padding: 80px 0 28px; position: relative;">
    <div class="hero-glow"></div>
    <div class="container">
      <div class="measure">
        <a href="/bundles" style="display:inline-flex; align-items:center; gap:6px; color: var(--text-muted); font-size: 13px; margin-bottom: 22px;">
          <span aria-hidden="true">&larr;</span> All bundles
        </a>
        <a class="pill" style="margin-bottom: 22px; border-color: ${accent}40; color: ${accent};">
          <span class="pill-dot" style="background: ${accent};"></span>${esc(bundle.name)} bundle &middot; ${bundle.endpoints.length} endpoints
        </a>
        <h1 class="h-display h-1" style="margin: 0 0 18px;">${esc(bundle.name)}</h1>
        <p style="font-size: 18px; color: var(--text-muted); line-height: 1.55; margin: 0 0 18px;">
          ${esc(bundle.tagline)}
        </p>
        <p style="font-size: 14px; color: var(--text-dim); line-height: 1.55; margin: 0;">
          ${esc(bundle.persona)}
        </p>
      </div>
    </div>
  </section>

  <!-- Endpoints table -->
  <section class="section">
    <div class="container">
      <div class="bundle-card bundle-card--accent" style="--bundle-accent: ${accent};">
        <h2 class="h-display h-2" style="margin: 0 0 6px;">Endpoints in this bundle</h2>
        <p style="color: var(--text-muted); font-size: 14px; margin: 0 0 20px;">
          Each endpoint is independently callable. Bundle membership is for
          discovery only &mdash; you do not need to opt in.
        </p>
        <div class="endpoint-table-wrap">
          <table class="endpoint-table">
            <thead>
              <tr>
                <th style="width: 80px;">Method</th>
                <th>Path</th>
                <th style="width: 80px;">Credits</th>
                <th>Summary</th>
              </tr>
            </thead>
            <tbody>
              ${endpointRowsHtml}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Recipe -->
  <section class="section">
    <div class="container">
      <div class="bundle-card bundle-card--accent" style="--bundle-accent: ${accent};">
        <div style="font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--text-muted); margin-bottom: 8px;">Recipe</div>
        <h2 class="h-display h-2" style="margin: 0 0 18px;">${esc(bundle.recipe.title)}</h2>
        <ol class="recipe-list">
          ${recipeStepsHtml}
        </ol>
      </div>
    </div>
  </section>

  <!-- Sample code -->
  <section class="section">
    <div class="container">
      <div class="bundle-card bundle-card--accent" style="--bundle-accent: ${accent};">
        <div style="font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--text-muted); margin-bottom: 8px;">Sample code</div>
        <h2 class="h-display h-2" style="margin: 0 0 6px;">Try a request</h2>
        <p style="color: var(--text-muted); font-size: 14px; margin: 0 0 18px;">
          Pick a language. Click to expand the snippet.
        </p>
        <div class="code-tabs">
          ${samplesHtml}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <div class="bundle-card bundle-card--accent" style="--bundle-accent: ${accent};">
        <div style="font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--text-muted); margin-bottom: 8px;">FAQ</div>
        <h2 class="h-display h-2" style="margin: 0 0 18px;">${esc(bundle.name)} bundle FAQ</h2>
        <div class="faq-list">
          ${faqHtml}
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section style="padding: 72px 0 96px; text-align: center;">
    <div class="container" style="max-width: 660px;">
      <h2 class="h-display h-2" style="margin: 0 0 16px;">Ship with the ${esc(bundle.name)} bundle.</h2>
      <p style="color: var(--text-muted); font-size: 15px; margin: 0 auto 26px; max-width: 540px;">
        1,000 credits on signup. No card. Every endpoint in this bundle is live from minute one.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href="/contactus">Try this bundle</a>
        <a class="btn btn-secondary btn-lg" href="${docsHref}">View on docs</a>
      </div>
    </div>
  </section>

  ${footerHtml()}

    <style>
    .bundle-card {
      background: var(--surface, #111114);
      border: 1px solid var(--border, rgba(255,255,255,0.08));
      border-radius: var(--radius-lg, 14px);
      padding: 28px 28px;
    }
    /* Per-bundle accent as a short rule at the card top (replaces the
       side-tab left border — reads as template slop). */
    .bundle-card--accent::before {
      content: "";
      display: block;
      width: 26px;
      height: 3px;
      border-radius: 2px;
      background: var(--bundle-accent, var(--accent, #1D4ED8));
      margin-bottom: 16px;
    }
    @media (max-width: 760px) {
      .bundle-card { padding: 22px 18px; }
    }

    /* Endpoint table */
    .endpoint-table-wrap {
      width: 100%;
      overflow-x: auto;
      border-radius: var(--radius, 10px);
      border: 1px solid var(--border, rgba(255,255,255,0.08));
    }
    .endpoint-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    .endpoint-table thead th {
      background: rgba(255,255,255,0.025);
      text-align: left;
      font-weight: 500;
      color: var(--text-muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 12px 14px;
      border-bottom: 1px solid var(--border, rgba(255,255,255,0.08));
    }
    .endpoint-table tbody td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--border, rgba(255,255,255,0.06));
      vertical-align: top;
      color: var(--text);
    }
    .endpoint-table tbody tr:last-child td { border-bottom: none; }
    .endpoint-table tbody tr:hover td { background: rgba(255,255,255,0.02); }
    .endpoint-table .path-cell {
      font-family: var(--font-mono, monospace);
      font-size: 12px;
      color: var(--text);
      white-space: nowrap;
    }
    .endpoint-table .credits-cell {
      font-family: var(--font-mono, monospace);
      font-size: 12px;
      color: var(--accent, #1D4ED8);
    }
    .endpoint-table .summary-cell {
      color: var(--text-muted);
      font-size: 13px;
      line-height: 1.55;
    }
    .method {
      display: inline-block;
      font-family: var(--font-mono, monospace);
      font-size: 10.5px;
      font-weight: 600;
      padding: 3px 7px;
      border-radius: 4px;
      letter-spacing: 0.05em;
    }
    .method-post  { background: rgba(94,234,212,0.10); color: var(--cyan, #5eead4); border: 1px solid rgba(94,234,212,0.22); }
    .method-get   { background: rgba(96,165,250,0.10); color: var(--blue, #60a5fa); border: 1px solid rgba(96,165,250,0.22); }
    .method-put   { background: rgba(251,191,36,0.10); color: var(--amber, #fbbf24); border: 1px solid rgba(251,191,36,0.22); }
    .method-delete{ background: rgba(248,113,113,0.10); color: var(--red, #f87171); border: 1px solid rgba(248,113,113,0.22); }

    /* Recipe list */
    .recipe-list {
      margin: 0;
      padding-left: 22px;
      color: var(--text);
      line-height: 1.7;
      font-size: 15px;
    }
    .recipe-list li {
      margin-bottom: 12px;
      color: var(--text);
    }
    .recipe-list li::marker {
      color: var(--text-muted);
      font-family: var(--font-mono, monospace);
      font-size: 13px;
    }

    /* Code tabs (details/summary, no JS) */
    .code-tabs {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .code-tab {
      border: 1px solid var(--border, rgba(255,255,255,0.08));
      border-radius: var(--radius, 10px);
      overflow: hidden;
      background: rgba(255,255,255,0.015);
    }
    .code-tab > summary {
      list-style: none;
      cursor: pointer;
      padding: 10px 14px;
      font-family: var(--font-mono, monospace);
      font-size: 12px;
      color: var(--text-muted);
      background: rgba(255,255,255,0.025);
      user-select: none;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .code-tab > summary::-webkit-details-marker { display: none; }
    .code-tab > summary::before {
      content: "+";
      display: inline-block;
      width: 12px;
      color: var(--text-dim);
      font-family: var(--font-mono, monospace);
    }
    .code-tab[open] > summary::before { content: "-"; }
    .code-tab[open] > summary {
      color: var(--text);
      border-bottom: 1px solid var(--border, rgba(255,255,255,0.08));
    }
    .code-tab-label { font-weight: 500; }
    .code-block {
      margin: 0;
      padding: 16px 18px;
      font-family: var(--font-mono, monospace);
      font-size: 12px;
      line-height: 1.55;
      color: var(--text);
      background: transparent;
      overflow-x: auto;
      white-space: pre;
    }
    .code-block code { font: inherit; color: inherit; background: transparent; }

    /* FAQ */
    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .faq-item {
      border: 1px solid var(--border, rgba(255,255,255,0.08));
      border-radius: var(--radius, 10px);
      background: rgba(255,255,255,0.015);
    }
    .faq-item > summary {
      list-style: none;
      cursor: pointer;
      padding: 14px 16px;
      font-size: 14px;
      color: var(--text);
      user-select: none;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .faq-item > summary::-webkit-details-marker { display: none; }
    .faq-item > summary::before {
      content: "+";
      display: inline-block;
      width: 12px;
      color: var(--text-dim);
      font-family: var(--font-mono, monospace);
    }
    .faq-item[open] > summary::before { content: "-"; }
    .faq-item[open] > summary {
      border-bottom: 1px solid var(--border, rgba(255,255,255,0.06));
    }
    .faq-item p {
      margin: 0;
      padding: 14px 16px;
      color: var(--text-muted);
      font-size: 14px;
      line-height: 1.55;
    }
  </style>`;
---
<BaseLayout title={`${bundle.name} bundle — Ollagraph`} description={bundle.tagline}>
  <Fragment set:html={body} />
</BaseLayout>

<script is:inline>
  function initBundleTabs() {
    var tabs = document.querySelectorAll('.language-tabs .lang-tab');
    var copyBtn = document.getElementById('bundle-copy-btn');
    var copyText = document.getElementById('copy-btn-text');

    if (!tabs || tabs.length === 0) return;

    var panes = {
      curl: document.getElementById('pane-curl'),
      python: document.getElementById('pane-python'),
      node: document.getElementById('pane-node'),
    };

    var currentLang = 'curl';

    for (var i = 0; i < tabs.length; i++) {
      (function(tab) {
        tab.addEventListener('click', function() {
          var lang = tab.getAttribute('data-lang');
          if (!lang || !panes[lang]) return;

          currentLang = lang;

          for (var j = 0; j < tabs.length; j++) {
            tabs[j].classList.remove('active');
            tabs[j].setAttribute('aria-selected', 'false');
          }
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');

          for (var k in panes) {
            if (panes[k]) {
              panes[k].setAttribute('hidden', '');
              panes[k].classList.remove('active');
            }
          }
          panes[lang].removeAttribute('hidden');
          panes[lang].classList.add('active');
        });
      })(tabs[i]);
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        var activePane = panes[currentLang];
        if (!activePane) return;
        var code = activePane.textContent || '';
        navigator.clipboard.writeText(code).then(function() {
          if (copyText) {
            copyText.textContent = 'Copied!';
            setTimeout(function() {
              copyText.textContent = 'Copy';
            }, 1800);
          }
        }).catch(function() {
          if (copyText) {
            copyText.textContent = 'Copied!';
            setTimeout(function() {
              copyText.textContent = 'Copy';
            }, 1800);
          }
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBundleTabs);
  } else {
    initBundleTabs();
  }
  document.addEventListener('astro:page-load', initBundleTabs);
</script>

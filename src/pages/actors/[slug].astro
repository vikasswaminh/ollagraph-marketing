---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { navHtml, footerHtml } from '../../chrome';
import { actors } from '../../data/actors';

export function getStaticPaths() {
  return actors.map((a) => ({ params: { slug: a.slug }, props: { actor: a } }));
}
const { actor } = Astro.props;
const url = `https://ollagraph.com/actors/${actor.slug}/`;

const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", name: `${actor.name} actor — Ollagraph`, url, description: actor.short },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Ollagraph", item: "https://ollagraph.com/" },
    { "@type": "ListItem", position: 2, name: "Actors", item: "https://ollagraph.com/actors/" },
    { "@type": "ListItem", position: 3, name: actor.name, item: url },
  ] },
];

const epPath = actor.endpoint.replace(/^\w+\s+/, '');
const curl = `curl -X POST https://api.ollagraph.com${epPath} \\
  -H "Authorization: Bearer $OLLAGRAPH_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{"url": "https://example.com"}'`;
---
<BaseLayout title={`${actor.name} actor — Ollagraph`} description={actor.short} jsonLd={jsonLd}>
  <Fragment set:html={navHtml('actors')} />
  <main class="article">
    <a class="article-back" href="/actors">← All actors</a>
    <div class="article-meta"><span>{actor.category}</span><span>·</span><span class="text-mono">{actor.endpoint}</span></div>
    <h1 class="h-display h-1">{actor.name} actor</h1>
    <p class="article-lede">{actor.short}</p>
    <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:18px;">
      <a class="btn btn-primary" href="https://app.ollagraph.com/signup">Start free</a>
      <a class="btn btn-secondary" href="/actors">Browse all actors</a>
    </div>

    <article class="prose">
      <p>{actor.long}</p>

      {actor.endpoints ? (
        <>
          <h2>Endpoints in this family</h2>
          <ul>
            {actor.endpoints.map((e) => (<li><code>{e.path}</code> — {e.note}</li>))}
          </ul>
          <p>See the <a href="https://api.ollagraph.com/docs">Swagger UI</a> or the <a href="https://api.ollagraph.com/openapi.json">OpenAPI spec</a> for each endpoint's exact request and response shape.</p>
        </>
      ) : (
        <>
          <h2>Request</h2>
          <p>Send a POST to <code>{epPath}</code> with a target <code>url</code>. Enable <code>stealth</code> or the residential-proxy option for sites with aggressive bot defenses.</p>
          <div class="code-block" style="margin:18px 0;">
            <div class="code-head"><span>curl</span><span class="text-mono" style="color:var(--text-dim);">{actor.endpoint}</span></div>
            <div class="code-body"><pre style="margin:0;"><code>{curl}</code></pre></div>
          </div>
        </>
      )}

      {actor.fields && actor.fields.length > 0 && (
        <>
          <h2>Response fields</h2>
          <table style="width:100%; border-collapse:collapse; font-size:14px;">
            <thead><tr>
              <th style="text-align:left; padding:8px 10px; border-bottom:1px solid var(--border); color:var(--text-muted);">Field</th>
              <th style="text-align:left; padding:8px 10px; border-bottom:1px solid var(--border); color:var(--text-muted);">Type</th>
              <th style="text-align:left; padding:8px 10px; border-bottom:1px solid var(--border); color:var(--text-muted);">Example</th>
            </tr></thead>
            <tbody>
              {actor.fields.map((f) => (
                <tr>
                  <td style="padding:8px 10px; border-bottom:1px solid var(--border);"><code>{f.name}</code></td>
                  <td style="padding:8px 10px; border-bottom:1px solid var(--border); color:var(--text-muted);">{f.type}</td>
                  <td style="padding:8px 10px; border-bottom:1px solid var(--border); color:var(--text-muted);">{f.example}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </>
      )}

      {actor.sample && (
        <>
          <h2>{actor.endpoints ? "Sample response (illustrative)" : "Sample response"}</h2>
          <div class="code-block" style="margin:18px 0;">
            <div class="code-head"><span>JSON</span><span class="text-mono" style="color:var(--text-dim);">200 OK</span></div>
            <div class="code-body"><pre style="margin:0;"><code>{actor.sample}</code></pre></div>
          </div>
        </>
      )}

      {actor.proxyNote && (<><h2>Proxy &amp; reliability</h2><p>{actor.proxyNote}</p></>)}

      <p style="margin-top:28px;">
        {actor.recipe && (<>See the full pipeline in the <a href={`/recipes/${actor.recipe}`}>step-by-step recipe</a>. </>)}
        Part of the <a href="/actors">actor catalog</a> — all behind one bearer token. Failed calls auto-refund.
      </p>
    </article>
  </main>

  <section class="article-cta section-tight" style="text-align:center;">
    <h2 class="h-display h-2" style="margin:0 0 14px;">Pull {actor.name.toLowerCase()} data in five minutes.</h2>
    <p style="color:var(--text-muted); max-width:520px; margin:0 auto 22px;">1,000 free credits, one bearer token, no card.</p>
    <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
      <a class="btn btn-primary btn-lg" href="https://app.ollagraph.com/signup">Start free</a>
      <a class="btn btn-secondary btn-lg" href="/docs">Read the docs</a>
    </div>
  </section>
  <Fragment set:html={footerHtml()} />
</BaseLayout>

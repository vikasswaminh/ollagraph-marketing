<Article
  title="How to extract structured data from articles in 2026"
  description="Pull clean article bodies, JSON-LD, OpenGraph, Twitter Cards, and reading-time metadata from any news or blog page — the modern alternative to building a Readability fork."
  date="2026-05-16"
  readingTime={13}
  tags={["recipes", "article-extraction", "readability", "structured-data"]}

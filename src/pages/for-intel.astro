---
import BaseLayout from '../layouts/BaseLayout.astro';
import bodyHtml from '../bodies/for-intel.body.html?raw';
import headExtras from '../bodies/for-intel.head.html?raw';
import { navHtml, footerHtml } from '../chrome';

const rendered = bodyHtml
  .replace('<div id="nav-root"></div>', navHtml(""))
  .replace('<div id="footer-root"></div>', footerHtml());

const softwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Ollagraph for Security & Intelligence Teams",
  applicationCategory: "SecurityApplication",
  operatingSystem: "Cloud API",
  url: "https://ollagraph.com/for-intel/",
  description: "Domain intel, certificate transparency, subdomain enumeration, DNS, SSL and phishing/IOC reputation through one API — built on public data with zero content retention.",
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "USD",
    lowPrice: "0",
    offerCount: "1",
  },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://ollagraph.com" },
    { "@type": "ListItem", position: 2, name: "For Intel & Security", item: "https://ollagraph.com/for-intel/" }
  ]
};
---
<BaseLayout
  title="Ollagraph for Security Teams — Web Intelligence APIs"
  description="Domain intel, certificate transparency, subdomain enumeration, DNS, SSL and phishing/IOC reputation through one API — free-data, no paid feeds, no abuse vectors."
  jsonLd={[softwareApp, breadcrumbLd]}
>
  <Fragment slot="head" set:html={headExtras} />
  <Fragment set:html={rendered} />
</BaseLayout>


---
import BaseLayout from '../layouts/BaseLayout.astro';
import bodyHtml from '../bodies/docs.body.html?raw';
import headExtras from '../bodies/docs.head.html?raw';
import { navHtml, footerHtml } from '../chrome';
import openapi from '../openapi.json';
// Real captured responses, keyed by operationId. Regenerate with
// scripts/capture_response_examples.py. Endpoints without an entry simply omit
// the "Example response" block.
import responseExamples from '../response_examples.json';

const HTTP_METHODS = ['GET', 'POST', 'PUT', 'PATCH', 'DELETE'];

const TAG_ORDER = [
  'Scraping', 'Extraction', 'Conversion',
  'AEO', 'SEO', 'Intelligence', 'DNS', 'Actors',
  'Parsing', 'Captcha', 'Crawl', 'Jobs',
  'Account', 'Keys', 'Billing', 'Auth', 'Verify', 'Health', 'Admin',
];

const TAG_BLURBS: Record<string, string> = {
  Scraping:     'Fetch a page. Static or JS-rendered. Single or batch. Sync or async. Plus llm-ready chunking for RAG.',
  Extraction:   'Pull the article, the contacts, the tables. Clean HTML to text your agent can read.',
  Conversion:   'PDF, DOCX, XLSX, PPTX, CSV, HTML to Markdown. OCR for images. Layout-aware extraction.',
  AEO:          'Audit how AI crawlers see, cite, and rank your site. Page audit, citation readiness, llms.txt, fetch simulator.',
  SEO:          'Meta-tag audits, readability, schema validation, redirect chains, broken links, anchor text, freshness.',
  Intelligence: 'WHOIS, RDAP, DNS, SSL, GeoIP, ASN. Certificate transparency. Subdomain enumeration. Email auth.',
  DNS:          'DNS resolution and propagation. Cross-resolver checks.',
  Actors:       'Higher-cost provider-routed lookups for hard-to-fetch sources. Use sparingly.',
  Parsing:      'URL, user-agent, and email parsers. Cheap, structured, no fetch.',
  Captcha:      'reCAPTCHA v2/v3 solving + auto-solve flow for sites behind a challenge.',
  Crawl:        'Walk a site within budget and depth limits. Returns each page asynchronously.',
  Jobs:         'Poll long-running scrape/crawl jobs by id.',
  Account:      'Your user record, usage, current credit balance.',
  Keys:         'API key CRUD. Create, list, revoke from the dashboard or the API.',
  Billing:      'Dodo checkout sessions, customer portal links, plan info.',
  Auth:         'Email/password signup + login, password reset, email verification.',
  Verify:       'Email mailbox verifier (MX + SMTP-level checks).',
  Health:       'Liveness probe. Free, unauthenticated.',
  Admin:        'Internal-only admin endpoints. Not part of the public surface.',
};

const schemas = (openapi.components && (openapi.components as any).schemas) || {};

function esc(s: string): string {
  return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// Resolve a JSON-schema fragment to a short human type string.
function typeOf(sch: any): string {
  if (!sch) return 'any';
  if (sch.$ref) return String(sch.$ref).split('/').pop() as string;
  if (sch.anyOf) {
    const nn = sch.anyOf.filter((x: any) => x && x.type !== 'null');
    return nn.length ? nn.map(typeOf).join(' | ') : 'any';
  }
  if (sch.allOf) return sch.allOf.map(typeOf).join(' & ');
  if (sch.enum) return sch.enum.map((e: any) => JSON.stringify(e)).join(' | ');
  if (sch.type === 'array') return typeOf(sch.items) + '[]';
  if (sch.type) return sch.format ? `${sch.type} (${sch.format})` : sch.type;
  return 'object';
}

type Prop = { name: string; type: string; required: boolean; desc: string; def: any };
function bodyProps(op: any): Prop[] {
  const media = op?.requestBody?.content?.['application/json'];
  // Pydantic-model routes reference a named component ($ref); pass-through proxy
  // routes (e.g. Stagehand) carry an inline schema via openapi_extra. Handle both.
  const ref = media?.schema?.$ref;
  const sc = ref ? schemas[String(ref).split('/').pop() as string] : media?.schema;
  if (!sc || !sc.properties) return [];
  const req = new Set<string>(sc.required || []);
  return Object.entries(sc.properties).map(([name, ps]: [string, any]) => ({
    name, type: typeOf(ps), required: req.has(name), desc: ps.description || '', def: ps.default,
  }));
}

// Prefer a real example body from the spec (openapi_extra examples / example) for
// the curl sample; null falls back to synthBody(props) below.
function exampleBodyOf(op: any): Record<string, any> | null {
  const media = op?.requestBody?.content?.['application/json'];
  if (!media) return null;
  if (media.examples) {
    const first: any = Object.values(media.examples)[0];
    if (first && first.value !== undefined) return first.value;
  }
  if (media.example !== undefined) return media.example;
  return null;
}

function synthValue(name: string, p: Prop): any {
  const t = p.type;
  if (p.def !== undefined && p.def !== null) return p.def;
  if (/url$/i.test(name) || name === 'url') return 'https://example.com';
  if (/email/i.test(name)) return 'name@example.com';
  if (/domain/i.test(name)) return 'example.com';
  if (t.endsWith('[]')) return [];
  if (/^(integer|number)/.test(t)) return 0;
  if (/^boolean/.test(t)) return false;
  if (t.includes('string')) return 'string';
  return 'value';
}
function synthBody(props: Prop[]): Record<string, any> {
  const o: Record<string, any> = {};
  const reqd = props.filter((p) => p.required);
  (reqd.length ? reqd : props.slice(0, 1)).forEach((p) => { o[p.name] = synthValue(p.name, p); });
  return o;
}
function curlSample(method: string, path: string, body: Record<string, any>): string {
  const url = 'https://api.ollagraph.com' + path;
  const lines: string[] = [];
  const hasBody = method !== 'GET' && Object.keys(body).length > 0;
  lines.push('curl' + (method === 'GET' ? '' : ' -X ' + method) + ' ' + url + (hasBody || method !== 'GET' ? ' \\' : ''));
  lines.push('  -H "Authorization: Bearer $OLLAGRAPH_API_KEY"' + (hasBody ? ' \\' : ''));
  if (hasBody) {
    lines.push('  -H "Content-Type: application/json" \\');
    lines.push("  -d '" + JSON.stringify(body) + "'");
  }
  return lines.join('\n');
}

function highlightCurl(method: string, path: string, body: Record<string, any>): string {
  const url = 'https://api.ollagraph.com' + path;
  const lines: string[] = [];
  const hasBody = method !== 'GET' && Object.keys(body).length > 0;
  if (method === 'GET') {
    lines.push(`<span class="hl-cmd">curl</span> <span class="hl-url">${esc(url)}</span>` + (hasBody ? ' \\' : ''));
  } else {
    lines.push(`<span class="hl-cmd">curl</span> <span class="hl-flag">-X</span> <span class="hl-method m-${method.toLowerCase()}">${esc(method)}</span> <span class="hl-url">${esc(url)}</span> \\`);
  }
  lines.push(`  <span class="hl-flag">-H</span> <span class="hl-str">"Authorization: Bearer <span class="hl-var">$OLLAGRAPH_API_KEY</span>"</span>` + (hasBody ? ' \\' : ''));
  if (hasBody) {
    lines.push(`  <span class="hl-flag">-H</span> <span class="hl-str">"Content-Type: application/json"</span> \\`);
    const inlineJson = esc(JSON.stringify(body)).replace(
      /(&quot;.*?&quot;)(\s*:)?/g,
      (m, p1, p2) => p2 ? `<span class="hl-key">${p1}</span>:` : `<span class="hl-str">${p1}</span>`
    );
    lines.push(`  <span class="hl-flag">-d</span> <span class="hl-data">'${inlineJson}'</span>`);
  }
  return lines.join('\n');
}

function highlightJson(obj: any): string {
  const jsonStr = JSON.stringify(obj, null, 2);
  return jsonStr.replace(
    /("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g,
    (match) => {
      if (/^"/.test(match)) {
        if (/:$/.test(match)) {
          const key = match.slice(0, -1);
          return `<span class="hl-key">${esc(key)}</span>:`;
        } else {
          return `<span class="hl-str">${esc(match)}</span>`;
        }
      } else if (/^(true|false)$/.test(match)) {
        return `<span class="hl-bool">${match}</span>`;
      } else if (/^null$/.test(match)) {
        return `<span class="hl-null">${match}</span>`;
      } else if (/^-?\d/.test(match)) {
        return `<span class="hl-num">${match}</span>`;
      }
      return esc(match);
    }
  );
}

type EP = { method: string; path: string; opId: string; summary: string; desc: string; props: Prop[]; exampleBody: Record<string, any> | null };
const groups: Record<string, EP[]> = {};
for (const [path, ops] of Object.entries(openapi.paths as Record<string, any>)) {
  for (const [method, op] of Object.entries(ops as Record<string, any>)) {
    const M = method.toUpperCase();
    if (!HTTP_METHODS.includes(M)) continue;
    const tag = (op.tags && op.tags[0]) || 'Other';
    const summary = String(op.summary || op.operationId || '').replace(/\s*Endpoint\s*$/i, '').trim();
    const opId = op.operationId || (method.toLowerCase() + '_' + path.replace(/[^a-zA-Z0-9]/g, '_'));
    (groups[tag] = groups[tag] || []).push({ method: M, path, opId, summary, desc: op.description || '', props: bodyProps(op), exampleBody: exampleBodyOf(op) });
  }
}
for (const t of Object.keys(groups)) groups[t].sort((a, b) => a.path.localeCompare(b.path));
const tags = [...TAG_ORDER.filter((t) => groups[t]), ...Object.keys(groups).filter((t) => !TAG_ORDER.includes(t))];
const totalOps = Object.values(groups).reduce((s, e) => s + e.length, 0);

// --- Category Tabs (Top Categories + More ▾ Dropdown) ---
const TOP_TAGS = ['Scraping', 'Extraction', 'Conversion', 'AEO', 'SEO'];
const visibleTopTags = TOP_TAGS.filter((t) => groups[t]);
const moreTags = tags.filter((t) => !visibleTopTags.includes(t));

const topTabsHtml = [
  `<button class="ds-tab active" data-tab="Overview" type="button">`
    + `<svg class="ds-tab-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>`
    + `<span class="ds-tab-name">Overview</span>`
    + `</button>`,
  ...visibleTopTags.map((t) => {
    const count = groups[t]?.length || 0;
    return `<button class="ds-tab" data-tab="${esc(t)}" type="button">`
      + `<span class="ds-tab-name">${esc(t)}</span>`
      + `<span class="ds-tab-count">${count}</span>`
      + `</button>`;
  })
].join('');

const moreItemsHtml = moreTags.map((t) => {
  const count = groups[t]?.length || 0;
  return `<button class="ds-more-item" data-tab="${esc(t)}" type="button">`
    + `<span class="ds-more-item-name">${esc(t)}</span>`
    + `<span class="ds-more-item-count">${count}</span>`
    + `</button>`;
}).join('');

const moreDropdownHtml = moreTags.length > 0 ? (
  `<div class="ds-more-wrap" id="ds-more-wrap">`
    + `<button class="ds-tab ds-tab-more" id="ds-more-btn" type="button" aria-expanded="false" aria-haspopup="true">`
      + `<span class="ds-tab-name" id="ds-more-label">More</span>`
      + `<span class="ds-tab-count" id="ds-more-count">${moreTags.length}</span>`
      + `<svg class="ds-more-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>`
    + `</button>`
    + `<div class="ds-more-menu" id="ds-more-menu">${moreItemsHtml}</div>`
  + `</div>`
) : '';

const tabsHtml = topTabsHtml + moreDropdownHtml;

// --- Sidebar ---
const sidebarHtml = tags.map((tag) => {
  const links = groups[tag].map((ep) => {
    const search = `${ep.method} ${ep.path} ${ep.summary}`.toLowerCase();
    return `<a class="ds-link" href="#${esc(ep.opId)}" data-s="${esc(search)}">`
      + `<span class="ds-m m-${ep.method.toLowerCase()}">${ep.method}</span>`
      + `<span class="ds-p">${esc(ep.path)}</span></a>`;
  }).join('');
  return `<div class="ds-group" data-tag="${esc(tag)}"><a class="ds-group-h" href="#tag-${esc(tag.toLowerCase())}">${esc(tag)} <span class="ds-group-count">${groups[tag].length}</span></a>${links}</div>`;
}).join('');

// --- Main content ---
const contentHtml = tags.map((tag) => {
  const blurb = TAG_BLURBS[tag] || '';
  const eps = groups[tag].map((ep) => {
    const paramRows = ep.props.length
      ? `<div class="ep-block">`
        + `<div class="ep-block-header"><span>Body parameters</span><span class="ep-param-count">${ep.props.length} fields</span></div>`
        + `<div class="ep-table-wrap"><table class="ep-params"><thead><tr><th>Field</th><th>Type</th><th>Required</th><th>Description</th></tr></thead><tbody>`
        + ep.props.map((p) =>
            `<tr><td><code class="ep-prop-name">${esc(p.name)}</code></td><td class="t-type">${esc(p.type)}</td>`
            + `<td>${p.required ? '<span class="req">required</span>' : '<span class="opt">optional</span>'}</td>`
            + `<td>${esc(p.desc)}</td></tr>`).join('')
        + `</tbody></table></div></div>`
      : '';
    const curl = curlSample(ep.method, ep.path, ep.exampleBody ?? synthBody(ep.props));
    const curlHtml = highlightCurl(ep.method, ep.path, ep.exampleBody ?? synthBody(ep.props));
    const respExample = (responseExamples as Record<string, any>)[ep.opId];
    const respBlock = respExample !== undefined
      ? `<div class="ep-terminal ep-terminal-resp">`
        + `<div class="ep-terminal-header">`
          + `<div class="flex items-center gap-2">`
            + `<span class="ep-terminal-tag"><span class="ep-tag-dot ep-tag-dot-resp"></span>Example response</span>`
            + `<span class="ep-status-badge">200 OK</span>`
          + `</div>`
        + `</div>`
        + `<pre class="ep-code"><code>${highlightJson(respExample)}</code></pre>`
        + `</div>`
      : '';
    return `<article class="ep-card ep-detail" id="${esc(ep.opId)}">`
      + `<div class="ep-card-top">`
        + `<div class="ep-h"><span class="ep-method m-${ep.method.toLowerCase()}">${ep.method}</span><code class="ep-fullpath">${esc(ep.path)}</code></div>`
        + `<button class="ep-copy-path-btn" data-copy="${esc(ep.path)}" title="Copy endpoint path" type="button">`
          + `<svg class="ep-copy-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`
          + `<span class="ep-btn-label">Copy path</span>`
        + `</button>`
      + `</div>`
      + (ep.summary ? `<h3 class="ep-summary">${esc(ep.summary)}</h3>` : '')
      + (ep.desc ? `<p class="ep-desc">${esc(ep.desc)}</p>` : '')
      + paramRows
      + `<div class="ep-terminal">`
        + `<div class="ep-terminal-header">`
          + `<span class="ep-terminal-tag"><span class="ep-tag-dot ep-tag-dot-req"></span>Example request</span>`
          + `<button class="ep-copy-btn" data-copy="${esc(curl)}" type="button" aria-label="Copy cURL command">`
            + `<svg class="ep-copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`
            + `<span class="ep-btn-label">Copy</span>`
          + `</button>`
        + `</div>`
        + `<pre class="ep-code"><code>${curlHtml}</code></pre>`
      + `</div>`
      + respBlock
      + `</article>`;
  }).join('');
  return `<section class="ds-section ds-section--hidden" data-tab-panel="${esc(tag)}" id="tag-${esc(tag.toLowerCase())}">`
    + `<div class="ds-section-h">`
      + `<div class="ds-cat-meta"><span class="pill"><span class="pill-dot"></span>${groups[tag].length} endpoints</span></div>`
      + `<h2>${esc(tag)}</h2>`
      + (blurb ? `<p>${esc(blurb)}</p>` : '')
    + `</div>${eps}</section>`;
}).join('');

const rendered = bodyHtml
  .replace('<div id="nav-root"></div>', navHtml('docs'))
  .replace('<div id="footer-root"></div>', footerHtml())
  .replace(/__TOTAL_OPS__/g, String(totalOps))
  .replace('__SIDEBAR__', sidebarHtml)
  .replace('__TABS__', tabsHtml)
  .replace('__CONTENT__', contentHtml);
---
<BaseLayout title="Ollagraph API Docs — Reference, SDKs &amp; Code Samples" description="Full API reference for Ollagraph — every endpoint with parameters and examples. One Bearer token, one OpenAPI spec, one MCP server.">
  <Fragment slot="head">
    <link rel="stylesheet" href="/homepage-tailwind.css?v=27" />
    <Fragment set:html={headExtras} />
  </Fragment>
  <Fragment set:html={rendered} />
  <script is:inline src="/scripts/docs.js?v=37"></script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import bodyHtml from '../bodies/changelog.body.html?raw';
import headExtras from '../bodies/changelog.head.html?raw';
import { navHtml, footerHtml } from '../chrome';
import stats from '../data/api-stats.json';

const rendered = bodyHtml
  .replace('<div id="nav-root"></div>', navHtml(""))
  .replace('<div id="footer-root"></div>', footerHtml())
  .split('%%ENDPOINT_COUNT%%').join(String(stats.endpointCount));
---
<BaseLayout title="Changelog — Ollagraph" description={`Every meaningful change to the Ollagraph API and platform across all ${stats.endpointCount} endpoints, by date. Subscriptions via RSS and webhook.`}>
  <Fragment slot="head" set:html={headExtras} />
  <Fragment set:html={rendered} />
</BaseLayout>

          <!-- Title -->
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4 relative z-10">
            Skip the <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-brand to-rose-300">headless-browser fleet</span>.

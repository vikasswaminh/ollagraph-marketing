---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navHtml, footerHtml } from '../chrome';
import stats from '../data/api-stats.json';

const openExample = `# Click, type, and scroll on the loaded page, then capture it. One call, one fresh browser.
curl -X POST https://api.ollagraph.com/v1/scrape \\
  -H "Authorization: Bearer $OLLAGRAPH_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "url": "https://example.com/catalog",
    "format": "markdown",
    "wait_until": "networkidle0",
    "actions": [
      {"action": "click", "selector": "button.load-more"},
      {"action": "click", "selector": "button.load-more"},
      {"action": "scroll_to_bottom"}
    ]
  }'
# => { "status": "success", "url": "...", "format": "markdown",
#      "content": "...", "time_ms": 3120, "fallback": false }`;

const actExample = `# Act on the page, then read it with your own JavaScript.
curl -X POST https://api.ollagraph.com/v1/scrape \\
  -H "Authorization: Bearer $OLLAGRAPH_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "url": "https://example.com/catalog",
    "actions": [
      {"action": "type", "selector": "input[name=filter]", "text": "wireless headphones"},
      {"action": "scroll_to_bottom"}
    ],
    "js_eval": "JSON.stringify([...document.querySelectorAll(\\".product h2\\")].map(e => e.textContent.trim()))"
  }'
# eval_result comes back as a string — parse it in your code:
# -> { "status": "success", ..., "eval_result": "[\\"Model A\\",\\"Model B\\"]" }`;

const extractExample = `# Wait for an element to appear, then screenshot just that element.
curl -X POST https://api.ollagraph.com/v1/screenshot \\
  -H "Authorization: Bearer $OLLAGRAPH_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "url": "https://example.com/pricing",
    "wait_for_selector": "#pricing-table",
    "selector": "#pricing-table",
    "format": "png",
    "output": "json"
  }'
# -> { "status": "success", "url": "...", "final_url": "...",
#      "content_type": "image/png", "bytes": 48213, "image_base64": "..." }`;

const macroExample = `# Run the same actions across many URLs in one request.
curl -X POST https://api.ollagraph.com/v1/scrape/batch \\
  -H "Authorization: Bearer $OLLAGRAPH_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "urls": [
      "https://example.com/catalog?page=1",
      "https://example.com/catalog?page=2",
      "https://example.com/catalog?page=3"
    ],
    "concurrency": 3,
    "format": "markdown",
    "actions": [
      {"action": "click", "selector": "button.load-more"},
      {"action": "scroll_to_bottom"}
    ]
  }'`;

const sessionExample = `# Queue a scrape and get the result posted to your webhook.
curl -X POST https://api.ollagraph.com/v1/scrape/async \\
  -H "Authorization: Bearer $OLLAGRAPH_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "url": "https://example.com/catalog",
    "webhook_url": "https://your-app.example/hooks/ollagraph",
    "format": "markdown",
    "actions": [{"action": "scroll_to_bottom"}]
  }'
# -> { "status": "queued", "job_id": "..." }`;

const pillars = [
  {
    title: "Explicit page actions",
    body: "Describe the steps as JSON: click a selector, type into a field, scroll to the bottom. Up to 50 actions run in order on the loaded page before it is captured, so the same request runs the same steps every time. No browser code to write.",
    tag: "DETERMINISTIC",
    color: "sky"
  },
  {
    title: "A fresh browser every call",
    body: "Each request gets a clean headless browser that is discarded when the call ends. No cookies, storage, or logged-in state carry from one call to the next — nothing to keep alive, nothing to reap, no state leaking between jobs.",
    tag: "STATELESS",
    color: "emerald"
  },
  {
    title: "Read the page with your own JS",
    body: "Pass js_eval with any JavaScript expression and its value comes back in eval_result. Wrap it in JSON.stringify to pull a list of names, prices, or links out of the rendered DOM and parse it on your side.",
    tag: "JS EVAL",
    color: "purple"
  },
  {
    title: "No Playwright fleet to run",
    body: "There is no headless Chrome to deploy, no browser pool to scale, no stealth tuning — scrape calls run in stealth mode by default. Run the same actions over many URLs with batch requests, or queue async jobs that post results to your webhook.",
    tag: "SERVERLESS",
    color: "rose"
  },
];

const flows = [
  { title: "Load everything, then read it", steps: "Click the load-more button a few times, scroll_to_bottom, and get the fully expanded page back as markdown. One scrape call, one fresh browser." },
  { title: "Pull structured data with JS", steps: "Add a js_eval expression that JSON.stringify-s the product cards on the rendered page, then parse eval_result in your code into name, price, and URL fields." },
  { title: "Filter a client-side list", steps: "Type into an in-page filter box and click apply before capture. Works for interactions that update the page in place — actions don't wait for a navigation to a new page." },
  { title: "Same steps across many URLs", steps: "Send a list of URLs to /v1/scrape/batch with one actions array and a concurrency limit. Each URL runs in its own fresh browser." },
  { title: "Fire and forget with a webhook", steps: "Queue a scrape with /v1/scrape/async and a webhook_url. You get a job_id immediately and the result is posted to your endpoint when it finishes." },
  { title: "Visual check of the result", steps: "Use /v1/screenshot with wait_for_selector and selector to capture just the element you care about, as PNG or JPEG, for visual diffs or reports." },
];

const faqs = [
  { q: "What is the difference between this, the scraping API, and the browser API?", a: "They all run on the same stateless headless browser. This automation page is about driving a page with explicit actions — click, type, scroll — and running those steps at scale with batch and async jobs. The scraping API is the single-page call that carries those actions. The browser API page covers rendering to hydrated HTML and screenshots. Every call, on every page, is a fresh browser." },
  { q: "Do I need to write CSS selectors?", a: "Yes. Click and type actions target elements by CSS selector, for example {\"action\": \"click\", \"selector\": \"button.load-more\"}. There is no natural-language element matching, so if the target site changes its markup you update the selector." },
  { q: "Is there a natural-language or AI agent mode?", a: "No. There is no model in the loop: you send explicit JSON steps and they run exactly as written. If you want an LLM to decide the steps, run that logic in your own code and send the resulting actions array to /v1/scrape." },
  { q: "Are sessions persistent across calls?", a: "No. Every call starts a fresh browser and discards it when the call ends — cookies, storage, and any logged-in state are not kept. That also means logging in is not supported: actions cannot complete a login, and you cannot pass your own cookies. Use the API for publicly reachable pages." },
  { q: "What happens if an action navigates to a new page?", a: "Actions don't wait for a navigation, so they are meant for in-page interactions: opening a panel, typing into a filter, clicking load more, scrolling. To get a different page, call /v1/scrape with that page's URL directly." },
  { q: "Which actions are supported?", a: "Three: {\"action\": \"click\", \"selector\": ...}, {\"action\": \"type\", \"selector\": ..., \"text\": ...}, and {\"action\": \"scroll_to_bottom\"}. The key is action. You can send up to 50 per call. There is no wait action — set wait_until on /v1/scrape to control when the page counts as loaded." },
  { q: "How do I get structured data out?", a: "Pass a js_eval expression. Its value comes back as a string in eval_result, so wrap structured results in JSON.stringify and parse them on your side. You can combine js_eval with actions in the same call." },
  { q: "Can I run the same actions on many pages?", a: "Yes. /v1/scrape/batch takes a list of URLs plus one actions array and a concurrency limit. /v1/scrape/batch/async does the same as a background job with an optional webhook_url, and /v1/scrape/async queues a single URL and posts the result to your webhook_url." },
  { q: "How is this billed?", a: "A scrape call costs 1 credit, and JavaScript rendering and the actions in that call add nothing. Screenshots cost 3 credits. Opting into a residential proxy adds 3 credits. Failed calls are refunded, so a timeout or a missed element never costs you. You get 1,000 free credits on signup — see pricing for the current credit packs." },
];

const url = "https://ollagraph.com/automation/";
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", name: "Browser automation API — Ollagraph", url, description: "Drive a real headless browser with JSON page actions — click, type, scroll — plus JavaScript evaluation, screenshots, batch runs, and async webhooks. A fresh browser every call, no Playwright fleet to run." },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Ollagraph", item: "https://ollagraph.com/" },
    { "@type": "ListItem", position: 2, name: "Browser automation API", item: url },
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---
<BaseLayout
  title="Browser automation API — click, type, scroll page actions — Ollagraph"
  description="Drive a real headless browser with JSON page actions — click, type, scroll — plus JavaScript evaluation, screenshots, batch runs, and async webhooks. A fresh browser every call, no Playwright fleet to run."
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/homepage-tailwind.css?v=28" />
    <style>
      body {
        font-family: 'Geist', 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }
      .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }
      details summary::-webkit-details-marker,
      details summary::marker {
        display: none;
        content: "";
      }
    </style>
  </Fragment>

  <Fragment set:html={navHtml('automation')} />

  <div class="relative overflow-hidden bg-white text-ink-950 font-sans">
    
    <!-- Hero Section -->
    <section class="relative pt-16 pb-16 sm:pt-24 sm:pb-20 border-b border-ink-200 overflow-hidden bg-white">
      <!-- Background Ambient Glow & Grid -->
      <div class="absolute inset-0 pointer-events-none -z-10 flex items-center justify-center">
        <div class="w-[700px] h-[400px] rounded-full bg-brand/5 blur-3xl opacity-60"></div>
      </div>
      <div class="absolute inset-0 bg-[radial-gradient(#e2e8f0_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none -z-10"></div>

      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <!-- Eyebrow Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-ink-200 bg-ink-50/80 text-xs font-mono mb-6 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-brand animate-pulse"></span>
          <span class="text-ink-900 font-semibold">AUTOMATION</span>
          <span class="text-ink-300 select-none">•</span>
          <span class="text-ink-600 font-medium">Click · Type · Scroll</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-[3.75rem] leading-[1.1] font-bold tracking-tight text-ink-950 mb-6 max-w-4xl mx-auto">
          Drive a browser <span class="text-brand underline decoration-brand/30 decoration-4 underline-offset-4">with JSON steps.</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg lg:text-xl text-ink-600 max-w-3xl mx-auto leading-relaxed mb-8 font-normal">
          Send a URL and a list of page actions — click, type, scroll — and get the page back after they run, as markdown, HTML, or the result of your own JavaScript. Every call is a fresh browser and nothing is kept between calls. Scale it with batch and async jobs, without a single line of Playwright.
        </p>

        <!-- CTA Row -->
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a class="relative group overflow-hidden inline-flex items-center px-5 py-2.5 text-sm font-semibold rounded bg-brand text-white shadow-sm hover:shadow-lg hover:shadow-brand/25 hover:bg-brand-hover transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] focus:ring-2 focus:ring-brand/40" href="/contactus">
            <span class="relative z-10 flex items-center">Request access <span class="ml-1.5 transition-transform duration-200 group-hover:translate-x-1">→</span></span>
            <span class="absolute top-0 -left-full w-full h-full bg-white/20 transform -skew-x-12 group-hover:translate-x-[250%] transition-transform duration-700 ease-out"></span>
          </a>
          <a class="inline-flex items-center px-5 py-2.5 text-sm font-medium rounded border border-ink-300 bg-white text-ink-700 hover:bg-ink-50 hover:text-ink-900 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 shadow-xs hover:shadow" href="/docs">
            Read the docs <span class="ml-1 text-ink-400">→</span>
          </a>
        </div>

        <p class="text-xs sm:text-sm text-ink-500 mt-6 max-w-xl mx-auto">
          For single-page extraction see <a href="/scrape" class="text-brand hover:underline font-medium">the scraping API</a>; for rendering and screenshots see <a href="/browser" class="text-brand hover:underline font-medium">the browser API</a>.
        </p>
      </div>
    </section>

    <!-- Pillars Section -->
    <section class="py-16 sm:py-20 border-b border-ink-200 bg-[#FAFAFA]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <div class="text-xs font-mono text-brand font-semibold uppercase tracking-wider mb-2">
            CORE CAPABILITIES
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950">
            Explicit actions, fresh browsers, zero browser ops.
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {pillars.map((p, idx) => (
            <div class={`platform-card ${idx === 0 ? 'platform-card-sky' : idx === 1 ? 'platform-card-emerald' : idx === 2 ? 'platform-card-purple' : 'platform-card-rose'} p-6 sm:p-7 rounded-xl border border-ink-200/90 shadow-xs hover:shadow-lg hover:-translate-y-1 transition-all duration-300 bg-white group cursor-default flex flex-col justify-between relative overflow-hidden`}>
              <div>
                <div class="flex items-center gap-3 mb-4">
                  <div class={`platform-card-icon-wrap ${idx === 0 ? 'bg-sky-50 text-sky-600 border-sky-200/60' : idx === 1 ? 'bg-emerald-50 text-emerald-600 border-emerald-200/60' : idx === 2 ? 'bg-purple-50 text-purple-600 border-purple-200/60' : 'bg-rose-50 text-brand border-rose-200/60'} border`}>
                    {idx === 0 && (
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" /></svg>
                    )}
                    {idx === 1 && (
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                    )}
                    {idx === 2 && (
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
                    )}
                    {idx === 3 && (
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" /></svg>
                    )}
                  </div>
                  <div>
                    <span class={`text-[10px] font-mono font-bold uppercase tracking-wider block ${idx === 0 ? 'text-sky-600' : idx === 1 ? 'text-emerald-600' : idx === 2 ? 'text-purple-600' : 'text-brand'}`}>
                      {p.tag}
                    </span>
                    <h3 class="text-lg font-semibold text-ink-900 group-hover:text-brand transition-colors duration-200">{p.title}</h3>
                  </div>
                </div>
                <p class="text-sm leading-relaxed text-ink-600">
                  {p.body}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Code Examples Section: Drive it five ways -->
    <section class="py-16 sm:py-20 border-b border-ink-200 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <div class="text-xs font-mono text-brand font-semibold uppercase tracking-wider mb-2">
            EXECUTION MODES
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950 mb-3">
            Drive it five ways.
          </h2>
          <p class="text-sm sm:text-base text-ink-600">
            Page actions, JavaScript evaluation, element screenshots, batch runs, and async jobs with a webhook.
          </p>
        </div>

        <div class="space-y-6">
          <!-- Terminal 1: Click, type, scroll -->
          <div class="rounded-xl border border-ink-800 bg-[#090D14] overflow-hidden shadow-xl font-mono text-xs text-ink-100">
            <div class="flex items-center justify-between border-b border-ink-800 px-4 py-2.5 bg-ink-950 select-none">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
                </div>
                <span class="ml-2 text-ink-200 text-xs font-semibold">Click, type, scroll</span>
                <span class="text-ink-500 text-[11px] hidden sm:inline">• POST /v1/scrape</span>
              </div>
              <button type="button" class="quick-copy-btn text-ink-400 hover:text-white p-1 rounded hover:bg-ink-800 flex items-center gap-1 text-[11px] transition-colors" data-copy={openExample}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-5 overflow-x-auto leading-relaxed">
              <pre class="m-0 text-ink-100 whitespace-pre"><code>{openExample}</code></pre>
            </div>
          </div>

          <!-- Terminal 2: Act, then evaluate JS -->
          <div class="rounded-xl border border-ink-800 bg-[#090D14] overflow-hidden shadow-xl font-mono text-xs text-ink-100">
            <div class="flex items-center justify-between border-b border-ink-800 px-4 py-2.5 bg-ink-950 select-none">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
                </div>
                <span class="ml-2 text-ink-200 text-xs font-semibold">Act, then evaluate JS</span>
                <span class="text-ink-500 text-[11px] hidden sm:inline">• POST /v1/scrape</span>
              </div>
              <button type="button" class="quick-copy-btn text-ink-400 hover:text-white p-1 rounded hover:bg-ink-800 flex items-center gap-1 text-[11px] transition-colors" data-copy={actExample}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-5 overflow-x-auto leading-relaxed">
              <pre class="m-0 text-ink-100 whitespace-pre"><code>{actExample}</code></pre>
            </div>
          </div>

          <!-- Terminal 3: Element screenshot -->
          <div class="rounded-xl border border-ink-800 bg-[#090D14] overflow-hidden shadow-xl font-mono text-xs text-ink-100">
            <div class="flex items-center justify-between border-b border-ink-800 px-4 py-2.5 bg-ink-950 select-none">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
                </div>
                <span class="ml-2 text-ink-200 text-xs font-semibold">Element screenshot</span>
                <span class="text-ink-500 text-[11px] hidden sm:inline">• POST /v1/screenshot</span>
              </div>
              <button type="button" class="quick-copy-btn text-ink-400 hover:text-white p-1 rounded hover:bg-ink-800 flex items-center gap-1 text-[11px] transition-colors" data-copy={extractExample}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-5 overflow-x-auto leading-relaxed">
              <pre class="m-0 text-ink-100 whitespace-pre"><code>{extractExample}</code></pre>
            </div>
          </div>

          <!-- Terminal 4: Batch across URLs -->
          <div class="rounded-xl border border-ink-800 bg-[#090D14] overflow-hidden shadow-xl font-mono text-xs text-ink-100">
            <div class="flex items-center justify-between border-b border-ink-800 px-4 py-2.5 bg-ink-950 select-none">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
                </div>
                <span class="ml-2 text-ink-200 text-xs font-semibold">Batch across URLs</span>
                <span class="text-ink-500 text-[11px] hidden sm:inline">• POST /v1/scrape/batch</span>
              </div>
              <button type="button" class="quick-copy-btn text-ink-400 hover:text-white p-1 rounded hover:bg-ink-800 flex items-center gap-1 text-[11px] transition-colors" data-copy={macroExample}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-5 overflow-x-auto leading-relaxed">
              <pre class="m-0 text-ink-100 whitespace-pre"><code>{macroExample}</code></pre>
            </div>
          </div>

          <!-- Terminal 5: Async with a webhook -->
          <div class="rounded-xl border border-ink-800 bg-[#090D14] overflow-hidden shadow-xl font-mono text-xs text-ink-100">
            <div class="flex items-center justify-between border-b border-ink-800 px-4 py-2.5 bg-ink-950 select-none">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
                </div>
                <span class="ml-2 text-ink-200 text-xs font-semibold">Async with a webhook</span>
                <span class="text-ink-500 text-[11px] hidden sm:inline">• POST /v1/scrape/async</span>
              </div>
              <button type="button" class="quick-copy-btn text-ink-400 hover:text-white p-1 rounded hover:bg-ink-800 flex items-center gap-1 text-[11px] transition-colors" data-copy={sessionExample}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-5 overflow-x-auto leading-relaxed">
              <pre class="m-0 text-ink-100 whitespace-pre"><code>{sessionExample}</code></pre>
            </div>
          </div>
        </div>

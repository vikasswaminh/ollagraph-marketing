        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {flows.map((f, idx) => (
            <div class="p-6 rounded-xl border border-ink-200/90 bg-white shadow-xs hover:border-brand/40 hover:shadow-md hover:-translate-y-0.5 transition-all group flex flex-col justify-between">
              <div>
                <div class="w-8 h-8 rounded-lg bg-rose-50 text-brand border border-rose-200/60 flex items-center justify-center font-mono font-bold text-xs mb-3">

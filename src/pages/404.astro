---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navHtml, footerHtml } from '../chrome';
---
<BaseLayout title="Page not found — Ollagraph" description="That page doesn't exist.">
  <Fragment set:html={navHtml('')} />
  <div class="article" style="text-align:center; min-height:50vh;">
    <span class="badge badge-mute" style="margin-top:48px;">404</span>
    <h1 class="h-display h-1" style="margin:16px 0 12px;">Page not found.</h1>
    <p class="article-lede" style="margin:0 auto;">That page doesn't exist or has moved. Here's the way back in.</p>
    <div class="cta-row cta-row--mt">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-secondary" href="/capabilities">Capabilities</a>
      <a class="btn btn-secondary" href="/docs">Docs</a>
      <a class="btn btn-secondary" href="/recipes">Recipes</a>
    </div>
  </div>
  <Fragment set:html={footerHtml()} />
</BaseLayout>

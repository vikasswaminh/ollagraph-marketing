---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navHtml, footerHtml } from '../chrome';
import stats from '../data/api-stats.json';

const openExample = `# Render a URL in a fresh headless browser. JavaScript runs; you get the hydrated HTML.
curl -X POST https://api.ollagraph.com/v1/render \\
  -H "Authorization: Bearer $OLLAGRAPH_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{"url": "https://example.com/app"}'
# => { "status": "success", "url": "...", "final_url": "...",
#      "html": "<!doctype html>...", "tier_used": "...", "status_code": 200 }`;

const renderExample = `# Wait for the network to settle, return markdown, and evaluate a JS expression.
curl -X POST https://api.ollagraph.com/v1/scrape \\
  -H "Authorization: Bearer $OLLAGRAPH_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "url": "https://example.com/dashboard",
    "wait_until": "networkidle0",
    "format": "markdown",
    "js_eval": "document.querySelectorAll(\\"article\\").length"
  }'
# => { "status": "success", "url": "...", "format": "markdown", "content": "...",
#      "eval_result": "24", "time_ms": 2310, "fallback": false }`;

const scriptExample = `# Run page actions on the loaded page before it is captured — click, type, scroll.
curl -X POST https://api.ollagraph.com/v1/scrape \\
  -H "Authorization: Bearer $OLLAGRAPH_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "url": "https://example.com/reports",
    "format": "html",
    "actions": [
      {"action": "type", "selector": "input[name=filter]", "text": "2026"},
      {"action": "click", "selector": "#load-report"},
      {"action": "scroll_to_bottom"}
    ]
  }'
# Actions run once, in order, then the page is captured. They don't wait for a
# navigation, so use them for in-page interactions, not multi-page flows.`;

const inspectExample = `# Capture a full-page screenshot. Raw PNG bytes by default.
curl -X POST https://api.ollagraph.com/v1/screenshot \\
  -H "Authorization: Bearer $OLLAGRAPH_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "url": "https://example.com/dashboard",
    "full_page": true,
    "wait_until": "networkidle0",
    "device_scale_factor": 2
  }' -o dashboard.png
# Pass "output": "json" instead to get
# { "status", "url", "final_url", "content_type", "bytes", "image_base64" }`;

const pillars = [
  {
    title: "Every call is a fresh browser",
    body: "Each request starts a clean headless browser, does its work, and throws the browser away. Cookies, localStorage, and cache are not kept between calls, so there is nothing to open, keep alive, or clean up — and no state leaking from one request into the next.",
    tag: "STATELESS",
    color: "sky"
  },
  {
    title: "Stealth and fallback built in",
    body: "Scrape calls run in stealth mode by default, and you can opt into captcha solving with solve_captcha. Renders that get blocked escalate through fallback tiers automatically, and the response tells you which tier served it in tier_used.",
    tag: "STEALTH",
    color: "emerald"
  },
  {
    title: "Render JavaScript, get clean HTML",
    body: "Point the API at a URL and it executes the page's JavaScript, waits for load or network idle, and returns rendered HTML, markdown, text, or links. Evaluate your own JavaScript expression in the page with js_eval and get the value back in eval_result.",
    tag: "FIDELITY",
    color: "purple"
  },
  {
    title: "No browser farm to run",
    body: "No idle Chromium pool, no autoscaling to tune, no out-of-memory crashes at 3 a.m. Send a request, get the page back. Render and scrape cost 1 credit each (JavaScript rendering adds nothing), screenshots cost 3, and failed calls are refunded.",
    tag: "ZERO OPS",
    color: "rose"
  },
];

const faqs = [
  { q: "How is the browser surface different from the scraping API?", a: "They run on the same stateless headless browser. POST /v1/render returns the raw post-hydration HTML and the final URL. POST /v1/scrape adds output formats (markdown, html, text, links), wait_until, js_eval, page actions, and captcha solving. POST /v1/screenshot returns an image of the rendered page. Pick whichever output you need — each one is a single call." },
  { q: "How is this different from browser automation?", a: "The automation page covers the same browser driven with page actions — click, type, and scroll steps sent as JSON — and how to run them across many URLs with batch and async jobs. There is no natural-language agent: you describe the steps explicitly, and every call is still a fresh browser." },
  { q: "Which endpoints make up the browser surface?", a: "Three. POST /v1/render loads a URL, executes its JavaScript, and returns the hydrated HTML. POST /v1/scrape renders a URL and returns content in the format you choose, with wait_until, js_eval, actions (click, type, scroll_to_bottom), stealth, timeout, proxy, user_agent, and solve_captcha. POST /v1/screenshot captures the page as PNG or JPEG, full-page or element-scoped. For many URLs, use /v1/scrape/batch, /v1/scrape/async, or /v1/crawl." },
  { q: "How is it billed?", a: "Render and scrape cost 1 credit per call, and JavaScript rendering adds nothing. Screenshots cost 3 credits. Opting into a residential proxy adds 3 credits. Failed calls are refunded, so a render that times out costs you nothing. You get 1,000 free credits on signup — see the pricing page for current packs." },
  { q: "Is any state kept between calls?", a: "No. Every call starts a fresh browser with no cookies, storage, or cache from any earlier call, yours or anyone else's, and that browser is discarded when the call ends. Nothing scraped is persisted on our side beyond the response we hand back. If your flow needs state across page loads, run that part in your own browser tooling." },
  { q: "What page actions are supported?", a: "Three, sent as a JSON array on POST /v1/scrape: {\"action\": \"click\", \"selector\": ...}, {\"action\": \"type\", \"selector\": ..., \"text\": ...}, and {\"action\": \"scroll_to_bottom\"}. The key is action. Up to 50 actions run once, in order, on the loaded page before it is captured. There is no wait action — use wait_until to control when the page counts as loaded." },
  { q: "What about pages behind a login?", a: "Not supported. Actions run on a single loaded page and do not wait for a navigation, so they cannot complete a login form, and no cookies or session carry from one call to the next. You also cannot send your own cookies or custom request headers (only a user_agent override). Use the API for publicly reachable pages." },
  { q: "Can I run a multi-step interaction across several calls?", a: "Not as one continuous browser — each call is independent. Put in-page steps (open a panel, type into a filter, load more, scroll) in the actions array of a single scrape call. For flows that need state across page loads, drive your own browser with an open-source tool like Playwright and use Ollagraph for the stateless fetches around it." },
];

const url = "https://ollagraph.com/browser/";
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", name: "Headless browser API — Ollagraph", url, description: "Render JavaScript-heavy pages in a fresh headless browser per call: hydrated HTML, markdown, JS evaluation, click/type/scroll page actions, and screenshots. Stateless, managed, billed per call." },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Ollagraph", item: "https://ollagraph.com/" },
    { "@type": "ListItem", position: 2, name: "Headless browser API", item: url },
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---
<BaseLayout
  title="Headless browser API — JS rendering, page actions, screenshots — Ollagraph"
  description="Render JavaScript-heavy pages in a fresh headless browser on every call: hydrated HTML, markdown, JS evaluation, click/type/scroll page actions, and screenshots. Stateless, no browser farm, billed per call."
  jsonLd={jsonLd}
>
    <Fragment slot="head">
    <link rel="stylesheet" href="/homepage-tailwind.css?v=28" />
    <style>
      body {
        font-family: 'Geist', 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }
      .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }
      details summary::-webkit-details-marker,
      details summary::marker {
        display: none;
        content: "";
      }
    </style>
  </Fragment>

  <Fragment set:html={navHtml('browser')} />

  <div class="relative overflow-hidden bg-white text-ink-950 font-sans">
    
    <!-- Hero Section -->
    <section class="relative pt-16 pb-16 sm:pt-24 sm:pb-20 border-b border-ink-200 overflow-hidden bg-white">
      <!-- Background Ambient Glow & Grid -->
      <div class="absolute inset-0 pointer-events-none -z-10 flex items-center justify-center">
        <div class="w-[700px] h-[400px] rounded-full bg-brand/5 blur-3xl opacity-60"></div>
      </div>
      <div class="absolute inset-0 bg-[radial-gradient(#e2e8f0_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none -z-10"></div>

      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <!-- Eyebrow Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-ink-200 bg-ink-50/80 text-xs font-mono mb-6 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-brand animate-pulse"></span>
          <span class="text-ink-900 font-semibold">HEADLESS BROWSER</span>
          <span class="text-ink-300 select-none">•</span>
          <span class="text-ink-600 font-medium">Stateless JS Rendering</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-[3.75rem] leading-[1.1] font-bold tracking-tight text-ink-950 mb-6 max-w-4xl mx-auto">
          Render any page. <span class="text-brand underline decoration-brand/30 decoration-4 underline-offset-4">One call, fresh browser.</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg lg:text-xl text-ink-600 max-w-3xl mx-auto leading-relaxed mb-8 font-normal">
          Send a URL, get the page as a real browser sees it — hydrated HTML, markdown, the result of your own JavaScript, or a screenshot. Click, type, and scroll before capture. Every call is a fresh browser and nothing is kept between calls — not a server farm you have to run.
        </p>

        <!-- CTA Row -->
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a class="relative group overflow-hidden inline-flex items-center px-5 py-2.5 text-sm font-semibold rounded bg-brand text-white shadow-sm hover:shadow-lg hover:shadow-brand/25 hover:bg-brand-hover transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] focus:ring-2 focus:ring-brand/40" href="/contactus">
            <span class="relative z-10 flex items-center">Request access <span class="ml-1.5 transition-transform duration-200 group-hover:translate-x-1">→</span></span>
            <span class="absolute top-0 -left-full w-full h-full bg-white/20 transform -skew-x-12 group-hover:translate-x-[250%] transition-transform duration-700 ease-out"></span>
          </a>
          <a class="inline-flex items-center px-5 py-2.5 text-sm font-medium rounded border border-ink-300 bg-white text-ink-700 hover:bg-ink-50 hover:text-ink-900 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 shadow-xs hover:shadow" href="/docs">
            Read the docs <span class="ml-1 text-ink-400">→</span>
          </a>
        </div>

        <p class="text-xs sm:text-sm text-ink-500 mt-6 max-w-xl mx-auto">
          Need click, type, and scroll steps across many URLs? See <a href="/automation" class="text-brand hover:underline font-medium">browser automation</a>. Just need one page fetched? Use <a href="/scrape" class="text-brand hover:underline font-medium">the scraping API</a>.
        </p>
      </div>
    </section>

    <!-- Pillars Section -->
    <section class="py-16 sm:py-20 border-b border-ink-200 bg-[#FAFAFA]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <div class="text-xs font-mono text-brand font-semibold uppercase tracking-wider mb-2">
            CORE CAPABILITIES
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950">
            The headless browser primitive, without the server fleet.
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {pillars.map((p, idx) => (
            <div class={`platform-card ${idx === 0 ? 'platform-card-sky' : idx === 1 ? 'platform-card-emerald' : idx === 2 ? 'platform-card-purple' : 'platform-card-rose'} p-6 sm:p-7 rounded-xl border border-ink-200/90 shadow-xs hover:shadow-lg hover:-translate-y-1 transition-all duration-300 bg-white group cursor-default flex flex-col justify-between relative overflow-hidden`}>
              <div>
                <div class="flex items-center gap-3 mb-4">
                  <div class={`platform-card-icon-wrap ${idx === 0 ? 'bg-sky-50 text-sky-600 border-sky-200/60' : idx === 1 ? 'bg-emerald-50 text-emerald-600 border-emerald-200/60' : idx === 2 ? 'bg-purple-50 text-purple-600 border-purple-200/60' : 'bg-rose-50 text-brand border-rose-200/60'} border`}>
                    {idx === 0 && (
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                    )}
                    {idx === 1 && (
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                    )}
                    {idx === 2 && (
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                    )}
                    {idx === 3 && (
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                    )}
                  </div>
                  <div>
                    <span class={`text-[10px] font-mono font-bold uppercase tracking-wider block ${idx === 0 ? 'text-sky-600' : idx === 1 ? 'text-emerald-600' : idx === 2 ? 'text-purple-600' : 'text-brand'}`}>
                      {p.tag}
                    </span>
                    <h3 class="text-lg font-semibold text-ink-900 group-hover:text-brand transition-colors duration-200">{p.title}</h3>
                  </div>
                </div>
                <p class="text-sm leading-relaxed text-ink-600">
                  {p.body}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Code Section: Render, evaluate, act, capture -->
    <section class="py-16 sm:py-20 border-b border-ink-200 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <div class="text-xs font-mono text-brand font-semibold uppercase tracking-wider mb-2">
            BROWSER SURFACE
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950 mb-3">
            Render, evaluate, act, capture.
          </h2>
          <p class="text-sm sm:text-base text-ink-600">
            Four independent calls, one bearer token. Each starts a fresh browser; nothing carries over to the next.
          </p>
        </div>

        <div class="space-y-6">
          <!-- Terminal 1: Render a page -->
          <div class="rounded-xl border border-ink-800 bg-[#090D14] overflow-hidden shadow-xl font-mono text-xs text-ink-100">
            <div class="flex items-center justify-between border-b border-ink-800 px-4 py-2.5 bg-ink-950 select-none">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
                </div>
                <span class="ml-2 text-ink-200 text-xs font-semibold">Render a page</span>
                <span class="text-ink-500 text-[11px] hidden sm:inline">• POST /v1/render</span>
              </div>
              <button type="button" class="quick-copy-btn text-ink-400 hover:text-white p-1 rounded hover:bg-ink-800 flex items-center gap-1 text-[11px] transition-colors" data-copy={openExample}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-5 overflow-x-auto leading-relaxed">
              <pre class="m-0 text-ink-100 whitespace-pre"><code>{openExample}</code></pre>
            </div>
          </div>

          <!-- Terminal 2: Wait & evaluate JS -->
          <div class="rounded-xl border border-ink-800 bg-[#090D14] overflow-hidden shadow-xl font-mono text-xs text-ink-100">
            <div class="flex items-center justify-between border-b border-ink-800 px-4 py-2.5 bg-ink-950 select-none">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
                </div>
                <span class="ml-2 text-ink-200 text-xs font-semibold">Wait &amp; evaluate JS</span>
                <span class="text-ink-500 text-[11px] hidden sm:inline">• POST /v1/scrape</span>
              </div>
              <button type="button" class="quick-copy-btn text-ink-400 hover:text-white p-1 rounded hover:bg-ink-800 flex items-center gap-1 text-[11px] transition-colors" data-copy={renderExample}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-5 overflow-x-auto leading-relaxed">
              <pre class="m-0 text-ink-100 whitespace-pre"><code>{renderExample}</code></pre>
            </div>
          </div>

          <!-- Terminal 3: Run page actions -->
          <div class="rounded-xl border border-ink-800 bg-[#090D14] overflow-hidden shadow-xl font-mono text-xs text-ink-100">
            <div class="flex items-center justify-between border-b border-ink-800 px-4 py-2.5 bg-ink-950 select-none">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
                </div>
                <span class="ml-2 text-ink-200 text-xs font-semibold">Run page actions</span>
                <span class="text-ink-500 text-[11px] hidden sm:inline">• POST /v1/scrape</span>
              </div>
              <button type="button" class="quick-copy-btn text-ink-400 hover:text-white p-1 rounded hover:bg-ink-800 flex items-center gap-1 text-[11px] transition-colors" data-copy={scriptExample}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-5 overflow-x-auto leading-relaxed">
              <pre class="m-0 text-ink-100 whitespace-pre"><code>{scriptExample}</code></pre>
            </div>
          </div>

          <!-- Terminal 4: Capture a screenshot -->
          <div class="rounded-xl border border-ink-800 bg-[#090D14] overflow-hidden shadow-xl font-mono text-xs text-ink-100">
            <div class="flex items-center justify-between border-b border-ink-800 px-4 py-2.5 bg-ink-950 select-none">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
                </div>
                <span class="ml-2 text-ink-200 text-xs font-semibold">Capture a screenshot</span>
                <span class="text-ink-500 text-[11px] hidden sm:inline">• POST /v1/screenshot</span>
              </div>
              <button type="button" class="quick-copy-btn text-ink-400 hover:text-white p-1 rounded hover:bg-ink-800 flex items-center gap-1 text-[11px] transition-colors" data-copy={inspectExample}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
            <div class="p-5 overflow-x-auto leading-relaxed">
              <pre class="m-0 text-ink-100 whitespace-pre"><code>{inspectExample}</code></pre>
            </div>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-ink-500 text-center mt-8">
          Part of the full <a href="/capabilities" class="text-brand hover:underline font-medium">{stats.endpointCount}-endpoint surface</a>. For one-shot fetches see <a href="/scrape" class="text-brand hover:underline font-medium">scraping</a>, for whole-site sweeps see <a href="/crawl" class="text-brand hover:underline font-medium">crawling</a>, and for page actions at scale see <a href="/automation" class="text-brand hover:underline font-medium">automation</a>.
        </p>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 sm:py-24 border-b border-ink-200 bg-[#FAFAFA]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <div class="text-xs font-mono text-brand font-semibold uppercase tracking-wider mb-2">
            FREQUENTLY ASKED QUESTIONS
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950">
            Headless browser questions
          </h2>
        </div>

        <div class="space-y-4">
          {faqs.map((f, idx) => (
            <details class="group border border-ink-200 rounded-xl bg-white p-5 transition-all duration-200 open:shadow-sm">
              <summary class="flex items-center justify-between cursor-pointer list-none select-none">
                <div class="flex items-center gap-3">
                  <span class="w-6 h-6 rounded-full bg-ink-100 group-open:bg-rose-50 text-ink-600 group-open:text-brand font-mono text-xs font-semibold flex items-center justify-center transition-colors shrink-0">
                    {idx + 1}
                  </span>
                  <h3 class="font-semibold text-ink-900 group-hover:text-brand transition-colors text-base sm:text-lg">
                    {f.q}
                  </h3>
                </div>
                <div class="w-6 h-6 rounded-full flex items-center justify-center text-ink-400 group-hover:text-ink-600 transition-transform duration-200 group-open:rotate-180 shrink-0">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </div>
              </summary>
              <div class="text-ink-600 text-sm sm:text-base leading-relaxed mt-4 pl-9 pr-2">
                {f.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Bottom CTA Section -->
    <section class="py-20 sm:py-28 bg-white relative overflow-hidden" id="signup">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="bottom-cta-card relative rounded-2xl border border-ink-800 text-white p-8 sm:p-12 lg:p-14 shadow-2xl shadow-ink-950/30 overflow-hidden text-center">
          <!-- Ambient Glow Accents -->
          <div class="absolute -top-28 -right-28 w-80 h-80 rounded-full bg-brand/20 blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-28 -left-28 w-80 h-80 rounded-full bg-emerald-500/15 blur-3xl pointer-events-none"></div>

          <!-- Top Chip -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-ink-900/90 border border-ink-700 text-xs font-mono mb-6 shadow-sm relative z-10">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-white font-semibold">1,000 free credits</span>
            <span class="text-ink-500 select-none">•</span>
            <span class="text-ink-300 font-normal">Failed calls refunded</span>
          </div>

          <!-- Title -->
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4 relative z-10">
            Render your first page in <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-brand to-rose-300">five minutes</span>.
          </h2>

          <!-- Subtitle -->
          <p class="text-sm sm:text-base text-ink-300 max-w-xl mx-auto leading-relaxed mb-8 relative z-10">
            1,000 free credits, one bearer token, no browser to run, failed calls auto-refund.
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-wrap items-center justify-center gap-3 relative z-10">
            <a class="relative group overflow-hidden inline-flex items-center px-6 py-3 text-sm font-semibold rounded-lg bg-brand text-white shadow-lg shadow-brand/25 hover:shadow-xl hover:shadow-brand/40 hover:bg-brand-hover transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] focus:ring-2 focus:ring-brand/40" href="/contactus">
              <span class="relative z-10 flex items-center">Request access <span class="ml-1.5 transition-transform duration-200 group-hover:translate-x-1">→</span></span>
              <span class="absolute top-0 -left-full w-full h-full bg-white/20 transform -skew-x-12 group-hover:translate-x-[250%] transition-transform duration-700 ease-out"></span>
            </a>
            <a class="inline-flex items-center px-6 py-3 text-sm font-medium rounded-lg border border-ink-700 bg-ink-900/80 text-ink-200 hover:bg-ink-800 hover:text-white transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 shadow-xs" href="/recipes">
              Browse recipes <span class="ml-1 text-ink-400">→</span>
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="mt-8 pt-6 border-t border-ink-800/80 flex flex-wrap items-center justify-center gap-6 text-[11px] font-mono text-ink-400 relative z-10">
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5l3.5 3.5 6.5-7"/></svg>
              No credit card required
            </span>
            <span class="text-ink-700 hidden sm:inline">•</span>
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5l3.5 3.5 6.5-7"/></svg>
              Managed headless browser
            </span>
            <span class="text-ink-700 hidden sm:inline">•</span>
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5l3.5 3.5 6.5-7"/></svg>
              {stats.endpointCount} endpoints live
            </span>
          </div>
        </div>
      </div>
    </section>
  </div>

  <Fragment set:html={footerHtml()} />

  <script is:inline>
    // Wire quick copy buttons
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.quick-copy-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var text = btn.getAttribute('data-copy');
          if (text) {
            navigator.clipboard.writeText(text).then(function() {
              var span = btn.querySelector('span');
              if (span) {
                var oldText = span.textContent;
                span.textContent = 'Copied!';
                setTimeout(function() { span.textContent = oldText; }, 1600);
              }
            });
          }
        });
      });
    });
  </script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import bodyHtml from '../bodies/enterprise.body.html?raw';
import headExtras from '../bodies/enterprise.head.html?raw';
import { navHtml, footerHtml } from '../chrome';
import stats from '../data/api-stats.json';

const rendered = bodyHtml
  .replace('<div id="nav-root"></div>', navHtml("enterprise"))
  .replace('<div id="footer-root"></div>', footerHtml())
  .split('%%ENDPOINT_COUNT%%').join(String(stats.endpointCount));
---
<BaseLayout title="Ollagraph Enterprise — Volume Pricing, SLA &amp; SSO" description="Enterprise web infrastructure for AI agents: volume pricing, uptime SLA, SSO/SCIM/RBAC, audit-log streaming to your SIEM and a no-content-retention guarantee.">
  <Fragment slot="head" set:html={headExtras} />
  <Fragment set:html={rendered} />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import bodyHtml from '../bodies/mcp.body.html?raw';
import headExtras from '../bodies/mcp.head.html?raw';
import { navHtml, footerHtml } from '../chrome';
import stats from '../data/api-stats.json';

const rendered = bodyHtml
  .replace('<div id="nav-root"></div>', navHtml("mcp"))
  .replace('<div id="footer-root"></div>', footerHtml())
  .split('%%ENDPOINT_COUNT%%').join(String(stats.endpointCount));

const softwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Ollagraph MCP Server",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Windows, Linux",
  url: "https://ollagraph.com/mcp/",
  description: `Every Ollagraph endpoint, exposed as an MCP tool for AI agents. Run pipx run ollagraph-mcp to give Claude Desktop, Cursor, Windsurf, Cline, and Continue ${stats.endpointCount} callable live web data tools.`,
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "USD",
    lowPrice: "0",
    offerCount: "1",
  },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://ollagraph.com" },
    { "@type": "ListItem", position: 2, name: "MCP Server", item: "https://ollagraph.com/mcp/" }
  ]
};
---
<BaseLayout
  title={`Ollagraph MCP Server — ${stats.endpointCount} Web Tools for Claude & Cursor`}
  description={`Every Ollagraph endpoint, exposed as an MCP tool. pipx run ollagraph-mcp; drop into Claude Desktop, Cursor, Windsurf, Cline, and Continue with one config line.`}
  jsonLd={[softwareApp, breadcrumbLd]}
>
  <Fragment slot="head" set:html={headExtras} />
  <Fragment set:html={rendered} />

  <script is:inline>
    // Wire quick copy buttons
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.quick-copy-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var text = btn.getAttribute('data-copy');
          if (text) {
            navigator.clipboard.writeText(text).then(function() {
              var span = btn.querySelector('span');
              if (span) {
                span.textContent = 'Copied!';
                setTimeout(function() { span.textContent = 'Copy'; }, 1600);
              }
            });
          }
        });
      });
    });
  </script>
</BaseLayout>


---
import BaseLayout from '../layouts/BaseLayout.astro';
import bodyHtml from '../bodies/mcp.body.html?raw';
import headExtras from '../bodies/mcp.head.html?raw';
import { navHtml, footerHtml } from '../chrome';

const rendered = bodyHtml
  .replace('<div id="nav-root"></div>', navHtml("mcp"))
  .replace('<div id="footer-root"></div>', footerHtml());
---
<BaseLayout title="Ollagraph MCP Server — 221 Web Tools for Claude &amp; Cursor" description="Every Ollagraph endpoint, exposed as an MCP tool. pipx run ollagraph-mcp; drop into Claude Desktop, Cursor, Cline, Continue with one config line.">
  <Fragment slot="head" set:html={headExtras} />
  <Fragment set:html={rendered} />

  <style is:global>
    .quickstart-pre { position: relative; }
    .qs-copy {
      position: absolute; top: 10px; right: 10px;
      padding: 4px 9px; border-radius: 6px; font-size: 11px; line-height: 1; cursor: pointer;
      color: var(--text-muted); background: rgba(255,255,255,0.05);
      border: 1px solid var(--border, rgba(255,255,255,0.12));
    }
    .qs-copy:hover { color: var(--text); background: rgba(255,255,255,0.10); }
  </style>
  <script>
    // Copy buttons on the /mcp code blocks (external scan BUG-009). The page body
    // is set:html-injected, so this bundled module script wires them at runtime.
    document.querySelectorAll('pre.quickstart-pre').forEach((pre) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'qs-copy';
      btn.textContent = 'Copy';
      btn.addEventListener('click', () => {
        const code = pre.querySelector('code');
        const text = (code ? code.innerText : pre.innerText).trim();
        navigator.clipboard.writeText(text).then(() => {
          btn.textContent = 'Copied';
          setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
        });
      });
      pre.appendChild(btn);
    });
  </script>
</BaseLayout>

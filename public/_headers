# Cloudflare Pages reads this at deploy and applies it to matching paths.
# Security headers (external scan: missing HSTS / CSP / X-Frame-Options).
# HSTS, X-Frame-Options, nosniff, Referrer-Policy and Permissions-Policy are
# zero-breakage and close the real gaps (downgrade, clickjacking, MIME sniffing).
# CSP ships as Report-Only first so a policy mistake can't break the live site;
# promote to an enforcing Content-Security-Policy once the browser reports clean.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.ollagraph.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
